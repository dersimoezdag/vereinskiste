{% extends 'layout.twig' %}
{% block title %}{{ t('clubroles.title') }}{% endblock %}
{% import 'components/icons.twig' as icons %}
{% import 'components/help.twig' as help %}

{% block content %}
<div class="mx-auto w-full max-w-7xl">
    {% include 'components/settings_tabs.twig' %}

    <div class="alert alert-info flex items-center mb-6">
        <div>{{ t('clubroles.help') }}</div>
    </div>

    <div class="grid-12 gap-6">
        <!-- Formular zum Anlegen neuer Vereinsrollen -->
        <div class="lg:col-span-4 col-span-12">
            <div class="panel">
                <div class="panel-header">
                    <h3 class="panel-title">{{ t('clubroles.new') }}</h3>
                </div>
                <div class="panel-body">
                    <form method="post" action="/settings/club-roles" novalidate>
                        {{ csrf_field() }}

                        <div class="mb-4">
                            <label for="new-role-name" class="label required">{{ t('clubroles.name') }}</label>
                            <input type="text" id="new-role-name" name="name" value="{{ input.name|default('') }}"
                                   class="input{% if errors.name and error_role_id is null %} is-invalid{% endif %}" required maxlength="100">
                            {% if errors.name and error_role_id is null %}
                            <div class="field-error">{{ t(errors.name) }}</div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            <label for="new-role-desc" class="label">{{ t('clubroles.description') }}</label>
                            <textarea id="new-role-desc" name="description" rows="2" class="input" maxlength="500">{{ input.description|default('') }}</textarea>
                        </div>

                        <div class="mb-4">
                            <label for="new-role-kind" class="label required">{{ t('clubroles.kind') }} {{ help.tip(t('ui.funktionen_bezeichnen_aemter_wie_1_vorstand_oder_kassenpruefer_mi')) }}</label>
                            <select id="new-role-kind" name="kind" class="input">
                                <option value="function">{{ t('clubroles.kind.function') }}</option>
                                <option value="membership_type">{{ t('clubroles.kind.membership_type') }}</option>
                            </select>
                        </div>

                        {% include 'settings/function_access.twig' with {prefix:'new', access_role:input.access_role|default('')} %}
                        <div class="check mb-4">
                            <input class="check-input" type="checkbox" id="new-single-holder" name="single_holder" value="1">
                            <label class="check-label" for="new-single-holder">
                                {{ t('clubroles.single') }} {{ help.tip(t('ui.nur_1_traeger_verhindert_mehrfachbesetzungen_fuer_aemter_die_laut')) }}
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-full">{{ t('clubroles.new') }}</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Liste bestehender Vereinsrollen -->
        <div class="lg:col-span-8 col-span-12">
            <div class="panel">
                <div class="panel-header">
                    <h3 class="panel-title">{{ t('clubroles.title') }}</h3>
                </div>
                <div class="table-scroll">
                    <table class="data-table mb-0">
                        <thead>
                            <tr>
                                <th>{{ t('clubroles.name') }}</th>
                                <th>{{ t('clubroles.kind') }}</th>
                                <th>{{ t('clubroles.holders') }}</th>
                                <th class="text-right">{{ t('audit.action') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for r in roles %}
                            <tr {% if not r.active %}class="opacity-75 bg-subtle"{% endif %}>
                                <td>
                                    <div class="font-semibold">
                                        {{ r.name }}
                                        {% if not r.active %}
                                            <span class="badge bg-subtle text-muted ms-1">{{ t('clubroles.archived') }}</span>
                                        {% endif %}
                                        {% if r.single_holder %}
                                            <span class="badge bg-warning-soft text-warning ms-1">{{ t('clubroles.single.badge') }}</span>
                                        {% endif %}
                                    </div>
                                    {% if r.description %}
                                    <div class="text-sm text-muted">{{ r.description }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if r.kind == 'membership_type' %}
                                        <span class="badge bg-primary-soft text-primary">{{ t('clubroles.kind.membership_type') }}</span>
                                    {% else %}
                                        <span class="badge bg-subtle text-muted">{{ t('clubroles.kind.function') }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if r.holders_list is empty %}
                                        <span class="text-muted text-sm">{{ t('ui.0_traeger') }}</span>
                                    {% else %}
                                        <div class="text-sm">
                                            <strong>{{ r.holders }} {{ t('ui.traeger') }}</strong>
                                            {% for h in r.holders_list %}
                                                <a href="/members/{{ h.member_id }}" class="text-inherit underline me-1">{{ h.name }}{% if h.scope %} ({{ h.scope }}){% endif %}</a>{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="text-right">
                                    <button type="button" class="btn btn-sm"
                                            data-toggle-target="edit-role-{{ r.id }}" aria-controls="edit-role-{{ r.id }}">
                                        {{ t('bookings.edit') }}
                                    </button>
                                </td>
                            </tr>
                            <!-- Ausklappbares Bearbeitungsformular -->
                            <tr id="edit-role-{{ r.id }}" class="{% if error_role_id != r.id %}hidden{% endif %} bg-subtle">
                                <td colspan="4" class="p-4">
                                    <form method="post" action="/settings/club-roles/{{ r.id }}" class="grid-12 gap-2 items-end">
                                        {{ csrf_field() }}
                                        <input type="hidden" name="version" value="{{ r.version }}">
{% include 'settings/function_access.twig' with {prefix:'edit-' ~ r.id, access_role:r.access_role|default('')} %}

                                        <div class="md:col-span-3 col-span-12">
                                            <label for="role-name-{{ r.id }}" class="label label-sm">{{ t('clubroles.name') }}</label>
                                            <input type="text" id="role-name-{{ r.id }}" name="name" value="{{ (error_role_id == r.id ? input.name : r.name) }}" class="input input-sm" required maxlength="100">
                                            {% if error_role_id == r.id and errors.name %}
                                            <div class="text-danger text-sm">{{ t(errors.name) }}</div>
                                            {% endif %}
                                        </div>
                                        <div class="md:col-span-3 col-span-12">
                                            <label for="role-desc-{{ r.id }}" class="label label-sm">{{ t('clubroles.description') }}</label>
                                            <input type="text" id="role-desc-{{ r.id }}" name="description" value="{{ (error_role_id == r.id ? input.description : r.description) }}" class="input input-sm" maxlength="500">
                                        </div>
                                        <div class="md:col-span-2 col-span-12">
                                            <label for="role-kind-{{ r.id }}" class="label label-sm">{{ t('clubroles.kind') }}</label>
                                            <select id="role-kind-{{ r.id }}" name="kind" class="input input-sm">
                                                <option value="function" {% if (error_role_id == r.id ? input.kind : r.kind) == 'function' %}selected{% endif %}>{{ t('ui.funktion') }}</option>
                                                <option value="membership_type" {% if (error_role_id == r.id ? input.kind : r.kind) == 'membership_type' %}selected{% endif %}>{{ t('clubroles.assign.type') }}</option>
                                            </select>
                                            {% if error_role_id == r.id and errors.kind %}
                                            <div class="text-danger text-sm">{{ t(errors.kind) }}</div>
                                            {% endif %}
                                        </div>
                                        <div class="md:col-span-2 col-span-12">
                                            <div class="check check-inline mt-6">
                                                <input class="check-input" type="checkbox" name="single_holder" value="1" id="single-{{ r.id }}"
                                                       {% if (error_role_id == r.id ? input.single_holder : r.single_holder) %}checked{% endif %}>
                                                <label class="check-label text-sm" for="single-{{ r.id }}">{{ t('ui.nur_1_traeger') }}</label>
                                            </div>
                                            <div class="check check-inline mt-1">
                                                <input class="check-input" type="checkbox" name="active" value="1" id="active-{{ r.id }}"
                                                       {% if (error_role_id == r.id ? input.active : r.active) %}checked{% endif %}>
                                                <label class="check-label text-sm" for="active-{{ r.id }}">{{ t('bookings.status.active') }}</label>
                                            </div>
                                            {% if error_role_id == r.id and errors.single_holder %}
                                            <div class="text-danger text-sm">{{ t(errors.single_holder) }}</div>
                                            {% endif %}
                                        </div>
                                        <div class="md:col-span-2 col-span-12 text-right">
                                            <button type="submit" class="btn btn-sm btn-primary w-full">{{ t('common.save') }}</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
