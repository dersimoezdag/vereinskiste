{% extends 'layout.twig' %}
{% import 'components/help.twig' as help %}
{% block title %}{{ t('foundation.bank') }}{% endblock %}
{% block content %}
<h1>{{ account.name }} – {{ t('foundation.bank') }} {{ help.tip(t('ui.hinterlegen_sie_iban_und_bic_dieses_vereinskontos_fuer_automatisc')) }}</h1>
<form class="card card-body" method="post" action="/accounts/{{ account.id }}/bank">
    {{ csrf_field() }}
    <input type="hidden" name="version" value="{{ version }}">
    {% include 'components/foundation_fields.twig' with {'reason_required': false} %}
    <button class="btn btn-primary" type="submit">{{ t('foundation.save') }}</button>
</form>
<a class="btn btn-link" href="/accounts">{{ t('common.back') }}</a>
{% include 'components/foundation_history.twig' %}
{% endblock %}
