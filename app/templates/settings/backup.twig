{% extends 'layout.twig' %}
{% block title %}{{ t('settings.backup.title') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}

<div class="row row-cards">
    {# Übersicht Datenbestand #}
    <div class="col-12">
        <div class="card mb-3">
            <div class="card-header">
                <h2 class="card-title">{{ t('settings.backup.stats.title') }}</h2>
            </div>
            <div class="card-body">
                <p class="text-secondary mb-3">{{ t('settings.backup.description') }}</p>
                <div class="row g-3 text-center">
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="subheader">{{ t('settings.backup.stats.bookings') }}</div>
                        <div class="h2 mb-0 text-primary">{{ stats.bookings_count }}</div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="subheader">{{ t('settings.backup.stats.members') }}</div>
                        <div class="h2 mb-0 text-primary">{{ stats.members_count }}</div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="subheader">{{ t('settings.backup.stats.contacts') }}</div>
                        <div class="h2 mb-0">{{ stats.contacts_count }}</div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="subheader">{{ t('settings.backup.stats.invoices') }}</div>
                        <div class="h2 mb-0">{{ stats.invoices_count }}</div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="subheader">{{ t('settings.backup.stats.tables') }}</div>
                        <div class="h2 mb-0">{{ stats.tables_count }}</div>
                        <div class="text-secondary small">{{ stats.total_db_rows }} {{ t('settings.backup.stats.records') }}</div>
                    </div>
                    <div class="col-6 col-sm-4 col-md-2">
                        <div class="subheader">{{ t('settings.backup.stats.storage') }}</div>
                        <div class="h2 mb-0">{{ stats.total_files_formatted }}</div>
                        <div class="text-secondary small">{{ stats.total_files_count }} {{ t('settings.backup.stats.receipts') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 1. Sicherung erstellen #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title">{{ t('settings.backup.download.title') }}</h2>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                <div class="p-3 border rounded">
                    <h3 class="h4 mb-1">{{ t('settings.backup.download.full_btn') }}</h3>
                    <p class="text-secondary small mb-2">{{ t('settings.backup.download.full_desc') }}</p>
                    <form method="post" action="/settings/backup/full">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-primary">
                            {{ icons.icon('download') }} {{ t('settings.backup.download.full_btn') }}
                        </button>
                    </form>
                </div>

                <div class="p-3 border rounded">
                    <h3 class="h4 mb-1">{{ t('settings.backup.download.db_btn') }}</h3>
                    <p class="text-secondary small mb-2">{{ t('settings.backup.download.db_desc') }}</p>
                    <form method="post" action="/settings/backup/database">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-outline-primary">
                            {{ icons.icon('database') }} {{ t('settings.backup.download.db_btn') }}
                        </button>
                    </form>
                </div>

                <div class="p-3 border rounded">
                    <h3 class="h4 mb-1">{{ t('settings.backup.download.csv_all_btn') }}</h3>
                    <p class="text-secondary small mb-2">{{ t('settings.backup.download.csv_all_desc') }}</p>
                    <form method="post" action="/settings/backup/csv-all">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-outline-secondary">
                            {{ icons.icon('reports') }} {{ t('settings.backup.download.csv_all_btn') }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# 2. Einzelne CSV-Exporte #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title">{{ t('settings.backup.csv.title') }}</h2>
            </div>
            <div class="card-body">
                <p class="text-secondary mb-3">{{ t('settings.backup.csv.desc') }}</p>
                <div class="list-group list-group-flush">
                    <a href="/reports/bookings.csv" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('bookings') }} {{ t('settings.backup.csv.bookings') }}</span>
                        <span class="badge bg-secondary-subtle text-secondary">{{ stats.bookings_count }}</span>
                    </a>
                    <a href="/members.csv" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('users') }} {{ t('settings.backup.csv.members') }}</span>
                        <span class="badge bg-secondary-subtle text-secondary">{{ stats.members_count }}</span>
                    </a>
                    <a href="/contacts.csv" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('contacts') }} {{ t('settings.backup.csv.contacts') }}</span>
                        <span class="badge bg-secondary-subtle text-secondary">{{ stats.contacts_count }}</span>
                    </a>
                    <a href="/settings/backup/accounts.csv" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('database') }} {{ t('settings.backup.csv.accounts') }}</span>
                        <span class="badge bg-secondary-subtle text-secondary">{{ stats.accounts_count }}</span>
                    </a>
                    <a href="/settings/backup/categories.csv" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('tag') }} {{ t('settings.backup.csv.categories') }}</span>
                        <span class="badge bg-secondary-subtle text-secondary">{{ stats.categories_count }}</span>
                    </a>
                    <a href="/settings/backup/invoices.zip" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('invoices') }} {{ t('settings.backup.csv.invoices_zip') }}</span>
                        <span class="badge bg-primary-subtle text-primary">{{ stats.invoices_count }} {{ t('settings.backup.stats.invoices') }}</span>
                    </a>
                    <a href="/settings/backup/invoices.csv" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>{{ icons.icon('invoices') }} {{ t('settings.backup.csv.invoices_csv') }}</span>
                        <span class="badge bg-secondary-subtle text-secondary">{{ stats.invoices_count }}</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# 3. Prüf-Ergebnis (falls vorhanden) #}
    {% if verify_result %}
    <div class="col-12">
        <div class="card border-{{ verify_result.valid ? 'success' : 'danger' }}">
            <div class="card-header bg-{{ verify_result.valid ? 'success' : 'danger' }}-subtle">
                <h2 class="card-title text-{{ verify_result.valid ? 'success' : 'danger' }}">
                    {{ t('settings.backup.restore.verify_title') }}
                </h2>
            </div>
            <div class="card-body">
                {% if verify_result.valid %}
                <div class="alert alert-success" role="status">
                    {{ t('settings.backup.restore.verify_success') }}
                </div>
                <div class="row g-3">
                    {% if verify_result.manifest.club_name %}
                    <div class="col-sm-4">
                        <div class="subheader">{{ t('settings.backup.restore.club_name') }}</div>
                        <div class="fw-bold">{{ verify_result.manifest.club_name }}</div>
                    </div>
                    {% endif %}
                    {% if verify_result.manifest.version %}
                    <div class="col-sm-4">
                        <div class="subheader">{{ t('settings.version') }}</div>
                        <div class="fw-bold">{{ verify_result.manifest.version }}</div>
                    </div>
                    {% endif %}
                    {% if verify_result.manifest.created_at %}
                    <div class="col-sm-4">
                        <div class="subheader">{{ t('settings.backup.restore.created_at') }}</div>
                        <div>{{ verify_result.manifest.created_at }}</div>
                    </div>
                    {% endif %}
                    <div class="col-sm-4">
                        <div class="subheader">{{ t('settings.backup.restore.tables') }}</div>
                        <div>{{ verify_result.tables_count }} Tabellen (prüfsummenvalidiert)</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="subheader">{{ t('settings.backup.restore.storage') }}</div>
                        <div>{{ verify_result.receipts_count }} Belege, {{ verify_result.documents_count }} Dokumente</div>
                    </div>
                </div>
                {% else %}
                <div class="alert alert-danger" role="alert">
                    <p class="fw-bold mb-1">{{ t('settings.backup.restore.verify_invalid') }}</p>
                    {% if verify_result.errors %}
                    <ul class="mb-0">
                        {% for err in verify_result.errors %}
                        <li>{{ err }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# 4. Wiederherstellung / Migration #}
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">{{ t('settings.backup.restore.title') }}</h2>
            </div>
            <div class="card-body">
                <p>{{ t('settings.backup.restore.intro') }}</p>

                <div class="alert alert-warning mb-4" role="alert">
                    <div class="fw-bold mb-1">{{ icons.icon('alert-triangle') }} {{ t('settings.backup.restore.warning') }}</div>
                </div>

                <div class="row g-4">
                    {# Formular: Backup prüfen #}
                    <div class="col-12 col-md-5 border-end">
                        <h3 class="h4 mb-3">{{ t('settings.backup.restore.check_btn') }}</h3>
                        <form method="post" action="/settings/backup/verify" enctype="multipart/form-data">
                            {{ csrf_field() }}
                            <div class="mb-3">
                                <label class="form-label" for="verify-file">{{ t('settings.backup.restore.upload_label') }}</label>
                                <input class="form-control" type="file" id="verify-file" name="backup_file" accept=".zip" required>
                            </div>
                            <button type="submit" class="btn btn-outline-primary">
                                {{ icons.icon('check') }} {{ t('settings.backup.restore.check_btn') }}
                            </button>
                        </form>
                    </div>

                    {# Formular: Backup einspielen #}
                    <div class="col-12 col-md-7">
                        <h3 class="h4 mb-3 text-danger">{{ t('settings.backup.restore.submit_btn') }}</h3>
                        <form method="post" action="/settings/backup/restore" enctype="multipart/form-data">
                            {{ csrf_field() }}
                            <div class="mb-3">
                                <label class="form-label" for="restore-file">{{ t('settings.backup.restore.upload_label') }}</label>
                                <input class="form-control" type="file" id="restore-file" name="backup_file" accept=".zip" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="confirm_overwrite" value="1" required>
                                    <span class="form-check-label text-danger fw-semibold">
                                        {{ t('settings.backup.restore.confirm_label') }}
                                    </span>
                                </label>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="confirm-phrase">
                                    {{ t('settings.backup.restore.confirm_text_label') }}
                                </label>
                                <input class="form-control" type="text" id="confirm-phrase" name="confirm_phrase"
                                    placeholder="{{ t('settings.backup.restore.confirm_phrase') }}"
                                    pattern="WIEDERHERSTELLEN" autocomplete="off" required>
                            </div>

                            <button type="submit" class="btn btn-danger">
                                {{ icons.icon('database') }} {{ t('settings.backup.restore.submit_btn') }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
