{% extends 'layout.twig' %}
{% block title %}{{ t('settings.backup.title') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}

<div class="grid-12 gap-4">
    {# Übersicht Datenbestand #}
    <div class="col-span-12">
        <div class="panel mb-4">
            <div class="panel-header">
                <h2 class="panel-title">{{ t('settings.backup.stats.title') }}</h2>
            </div>
            <div class="panel-body">
                <p class="text-muted mb-4">{{ t('settings.backup.description') }}</p>
                <div class="grid-12 gap-4 text-center">
                    <div class="col-span-6 sm:col-span-4 md:col-span-2">
                        <div class="eyebrow">{{ t('settings.backup.stats.bookings') }}</div>
                        <div class="h2 mb-0 text-primary">{{ stats.bookings_count }}</div>
                    </div>
                    <div class="col-span-6 sm:col-span-4 md:col-span-2">
                        <div class="eyebrow">{{ t('settings.backup.stats.members') }}</div>
                        <div class="h2 mb-0 text-primary">{{ stats.members_count }}</div>
                    </div>
                    <div class="col-span-6 sm:col-span-4 md:col-span-2">
                        <div class="eyebrow">{{ t('settings.backup.stats.contacts') }}</div>
                        <div class="h2 mb-0">{{ stats.contacts_count }}</div>
                    </div>
                    <div class="col-span-6 sm:col-span-4 md:col-span-2">
                        <div class="eyebrow">{{ t('settings.backup.stats.invoices') }}</div>
                        <div class="h2 mb-0">{{ stats.invoices_count }}</div>
                    </div>
                    <div class="col-span-6 sm:col-span-4 md:col-span-2">
                        <div class="eyebrow">{{ t('settings.backup.stats.tables') }}</div>
                        <div class="h2 mb-0">{{ stats.tables_count }}</div>
                        <div class="text-muted text-sm">{{ stats.total_db_rows }} {{ t('settings.backup.stats.records') }}</div>
                    </div>
                    <div class="col-span-6 sm:col-span-4 md:col-span-2">
                        <div class="eyebrow">{{ t('settings.backup.stats.storage') }}</div>
                        <div class="h2 mb-0">{{ stats.total_files_formatted }}</div>
                        <div class="text-muted text-sm">{{ stats.total_files_count }} {{ t('settings.backup.stats.receipts') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 1. Sicherung erstellen #}
    <div class="col-span-12 lg:col-span-6">
        <div class="panel h-full">
            <div class="panel-header">
                <h2 class="panel-title">{{ t('settings.backup.download.title') }}</h2>
            </div>
            <div class="panel-body flex flex-col gap-4">
                <div class="p-4 border border-line rounded-lg">
                    <h3 class="h4 mb-1">{{ t('settings.backup.download.full_btn') }}</h3>
                    <p class="text-muted text-sm mb-2">{{ t('settings.backup.download.full_desc') }}</p>
                    <form method="post" action="/settings/backup/full">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-primary">
                            {{ icons.icon('download') }} {{ t('settings.backup.download.full_btn') }}
                        </button>
                    </form>
                </div>

                <div class="p-4 border border-line rounded-lg">
                    <h3 class="h4 mb-1">{{ t('settings.backup.download.db_btn') }}</h3>
                    <p class="text-muted text-sm mb-2">{{ t('settings.backup.download.db_desc') }}</p>
                    <form method="post" action="/settings/backup/database">
                        {{ csrf_field() }}
                        <button type="submit" class="btn btn-soft">
                            {{ icons.icon('database') }} {{ t('settings.backup.download.db_btn') }}
                        </button>
                    </form>
                </div>

                <div class="p-4 border border-line rounded-lg">
                    <h3 class="h4 mb-1">{{ t('settings.backup.download.csv_all_btn') }}</h3>
                    <p class="text-muted text-sm mb-2">{{ t('settings.backup.download.csv_all_desc') }}</p>
                    <form method="post" action="/settings/backup/csv-all">
                        {{ csrf_field() }}
                        <button type="submit" class="btn">
                            {{ icons.icon('reports') }} {{ t('settings.backup.download.csv_all_btn') }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# 2. Einzelne CSV-Exporte #}
    <div class="col-span-12 lg:col-span-6">
        <div class="panel h-full">
            <div class="panel-header">
                <h2 class="panel-title">{{ t('settings.backup.csv.title') }}</h2>
            </div>
            <div class="panel-body">
                <p class="text-muted mb-4">{{ t('settings.backup.csv.desc') }}</p>
                <div class="list list-flush">
                    <a href="/reports/bookings.csv" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('bookings') }} {{ t('settings.backup.csv.bookings') }}</span>
                        <span class="badge bg-subtle text-muted">{{ stats.bookings_count }}</span>
                    </a>
                    <a href="/members.csv" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('users') }} {{ t('settings.backup.csv.members') }}</span>
                        <span class="badge bg-subtle text-muted">{{ stats.members_count }}</span>
                    </a>
                    <a href="/contacts.csv" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('contacts') }} {{ t('settings.backup.csv.contacts') }}</span>
                        <span class="badge bg-subtle text-muted">{{ stats.contacts_count }}</span>
                    </a>
                    <a href="/settings/backup/accounts.csv" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('database') }} {{ t('settings.backup.csv.accounts') }}</span>
                        <span class="badge bg-subtle text-muted">{{ stats.accounts_count }}</span>
                    </a>
                    <a href="/settings/backup/categories.csv" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('tag') }} {{ t('settings.backup.csv.categories') }}</span>
                        <span class="badge bg-subtle text-muted">{{ stats.categories_count }}</span>
                    </a>
                    <a href="/settings/backup/invoices.zip" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('invoices') }} {{ t('settings.backup.csv.invoices_zip') }}</span>
                        <span class="badge bg-primary-soft text-primary">{{ stats.invoices_count }} {{ t('settings.backup.stats.invoices') }}</span>
                    </a>
                    <a href="/settings/backup/invoices.csv" class="list-item list-item-action flex justify-between items-center">
                        <span>{{ icons.icon('invoices') }} {{ t('settings.backup.csv.invoices_csv') }}</span>
                        <span class="badge bg-subtle text-muted">{{ stats.invoices_count }}</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# 3. Prüf-Ergebnis (falls vorhanden) #}
    {% if verify_result %}
    <div class="col-span-12">
        <div class="panel {{ verify_result.valid ? 'border-success/40' : 'border-danger/40' }}">
            <div class="panel-header {{ verify_result.valid ? 'bg-success-soft' : 'bg-danger-soft' }}">
                <h2 class="panel-title {{ verify_result.valid ? 'text-success' : 'text-danger' }}">
                    {{ t('settings.backup.restore.verify_title') }}
                </h2>
            </div>
            <div class="panel-body">
                {% if verify_result.valid %}
                <div class="alert alert-success" role="status">
                    {{ t('settings.backup.restore.verify_success') }}
                </div>
                <div class="grid-12 gap-4">
                    {% if verify_result.manifest.club_name %}
                    <div class="col-span-12 sm:col-span-4">
                        <div class="eyebrow">{{ t('settings.backup.restore.club_name') }}</div>
                        <div class="font-semibold">{{ verify_result.manifest.club_name }}</div>
                    </div>
                    {% endif %}
                    {% if verify_result.manifest.version %}
                    <div class="col-span-12 sm:col-span-4">
                        <div class="eyebrow">{{ t('settings.version') }}</div>
                        <div class="font-semibold">{{ verify_result.manifest.version }}</div>
                    </div>
                    {% endif %}
                    {% if verify_result.manifest.created_at %}
                    <div class="col-span-12 sm:col-span-4">
                        <div class="eyebrow">{{ t('settings.backup.restore.created_at') }}</div>
                        <div>{{ verify_result.manifest.created_at }}</div>
                    </div>
                    {% endif %}
                    <div class="col-span-12 sm:col-span-4">
                        <div class="eyebrow">{{ t('settings.backup.restore.tables') }}</div>
                        <div>{{ verify_result.tables_count }} Tabellen (prüfsummenvalidiert)</div>
                    </div>
                    <div class="col-span-12 sm:col-span-4">
                        <div class="eyebrow">{{ t('settings.backup.restore.storage') }}</div>
                        <div>{{ verify_result.receipts_count }} Belege, {{ verify_result.documents_count }} Dokumente</div>
                    </div>
                </div>
                {% else %}
                <div class="alert alert-danger" role="alert">
                    <p class="font-semibold mb-1">{{ t('settings.backup.restore.verify_invalid') }}</p>
                    {% if verify_result.errors %}
                    <ul class="mb-0">
                        {% for err in verify_result.errors %}
                        <li>{{ err }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

    {# 4. Wiederherstellung / Migration #}
    <div class="col-span-12">
        <div class="panel">
            <div class="panel-header">
                <h2 class="panel-title">{{ t('settings.backup.restore.title') }}</h2>
            </div>
            <div class="panel-body">
                <p>{{ t('settings.backup.restore.intro') }}</p>

                <div class="alert alert-warning mb-6" role="alert">
                    <div class="font-semibold mb-1">{{ icons.icon('alert-triangle') }} {{ t('settings.backup.restore.warning') }}</div>
                </div>

                <div class="grid-12 gap-6">
                    {# Formular: Backup prüfen #}
                    <div class="col-span-12 md:col-span-5 border-e border-line">
                        <h3 class="h4 mb-4">{{ t('settings.backup.restore.check_btn') }}</h3>
                        <form method="post" action="/settings/backup/verify" enctype="multipart/form-data">
                            {{ csrf_field() }}
                            <div class="mb-4">
                                <label class="label" for="verify-file">{{ t('settings.backup.restore.upload_label') }}</label>
                                <input class="input" type="file" id="verify-file" name="backup_file" accept=".zip" required>
                            </div>
                            <button type="submit" class="btn btn-soft">
                                {{ icons.icon('check') }} {{ t('settings.backup.restore.check_btn') }}
                            </button>
                        </form>
                    </div>

                    {# Formular: Backup einspielen #}
                    <div class="col-span-12 md:col-span-7">
                        <h3 class="h4 mb-4 text-danger">{{ t('settings.backup.restore.submit_btn') }}</h3>
                        <form method="post" action="/settings/backup/restore" enctype="multipart/form-data">
                            {{ csrf_field() }}
                            <div class="mb-4">
                                <label class="label" for="restore-file">{{ t('settings.backup.restore.upload_label') }}</label>
                                <input class="input" type="file" id="restore-file" name="backup_file" accept=".zip" required>
                            </div>

                            <div class="mb-4">
                                <label class="check">
                                    <input class="check-input" type="checkbox" name="confirm_overwrite" value="1" required>
                                    <span class="check-label text-danger font-semibold">
                                        {{ t('settings.backup.restore.confirm_label') }}
                                    </span>
                                </label>
                            </div>

                            <div class="mb-4">
                                <label class="label" for="confirm-phrase">
                                    {{ t('settings.backup.restore.confirm_text_label') }}
                                </label>
                                <input class="input" type="text" id="confirm-phrase" name="confirm_phrase"
                                    placeholder="{{ t('settings.backup.restore.confirm_phrase') }}"
                                    pattern="WIEDERHERSTELLEN" autocomplete="off" required>
                            </div>

                            <button type="submit" class="btn btn-danger">
                                {{ icons.icon('database') }} {{ t('settings.backup.restore.submit_btn') }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
