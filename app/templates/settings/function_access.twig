<div class="mb-4"><label class="label" for="{{ prefix }}-access-role">{{ t('clubroles.access_role') }}</label><select class="input" id="{{ prefix }}-access-role" name="access_role"><option value="">{{ t('clubroles.access_none') }}</option>{% for key in ['board','secretary','treasurer','auditor'] %}<option value="{{ key }}"{% if access_role == key %} selected{% endif %}>{{ t('users.role.' ~ key) }}</option>{% endfor %}</select><div class="field-hint">{{ t('clubroles.access_hint') }}</div></div>
