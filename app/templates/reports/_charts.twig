<div class="viz-root" data-dashboard data-locale="de-DE"
     data-label-income="{{ t('reports.income') }}" data-label-expense="{{ t('reports.expense') }}"
     data-label-cumulative="{{ t('dashboard.cumulative') }}" data-label-result="{{ t('dashboard.result') }}"
     data-account="{{ summary.account_id }}">

    <section class="panel mb-4" aria-labelledby="chart-monthly-title">
        <div class="panel-header flex flex-wrap justify-between items-center gap-2"><h2 class="panel-title mb-0" id="chart-monthly-title">{{ t('dashboard.monthly') }}</h2>
            <div class="segmented" role="group" aria-label="{{ t('dashboard.chart_type') }}">
                {% for type in ['bar', 'line', 'area'] %}<button type="button" class="segmented-item{% if loop.first %} active{% endif %}" data-chart-type="{{ type }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">{{ t('dashboard.chart_type.' ~ type) }}</button>{% endfor %}
            </div></div>
        <div class="panel-body">
            <div class="chart-box"><canvas id="chart-monthly" role="img" aria-label="{{ t('dashboard.monthly.alt') }}"></canvas></div>
            <p class="field-hint mt-2 mb-0">{{ t('dashboard.chart_hint') }}</p>
            <div class="chart-brush mt-2" data-chart-brush hidden>
                <span class="text-muted">{{ t('dashboard.brush') }}: <output data-brush-output></output></span>
                <label class="sr-only" for="brush-start">{{ t('dashboard.brush.start') }}</label>
                <input class="range" type="range" id="brush-start" min="0" step="1" data-mask-ready="picker" data-brush-start>
                <label class="sr-only" for="brush-end">{{ t('dashboard.brush.end') }}</label>
                <input class="range" type="range" id="brush-end" min="0" step="1" data-mask-ready="picker" data-brush-end>
            </div>
            <details class="mt-4">
                <summary>{{ t('dashboard.table') }}</summary>
                <div class="table-scroll mt-2">
                    <table class="data-table table-cards">
                        <thead><tr>
                            <th>{{ t('dashboard.month') }}</th>
                            <th class="text-right">{{ t('reports.income') }}</th>
                            <th class="text-right">{{ t('reports.expense') }}</th>
                            <th class="text-right">{{ t('dashboard.result') }}</th>
                        </tr></thead>
                        <tbody>
                        {% for row in monthly %}
                            <tr>
                                <td data-label="{{ t('dashboard.month') }}">{{ (row.month ~ '-01')|date('m/Y') }}</td>
                                <td data-label="{{ t('reports.income') }}" class="text-right">{{ row.income|eur }}</td>
                                <td data-label="{{ t('reports.expense') }}" class="text-right">{{ row.expense|eur }}</td>
                                <td data-label="{{ t('dashboard.result') }}" class="text-right">{{ row.result|eur }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </details>
        </div>
    </section>

    <div class="grid-12 gap-4 mb-4">
        {% for kind, rows in {'income': income_rows, 'expense': expense_rows} %}
        <div class="col-span-12 lg:col-span-6">
            <section class="panel h-full" aria-labelledby="chart-{{ kind }}-title">
                <div class="panel-header"><h2 class="panel-title" id="chart-{{ kind }}-title">{{ t('dashboard.' ~ kind ~ '_by_category') }}</h2></div>
                <div class="panel-body">
                    {% if rows %}
                    <div class="chart-box" style="height: {{ 64 + rows|length * 38 }}px"><canvas id="chart-{{ kind }}-categories" role="img" aria-label="{{ t('dashboard.' ~ kind ~ '_by_category.alt') }}"></canvas></div>
                    <details class="mt-4">
                        <summary>{{ t('dashboard.table') }}</summary>
                        <div class="table-scroll mt-2">
                            <table class="data-table table-cards">
                                <thead><tr><th>{{ t('reports.category') }}</th><th class="text-right">{{ t('reports.' ~ kind) }}</th></tr></thead>
                                <tbody>
                                {% for row in rows %}
                                    <tr>
                                        <td data-label="{{ t('reports.category') }}">{{ row.name }}</td>
                                        <td data-label="{{ t('reports.' ~ kind) }}" class="text-right">{{ row.amount|eur }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </details>
                    {% else %}
                    <p class="text-muted mb-0">{{ t('dashboard.no_' ~ kind) }}</p>
                    {% endif %}
                </div>
            </section>
        </div>
        {% endfor %}
    </div>

    <section class="panel mb-4" aria-labelledby="chart-cumulative-title">
        <div class="panel-header"><h2 class="panel-title" id="chart-cumulative-title">{{ t('dashboard.cumulative') }}</h2></div>
        <div class="panel-body">
            <div class="chart-box"><canvas id="chart-cumulative" role="img" aria-label="{{ t('dashboard.cumulative.alt') }}"></canvas></div>
            <details class="mt-4">
                <summary>{{ t('dashboard.table') }}</summary>
                <div class="table-scroll mt-2">
                    <table class="data-table table-cards">
                        <thead><tr><th>{{ t('dashboard.month') }}</th><th class="text-right">{{ t('dashboard.cumulative_col') }}</th></tr></thead>
                        <tbody>
                        {% for row in monthly %}
                            <tr>
                                <td data-label="{{ t('dashboard.month') }}">{{ (row.month ~ '-01')|date('m/Y') }}</td>
                                <td data-label="{{ t('dashboard.cumulative_col') }}" class="text-right">{{ row.cumulative|eur }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </details>
        </div>
    </section>

    <script type="application/json" id="dashboard-data">{{ charts_json|raw }}</script>
</div>
