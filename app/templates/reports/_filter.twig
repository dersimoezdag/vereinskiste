<div class="panel mb-6">
    <div class="panel-body">
        <form method="get" action="{{ action }}" novalidate>
            <div class="grid-12 gap-4">
                <div class="col-span-6 md:col-span-3">
                    <label class="label" for="r-from">{{ t('bookings.filter.from') }}</label>
                    <input type="date" id="r-from" name="from" class="input{% if errors.from is defined %} is-invalid{% endif %}" value="{{ input.from }}">
                    {% if errors.from is defined %}<div class="field-error">{{ t(errors.from) }}</div>{% endif %}
                </div>
                <div class="col-span-6 md:col-span-3">
                    <label class="label" for="r-to">{{ t('bookings.filter.to') }}</label>
                    <input type="date" id="r-to" name="to" class="input{% if errors.to is defined %} is-invalid{% endif %}" value="{{ input.to }}">
                    {% if errors.to is defined %}<div class="field-error">{{ t(errors.to) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-4">
                    <label class="label" for="r-account">{{ t('bookings.account') }}</label>
                    <select id="r-account" name="account_id" class="input{% if errors.account_id is defined %} is-invalid{% endif %}">
                        <option value="">{{ t('reports.all_accounts') }}</option>
                        {% for account in accounts %}
                        <option value="{{ account.id }}"{% if input.account_id == '' ~ account.id %} selected{% endif %}>{{ account.name }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.account_id is defined %}<div class="field-error">{{ t(errors.account_id) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-2 flex items-end">
                    <button type="submit" class="btn btn-primary w-full">{{ t('reports.apply') }}</button>
                </div>
            </div>
        </form>
    </div>
</div>
