{% extends 'layout.twig' %}
{% block title %}{{ t('reports.title') }} – {{ t('reports.tab.dashboard') }}{% endblock %}
{% block content %}
<h1 class="mb-6">{{ t('reports.title') }}</h1>
{% include 'reports/_tabs.twig' with {'active': 'dashboard'} %}
{% include 'reports/_filter.twig' with {'action': '/reports/dashboard'} %}

{% if summary %}
<div class="grid-12 gap-4 mb-6">
    <div class="col-span-12 md:col-span-4">
        <div class="panel"><div class="panel-body">
            <div class="text-muted"><span class="viz-swatch viz-swatch-income" aria-hidden="true"></span>{{ t('reports.income') }}</div>
            <div class="h2 mb-0">{{ summary.income|eur }}</div>
        </div></div>
    </div>
    <div class="col-span-12 md:col-span-4">
        <div class="panel"><div class="panel-body">
            <div class="text-muted"><span class="viz-swatch viz-swatch-expense" aria-hidden="true"></span>{{ t('reports.expense') }}</div>
            <div class="h2 mb-0">{{ summary.expense|eur }}</div>
        </div></div>
    </div>
    <div class="col-span-12 md:col-span-4">
        <div class="panel"><div class="panel-body">
            <div class="text-muted">{{ t('reports.balance') }}</div>
            <div class="h2 mb-0">{{ summary.balance|eur }}</div>
        </div></div>
    </div>
    {% if summary.accountBalanceAtEnd is not null %}
    <div class="col-span-12">
        <div class="panel"><div class="panel-body">
            <div class="text-muted">{{ summary.account_name }} – {{ t('reports.account_balance_at_end') }} ({{ summary.to|date('d.m.Y') }})</div>
            <div class="h2 mb-0">{{ summary.accountBalanceAtEnd|eur }}</div>
        </div></div>
    </div>
    {% endif %}
</div>

{% if summary.income == '0.00' and summary.expense == '0.00' %}
<p class="text-muted">{{ t('reports.empty') }}</p>
{% else %}
{% include 'reports/_charts.twig' %}
<p class="text-muted text-sm">{{ t('reports.note') }}</p>
{% endif %}
{% endif %}
{% endblock %}
{% block scripts %}
{% if summary and (summary.income != '0.00' or summary.expense != '0.00') %}
<script src="{{ asset('vendor/chartjs/chart.umd.min.js') }}"></script>
<script src="{{ asset('dashboard.js') }}"></script>
{% endif %}
{% endblock %}
