<nav class="mui-tabs" aria-label="{{ t('reports.tabs') }}">
    {% for tab in [
        {'id': 'summary', 'url': '/reports/summary', 'label': 'reports.tab.summary'},
        {'id': 'dashboard', 'url': '/reports/dashboard', 'label': 'reports.tab.dashboard'}
    ] %}
    <a class="mui-tab{% if tab.id == active %} active{% endif %}" href="{{ tab.url }}{% if export_query %}?{{ export_query }}{% endif %}"{% if tab.id == active %} aria-current="page"{% endif %}>{{ t(tab.label) }}</a>
    {% endfor %}
</nav>
