{% extends 'layout.twig' %}
{% import 'components/help.twig' as help %}
{% block title %}{{ t('closing.title') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
<h2 class="mb-6">{{ t('closing.title') }}</h2>

{% if errors.action is defined %}
<div class="alert alert-danger" role="alert">{{ t(errors.action) }}</div>
{% endif %}

<div class="panel mb-6">
    <div class="panel-header"><h2 class="panel-title">{{ t('closing.current') }}</h2></div>
    <div class="panel-body">
        {% if closed_until %}
        <p class="h2 mb-2">{{ closed_until|date('d.m.Y') }}</p>
        <p class="text-muted mb-0">{{ t('closing.current.text')|replace({'{date}': closed_until|date('d.m.Y')}) }}</p>
        {% else %}
        <p class="mb-0">{{ t('closing.none') }}</p>
        {% endif %}
    </div>
</div>

<div class="panel mb-6">
    <div class="panel-header"><h2 class="panel-title">{{ t('closing.close.title') }} {{ help.tip(t('ui.gobd_festschreibung_nach_dem_abschluss_sind_alle_buchungen_bis_zu')) }}</h2></div>
    <div class="panel-body">
        <form method="post" action="/settings/closing" novalidate>
            {{ csrf_field() }}
            <input type="hidden" name="action" value="close">
            <label class="label required" for="close-date">{{ t('closing.close.date') }}</label>
            <input type="date" id="close-date" name="closed_until" required aria-describedby="close-help"
                   class="input{% if action == 'close' and errors.closed_until is defined %} is-invalid{% endif %}"
                   value="{{ close_date }}">
            {% if action == 'close' and errors.closed_until is defined %}
            <div class="field-error">{{ t(errors.closed_until) }}</div>
            {% endif %}
            <div class="field-hint" id="close-help">{{ t('closing.close.help') }}</div>
            <div class="mt-6">
                <button type="submit" class="btn btn-primary">{{ t('closing.close.submit') }}</button>
            </div>
        </form>
    </div>
</div>

{% if closed_until %}
<div class="panel">
    <div class="panel-header"><h2 class="panel-title">{{ t('closing.reopen.title') }} {{ help.tip(t('ui.revisionspflicht_eine_wiedereroeffnung_erfordert_zwingend_eine_be')) }}</h2></div>
    <div class="panel-body">
        <p class="text-muted">{{ t('closing.reopen.help') }}</p>
        <form method="post" action="/settings/closing" novalidate>
            {{ csrf_field() }}
            <input type="hidden" name="action" value="reopen">
            <label class="label" for="reopen-date">{{ t('closing.reopen.date') }}</label>
            <input type="date" id="reopen-date" name="closed_until"
                   class="input{% if action == 'reopen' and errors.closed_until is defined %} is-invalid{% endif %}"
                   value="{{ reopen_date }}">
            {% if action == 'reopen' and errors.closed_until is defined %}
            <div class="field-error">{{ t(errors.closed_until) }}</div>
            {% endif %}
            <div class="mt-4">
                <label class="label required" for="reopen-reason">{{ t('closing.reopen.reason') }}</label>
                <textarea id="reopen-reason" name="reason" rows="2" maxlength="500" required
                          class="input{% if action == 'reopen' and errors.reason is defined %} is-invalid{% endif %}">{{ reason }}</textarea>
                {% if action == 'reopen' and errors.reason is defined %}
                <div class="field-error">{{ t(errors.reason) }}</div>
                {% endif %}
            </div>
            <div class="mt-6">
                <button type="submit" class="btn btn-danger">{{ t('closing.reopen.submit') }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}
