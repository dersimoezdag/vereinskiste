{% import 'components/icons.twig' as icons %}
{% set password_id = editing ? 'user-new-password' : 'user-password' %}
{% set field_error = errors.password|default(password_error|default(null)) %}
<div class="col-md-6" data-admin-password>
    <label class="form-label" for="{{ password_id }}">{{ editing ? t('users.password.reset.title') : t('users.password.initial') }}</label>
    <div class="input-group">
        <input type="password" id="{{ password_id }}" name="password" data-password-input {% if not editing %}required{% endif %} minlength="10" maxlength="72" autocomplete="new-password" {% if editing %}placeholder="••••••••"{% endif %}
               class="form-control{% if field_error %} is-invalid{% endif %}" aria-describedby="{{ password_id }}-hint">
        <button type="button" class="btn btn-outline-secondary" data-password-generate hidden aria-label="{{ t('users.password.generate') }}" title="{{ t('users.password.generate') }}">{{ icons.icon('sync') }}</button>
    </div>
    <label class="form-check mt-2" data-password-visibility hidden>
        <input type="checkbox" class="form-check-input" data-password-show aria-controls="{{ password_id }}">
        <span class="form-check-label">{{ t('users.password.show') }}</span>
    </label>
    <div class="form-hint" id="{{ password_id }}-hint">{{ editing ? t('users.password.unchanged_hint') : t('users.password.help') }}</div>
    {% if field_error %}<div class="text-danger mt-1">{{ t(field_error) }}</div>{% endif %}
    <div class="form-hint" role="status" aria-live="polite" data-password-status></div>
</div>
