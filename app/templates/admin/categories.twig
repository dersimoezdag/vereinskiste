{% extends 'layout.twig' %}
{% import 'components/help.twig' as help %}
{% block title %}{{ t('categories.title') }}{% endblock %}
{% block content %}
{% include 'components/finance_master_tabs.twig' %}
<h1 class="mb-6">{{ t('categories.title') }}</h1>

<div class="panel mb-6">
    <div class="table-scroll">
        <table class="data-table table-cards">
            <thead>
                <tr>
                    <th>{{ t('categories.name') }}</th>
                    {% if can('settings.manage') %}<th>{{ t('common.actions') }}</th>{% endif %}
                </tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr{% if not category.active %} class="text-muted"{% endif %}>
                    <td data-label="{{ t('categories.name') }}">
                        {{ category.name }}
                        {% if not category.active %}<span class="badge bg-subtle text-muted">{{ t('common.inactive') }}</span>{% endif %}
                    </td>
                    {% if can('settings.manage') %}
                    <td data-label="{{ t('common.actions') }}">
                        <div class="flex flex-wrap gap-2">
                            <form method="post" action="/categories/{{ category.id }}" class="flex gap-2 grow min-w-0">
                                {{ csrf_field() }}
                                <div class="grow min-w-0">
                                    <label class="sr-only" for="category-name-{{ category.id }}">{{ t('categories.name') }}</label>
                                    <input type="text" id="category-name-{{ category.id }}" name="name" maxlength="100" required
                                           class="input{% if edit_id == category.id and errors.name is defined %} is-invalid{% endif %}"
                                           value="{{ edit_id == category.id ? edit_name : category.name }}">
                                    {% if edit_id == category.id and errors.name is defined %}
                                    <div class="field-error">{{ t(errors.name) }}</div>
                                    {% endif %}
                                </div>
                                <button type="submit" class="btn">{{ t('common.rename') }}</button>
                            </form>
                            <form method="post" action="/categories/{{ category.id }}/toggle">
                                {{ csrf_field() }}
                                <button type="submit" class="btn">{{ category.active ? t('common.deactivate') : t('common.activate') }}</button>
                            </form>
                        </div>
                    </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr><td colspan="2" class="text-muted">{{ t('categories.empty') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if can('settings.manage') %}
<div class="panel">
    <div class="panel-header"><h2 class="panel-title">{{ t('categories.new') }} {{ help.tip(t('ui.kategorien_gliedern_einnahmen_und_ausgaben_nach_verwendungszweck_')) }}</h2></div>
    <div class="panel-body">
        <form method="post" action="/categories" novalidate>
            {{ csrf_field() }}
            <label class="label" for="category-name">{{ t('categories.name') }}</label>
            <input type="text" id="category-name" name="name" maxlength="100" required
                   class="input{% if edit_id is null and errors.name is defined %} is-invalid{% endif %}"
                   value="{{ new_name }}">
            {% if edit_id is null and errors.name is defined %}<div class="field-error">{{ t(errors.name) }}</div>{% endif %}
            <div class="mt-6">
                <button type="submit" class="btn btn-primary">{{ t('categories.create') }}</button>
            </div>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}
