{% extends 'layout.twig' %}
{% import 'admin/roles_help.twig' as role_help %}
{% block title %}{{ t('users.title') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
<div class="flex flex-wrap justify-between items-center gap-2 mb-6">
    <h2 class="h2 mb-0">{{ t('users.title') }}</h2>
    <a class="btn btn-primary" href="/users/new">{{ t('users.new') }}</a>
</div>

<div class="mb-3">{{ t('users.roles') }} {{ role_help.button() }}</div>
{% embed 'components/data_grid.twig' with {rows: users, server_paged: false, columns: [
{key: 'name', label: t('users.name')},
{key: 'email', label: t('users.email')},
{key: 'member_name', label: t('members.user.field')},
{key: 'roles', sort_key: 'name', label: t('users.roles'), sortable: false},
{key: 'active', label: t('users.status'), type: 'badge', values: {
'1': {label: t('users.active'), tone: 'bg-success-soft text-success'},
'0': {label: t('common.inactive'), tone: 'bg-subtle text-muted'}
}},
{key: 'actions', label: t('common.actions'), actions: true}
], label: t('users.title'), empty_text: t('users.empty')} %}
{% block cell %}
{% if column.key == 'name' %}
<span{% if not row.active %} class="text-muted"{% endif %}>{{ row.name }}</span>
{% if row.id == me %}<span class="badge bg-primary-soft text-primary">{{ t('users.you') }}</span>{% endif %}
{% elseif column.key == 'member_name' %}
{% if row.member_id %}<a href="/members/{{ row.member_id }}" class="text-inherit">#{{ row.member_no }} {{ row.member_name }}</a>{% else %}<span class="text-muted">–</span>{% endif %}
{% elseif column.key == 'roles' %}
{% for role in row.roles %}<span class="badge bg-subtle text-muted me-1">{{ t('users.role.' ~ role) }}</span>{% endfor %}
{% elseif column.key == 'actions' %}<a class="btn btn-sm" href="/users/{{ row.id }}/edit">{{ t('users.edit') }}</a>
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% endembed %}
{{ role_help.dialog(all_roles, permissions, role_permissions) }}
{% endblock %}
