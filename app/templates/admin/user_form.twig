{% extends 'layout.twig' %}
{% import 'admin/roles_help.twig' as role_help %}
{% block title %}{{ user_id is not null ? t('users.edit.title') : t('users.new') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
{% set editing = user_id is not null %}
<h2 class="h2 mb-6">{{ editing ? t('users.edit.title') : t('users.new') }}</h2>

<div class="panel mb-6">
    <div class="panel-body">
        <form method="post" action="{{ editing ? '/users/' ~ user_id ~ '/edit' : '/users/new' }}" novalidate>
            {{ csrf_field() }}
            <div class="grid-12 gap-4">
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="user-name">{{ t('users.name') }}</label>
                    <input type="text" id="user-name" name="name" data-linked-name maxlength="200" required autocomplete="off"
                           class="input{% if errors.name is defined %} is-invalid{% endif %}"
                           value="{{ input.name }}"{% if input.member_id %} disabled{% endif %}>
                    {% if errors.name is defined %}<div class="field-error">{{ t(errors.name) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="user-email">{{ t('users.email') }}</label>
                    <input type="email" id="user-email" name="email" data-linked-email maxlength="254" required autocomplete="off"
                           class="input{% if errors.email is defined %} is-invalid{% endif %}"
                           value="{{ input.email }}"{% if input.member_id %} disabled{% endif %}>
                    {% if errors.email is defined %}<div class="field-error">{{ t(errors.email) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <div class="flex items-center gap-2"><label class="label" for="user-member-id">{{ t('members.user.field') }}</label>
                    {% if member_link_locked and member_link_admin %}<button type="button" class="btn btn-sm btn-icon" data-member-link-unlock aria-label="{{ t('users.member_unlock') }}" title="{{ t('users.member_unlock') }}"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m16 3 5 5-12 12H4v-5L16 3zM14 5l5 5"/></svg></button>{% endif %}</div>
                    <input type="hidden" name="member_link_unlocked" value="0" data-member-link-unlocked>
                    <select id="user-member-id" name="member_id" class="input{% if errors.member_id is defined %} is-invalid{% endif %}"{% if member_link_locked %} disabled{% endif %} data-person-picker>
                        <option value="">{{ t('members.user.field.none') }}</option>
                        {% for m in linkable_members %}
                        <option value="{{ m.id }}"{% if input.member_id == m.id %} selected{% endif %} data-member-name="{{ m.name }}" data-member-email="{{ m.email|default('') }}">
                            #{{ m.member_no }} {{ m.name }}
                        </option>
                        {% endfor %}
                    </select>
                    {% if errors.member_id is defined %}<div class="field-error">{{ t(errors.member_id) }}</div>{% endif %}
                    <div class="field-hint">{{ t('users.member_identity') }}</div>
                    {% if member_link_locked %}<div class="field-hint">{{ t('users.member_locked') }}</div>{% endif %}
                    {% if input.member_id %}<a href="/members/{{ input.member_id }}">{{ t('users.member_edit') }}</a>{% endif %}
                </div>
                {% if person_data %}<div class="col-span-12"><dl class="grid-12 gap-x-6 mb-0">{% for field in ['phone','address','house_number','zip','city','birth_date'] %}{% if person_data[field]|default('') %}<dt class="col-span-12 sm:col-span-3">{{ t('members.field.' ~ field) }}</dt><dd class="col-span-12 sm:col-span-9">{{ person_data[field] }}</dd>{% endif %}{% endfor %}</dl></div>{% endif %}
                {% if not editing %}
                    {% set mail_available = password_reset_available() %}
                    {% set current_mode = input.password_mode|default(mail_available ? 'invite' : 'manual') %}
                    <div class="col-span-12" data-password-mode-selector>
                        <fieldset>
                            <legend class="label">{{ t('users.password_mode.label') }}</legend>
                            <div class="flex flex-col gap-2">
                                <label class="check mb-0{% if not mail_available %} opacity-50 cursor-not-allowed{% endif %}">
                                    <input class="check-input" type="radio" name="password_mode" value="invite"
                                           {% if current_mode == 'invite' and mail_available %}checked{% endif %}
                                           {% if not mail_available %}disabled{% endif %}
                                           data-password-mode="invite">
                                    <span class="check-label">{{ t('users.password_mode.invite') }}</span>
                                </label>
                                {% if not mail_available %}
                                    <div class="field-hint text-muted -mt-1 ml-6">{{ t('users.password_mode.invite_unavailable') }}</div>
                                {% endif %}
                                <label class="check mb-0">
                                    <input class="check-input" type="radio" name="password_mode" value="manual"
                                           {% if current_mode == 'manual' or not mail_available %}checked{% endif %}
                                           data-password-mode="manual">
                                    <span class="check-label">{{ t('users.password_mode.manual') }}</span>
                                </label>
                            </div>
                            {% if errors.password_mode is defined %}<div class="field-error">{{ t(errors.password_mode) }}</div>{% endif %}
                        </fieldset>
                    </div>
                {% endif %}
                {% if not editing or user_id != me %}
                    {% include 'admin/password_field.twig' %}
                {% endif %}
                <div class="col-span-12">
                    {% if derived_roles %}<div class="mb-4"><strong>{{ t('users.derived_roles') }}</strong>{% for source in derived_roles %}<div>{{ t('users.role.' ~ source.role) }} – {{ source.function_name }}</div>{% endfor %}</div>{% endif %}
                    <fieldset data-user-roles>
                        <legend class="label flex items-center gap-1">{{ t('users.roles') }} {{ role_help.button() }}</legend>
                        <div class="flex flex-col gap-2{% if errors.roles is defined %} is-invalid{% endif %}">
                            {% for role in roles %}
                            <label class="check mb-0">
                                <input class="check-input" type="checkbox" name="roles[]" value="{{ role }}"{% if role in input.roles %} checked{% endif %}>
                                <span class="check-label">{{ t('users.role.' ~ role) }}</span>
                            </label>
                            {% endfor %}
                        </div>
                        {% if errors.roles is defined %}<div class="field-error">{{ t(errors.roles) }}</div>{% endif %}
                        <div class="field-hint">{{ t('users.roles.help') }}</div>
                    </fieldset>
                </div>
                {% if editing %}
                <div class="col-span-12">
                    {% if user_id == me %}
                    <input type="hidden" name="active" value="1">
                    <label class="check mb-0">
                        <input class="check-input" type="checkbox" checked disabled>
                        <span class="check-label">{{ t('users.active.label') }}</span>
                    </label>
                    <div class="field-hint">{{ t('users.active.self_hint') }}</div>
                    {% else %}
                    <label class="check mb-0">
                        <input class="check-input{% if errors.active is defined %} is-invalid{% endif %}" type="checkbox" name="active" value="1"{% if input.active %} checked{% endif %}>
                        <span class="check-label">{{ t('users.active.label') }}</span>
                    </label>
                    {% endif %}
                    {% if errors.active is defined %}<div class="text-danger mt-1">{{ t(errors.active) }}</div>{% endif %}
                </div>
                {% endif %}
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">{{ editing ? t('users.save') : t('users.create') }}</button>
                <a class="btn" href="/users">{{ t('common.cancel') }}</a>
            </div>
        </form>
    </div>
</div>

{% if editing and user_id == me %}
<div class="panel">
    <div class="panel-header"><h2 class="panel-title">{{ t('account.password.title') }}</h2></div>
    <div class="panel-body">
        {% if password_error is not null %}<div class="alert alert-danger" role="alert">{{ t(password_error) }}</div>{% endif %}
        <p class="text-muted">{{ t('users.password.self_hint') }}</p>
        <a class="btn" href="/account/password">{{ t('account.password.title') }}</a>
    </div>
</div>
{% endif %}
{{ role_help.dialog(all_roles, permissions, role_permissions) }}
{% endblock %}

{% block scripts %}<script src="{{ asset('user-identity.js') }}"></script><script src="{{ asset('user-password.js') }}"></script>{% endblock %}
