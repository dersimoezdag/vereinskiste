{% extends 'layout.twig' %}
{% import 'admin/roles_help.twig' as role_help %}
{% block title %}{{ user_id is not null ? t('users.edit.title') : t('users.new') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
{% set editing = user_id is not null %}
<h2 class="h2 mb-4">{{ editing ? t('users.edit.title') : t('users.new') }}</h2>

<div class="card mb-4">
    <div class="card-body">
        <form method="post" action="{{ editing ? '/users/' ~ user_id ~ '/edit' : '/users/new' }}" novalidate>
            {{ csrf_field() }}
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="user-name">{{ t('users.name') }}</label>
                    <input type="text" id="user-name" name="name" maxlength="100" required autocomplete="off"
                           class="form-control{% if errors.name is defined %} is-invalid{% endif %}"
                           value="{{ input.name }}">
                    {% if errors.name is defined %}<div class="invalid-feedback">{{ t(errors.name) }}</div>{% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="user-email">{{ t('users.email') }}</label>
                    <input type="email" id="user-email" name="email" maxlength="254" required autocomplete="off"
                           class="form-control{% if errors.email is defined %} is-invalid{% endif %}"
                           value="{{ input.email }}">
                    {% if errors.email is defined %}<div class="invalid-feedback">{{ t(errors.email) }}</div>{% endif %}
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="user-member-id">{{ t('members.user.field') }}</label>
                    <select id="user-member-id" name="member_id" class="form-select{% if errors.member_id is defined %} is-invalid{% endif %}">
                        <option value="">{{ t('members.user.field.none') }}</option>
                        {% for m in linkable_members %}
                        <option value="{{ m.id }}"{% if input.member_id == m.id %} selected{% endif %}>
                            #{{ m.member_no }} {{ m.name }}
                        </option>
                        {% endfor %}
                    </select>
                    {% if errors.member_id is defined %}<div class="invalid-feedback">{{ t(errors.member_id) }}</div>{% endif %}
                    <div class="form-hint">{{ t('members.user.hint') }}</div>
                </div>
                {% if not editing or user_id != me %}
                    {% include 'admin/password_field.twig' %}
                {% endif %}
                <div class="col-12">
                    <fieldset data-user-roles>
                        <legend class="form-label d-flex align-items-center gap-1">{{ t('users.roles') }} {{ role_help.button() }}</legend>
                        <div class="d-flex flex-column gap-2{% if errors.roles is defined %} is-invalid{% endif %}">
                            {% for role in roles %}
                            <label class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" name="roles[]" value="{{ role }}"{% if role in input.roles %} checked{% endif %}>
                                <span class="form-check-label">{{ t('users.role.' ~ role) }}</span>
                            </label>
                            {% endfor %}
                        </div>
                        {% if errors.roles is defined %}<div class="invalid-feedback">{{ t(errors.roles) }}</div>{% endif %}
                        <div class="form-hint">{{ t('users.roles.help') }}</div>
                    </fieldset>
                </div>
                {% if editing %}
                <div class="col-12">
                    {% if user_id == me %}
                    <input type="hidden" name="active" value="1">
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" checked disabled>
                        <span class="form-check-label">{{ t('users.active.label') }}</span>
                    </label>
                    <div class="form-hint">{{ t('users.active.self_hint') }}</div>
                    {% else %}
                    <label class="form-check mb-0">
                        <input class="form-check-input{% if errors.active is defined %} is-invalid{% endif %}" type="checkbox" name="active" value="1"{% if input.active %} checked{% endif %}>
                        <span class="form-check-label">{{ t('users.active.label') }}</span>
                    </label>
                    {% endif %}
                    {% if errors.active is defined %}<div class="text-danger mt-1">{{ t(errors.active) }}</div>{% endif %}
                </div>
                {% endif %}
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">{{ editing ? t('users.save') : t('users.create') }}</button>
                <a class="btn" href="/users">{{ t('common.cancel') }}</a>
            </div>
        </form>
    </div>
</div>

{% if editing and user_id == me %}
<div class="card">
    <div class="card-header"><h2 class="card-title">{{ t('account.password.title') }}</h2></div>
    <div class="card-body">
        {% if password_error is not null %}<div class="alert alert-danger" role="alert">{{ t(password_error) }}</div>{% endif %}
        <p class="text-secondary">{{ t('users.password.self_hint') }}</p>
        <a class="btn" href="/account/password">{{ t('account.password.title') }}</a>
    </div>
</div>
{% endif %}
{{ role_help.dialog(roles, permissions, role_permissions) }}
{% endblock %}

{% block scripts %}<script src="{{ asset('user-roles.js') }}"></script><script src="{{ asset('user-password.js') }}"></script>{% endblock %}
