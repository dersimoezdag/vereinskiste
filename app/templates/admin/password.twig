{% extends 'layout.twig' %}
{% block title %}{{ t('account.password.title') }}{% endblock %}
{% block content %}
<h1 class="mb-6">{{ t('account.password.title') }}</h1>

<div class="panel">
    <div class="panel-body">
        <form method="post" action="/account/password" novalidate>
            {{ csrf_field() }}
            <div class="grid-12 gap-4">
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="current-password">{{ t('account.password.current') }}</label>
                    <input type="password" id="current-password" name="current_password" required autocomplete="current-password"
                           class="input{% if errors.current_password is defined %} is-invalid{% endif %}">
                    {% if errors.current_password is defined %}<div class="field-error">{{ t(errors.current_password) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6"></div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="new-password">{{ t('account.password.new') }}</label>
                    <input type="password" id="new-password" name="new_password" required autocomplete="new-password"
                           class="input{% if errors.new_password is defined %} is-invalid{% endif %}">
                    <div class="field-hint">{{ t('users.password.help') }}</div>
                    {% if errors.new_password is defined %}<div class="field-error">{{ t(errors.new_password) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="confirm-password">{{ t('account.password.confirm') }}</label>
                    <input type="password" id="confirm-password" name="confirm_password" required autocomplete="new-password"
                           class="input{% if errors.confirm_password is defined %} is-invalid{% endif %}">
                    {% if errors.confirm_password is defined %}<div class="field-error">{{ t(errors.confirm_password) }}</div>{% endif %}
                </div>
            </div>
            <div class="mt-6">
                <button type="submit" class="btn btn-primary">{{ t('account.password.submit') }}</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
