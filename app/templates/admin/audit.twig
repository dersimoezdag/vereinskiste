{% extends 'layout.twig' %}
{% block title %}{{ t('audit.title') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
<h2 class="mb-6">{{ t('audit.title') }}</h2>

<form method="get" action="/audit-log" class="flex flex-wrap items-end gap-2 mb-6">
    <div>
        <label class="label" for="audit-action">{{ t('audit.filter') }}</label>
        <select id="audit-action" name="action" class="input">
            <option value="">{{ t('audit.filter.all') }}</option>
            {% for a in actions %}
            <option value="{{ a }}"{% if a == action %} selected{% endif %}>{{ t('audit.action.' ~ a) }}</option>
            {% endfor %}
        </select>
    </div>
    <button type="submit" class="btn">{{ t('audit.filter.apply') }}</button>
</form>

<div class="panel mb-6">
    <div class="table-scroll">
        <table class="data-table table-cards">
            <thead>
                <tr>
                    <th>{{ t('audit.when') }}</th>
                    <th>{{ t('audit.who') }}</th>
                    <th>{{ t('audit.action') }}</th>
                    <th>{{ t('audit.detail') }}</th>
                </tr>
            </thead>
            <tbody>
            {% for entry in entries %}
                <tr>
                    <td data-label="{{ t('audit.when') }}">{{ entry.at|date('d.m.Y H:i') }}</td>
                    <td data-label="{{ t('audit.who') }}">{{ entry.user_name ?? '–' }}</td>
                    <td data-label="{{ t('audit.action') }}">{% set action_label = t('audit.action.' ~ entry.action) %}{{ action_label starts with 'audit.action.' ? entry.action : action_label }}</td>
                    <td data-label="{{ t('audit.detail') }}">
                        {% if entry.detail %}
                        <ul class="list-none pl-0 mb-0">
                            {% for d in entry.detail %}
                            <li>
                                {% set detail_label = t('audit.detail.' ~ d.key) %}
                                <strong>{{ detail_label starts with 'audit.detail.' ? d.key : detail_label }}:</strong>
                                {% if d.value is null or d.value == '' %}–{% elseif d.key in ['roles', 'roles_added', 'roles_removed'] %}{% for r in d.value|split(', ') %}{{ t('users.role.' ~ r) }}{% if not loop.last %}, {% endif %}{% endfor %}{% elseif d.key == 'fields' %}{% for f in d.value|split(', ') %}{{ t('users.field.' ~ f) }}{% if not loop.last %}, {% endif %}{% endfor %}{% elseif d.key == 'subject' %}{% set subject_label = t('audit.subject.' ~ d.value) %}{{ subject_label starts with 'audit.subject.' ? d.value : subject_label }}{% elseif d.is_date %}{{ d.value|date('d.m.Y') }}{% else %}{{ d.value }}{% endif %}
                            </li>
                            {% endfor %}
                        </ul>
                        {% else %}–{% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-muted">{{ t('audit.empty') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% include 'components/pagination.twig' %}
{% endblock %}
