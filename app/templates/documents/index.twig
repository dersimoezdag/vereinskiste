{% extends 'layout.twig' %}
{% block title %}{{ t('documents.kind.' ~ kind) }}{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-3">
 <h1>{{ t('documents.kind.' ~ kind) }}</h1>
 {% if can('documents.write') %}<a class="btn btn-primary" href="/documents/{{ kind }}/new">{{ t(kind == 'minutes' ? 'documents.new' : 'documents.new_version') }}</a>{% endif %}
</div>
{% if not can('documents.write') %}<div class="alert alert-info" role="status">{{ t('documents.write_required') }}</div>{% endif %}
{% if kind == 'minutes' %}
<div class="card"><div class="table-responsive"><table class="table table-vcenter mb-0"><thead><tr><th>{{ t('documents.field.document_date') }}</th><th>{{ t('documents.field.title') }}</th><th>{{ t('documents.field.meeting_type') }}</th><th>{{ t('documents.field.status') }}</th></tr></thead><tbody>
 {% for row in rows %}<tr><td>{{ row.document_date|date('d.m.Y') }}</td><td><a href="/documents/minutes/{{ row.document_id }}">{{ row.title }}</a></td><td>{{ t('documents.type.' ~ row.meeting_type) }}</td><td>{{ t('documents.status.' ~ row.status) }}</td></tr>{% else %}<tr><td colspan="4">{{ t('documents.empty') }}</td></tr>{% endfor %}
</tbody></table></div></div>
{% else %}
<div class="card mb-3"><div class="card-header"><h2 class="card-title">{{ t('documents.current') }}</h2></div><div class="card-body">
 {% if document %}<h3>{{ document.title }}</h3>{% include 'documents/content.twig' %}{% else %}<p class="text-muted">{{ t('documents.no_current') }}</p>{% endif %}
</div></div>
{% if draft %}<div class="card mb-3"><div class="card-body"><h2 class="h3">{{ t('documents.draft') }}</h2><p>{{ draft.title }} · {{ draft.label }}</p><a class="btn" href="/documents/{{ kind }}/{{ root.id }}/edit">{{ t('documents.edit') }}</a></div></div>{% endif %}
{% endif %}
{% if root %}<details class="mt-4"><summary>{{ t('documents.archive') }}</summary><ul class="mt-2">
 {% for row in rows %}{% if row.version != document.version|default(0) and row.version != draft.version|default(0) %}<li><a href="/documents/{{ kind }}/{{ root.id }}/versions/{{ row.version }}">{{ row.label|default(t('documents.version') ~ ' ' ~ row.version) }}</a> · {{ row.document_date|date('d.m.Y') }} · {{ t('documents.status.' ~ row.status) }}</li>{% endif %}{% endfor %}
</ul></details>{% endif %}
<div class="d-flex gap-2 mt-3">{% if page > 1 %}<a class="btn" href="?page={{ page - 1 }}" aria-label="Vorherige Seite">←</a>{% endif %}{% if more %}<a class="btn" href="?page={{ page + 1 }}" aria-label="Nächste Seite">→</a>{% endif %}</div>
{% endblock %}
