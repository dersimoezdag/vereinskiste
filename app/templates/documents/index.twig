{% extends 'layout.twig' %}
{% block title %}{{ t('documents.kind.' ~ kind) }}{% endblock %}
{% block content %}
<div class="flex flex-wrap gap-3 justify-between items-center mb-4">
 <h1>{{ t('documents.kind.' ~ kind) }}</h1>
 {% if can('documents.write') %}<a class="btn btn-primary" href="/documents/{{ kind }}/new">{{ t(kind == 'minutes' ? 'documents.new' : 'documents.new_version') }}</a>{% endif %}
</div>
{% if not can('documents.write') %}<div class="alert alert-info" role="status">{{ t('documents.write_required') }}</div>{% endif %}
{% if kind == 'minutes' %}
{% embed 'components/data_grid.twig' with {rows: rows, server_paged: true, columns: [
{key: 'document_date', label: t('documents.field.document_date'), type: 'date'},
{key: 'title', label: t('documents.field.title')},
{key: 'meeting_type', label: t('documents.field.meeting_type')},
{key: 'status', label: t('documents.field.status')}
], label: t('documents.kind.' ~ kind), empty_text: t('documents.empty')} %}
{% block cell %}
{% if column.key == 'document_date' %}{{ row.document_date|date('d.m.Y') }}
{% elseif column.key == 'title' %}<a href="/documents/minutes/{{ row.document_id }}">{{ row.title }}</a>
{% elseif column.key == 'meeting_type' %}{{ t('documents.type.' ~ row.meeting_type) }}
{% elseif column.key == 'status' %}{{ t('documents.status.' ~ row.status) }}
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% endembed %}
{% else %}
<div class="panel mb-4"><div class="panel-header"><h2 class="panel-title">{{ t('documents.current') }}</h2></div><div class="panel-body">
 {% if document %}<h3>{{ document.title }}</h3>{% include 'documents/content.twig' %}{% else %}<p class="text-muted">{{ t('documents.no_current') }}</p>{% endif %}
</div></div>
{% if draft %}<div class="panel mb-4"><div class="panel-body"><h2 class="h3">{{ t('documents.draft') }}</h2><p>{{ draft.title }} · {{ draft.label }}</p><a class="btn" href="/documents/{{ kind }}/{{ root.id }}/edit">{{ t('documents.edit') }}</a></div></div>{% endif %}
{% endif %}
{% if root %}<details class="mt-6"><summary>{{ t('documents.archive') }}</summary><ul class="mt-2">
 {% for row in rows %}{% if row.version != document.version|default(0) and row.version != draft.version|default(0) %}<li><a href="/documents/{{ kind }}/{{ root.id }}/versions/{{ row.version }}">{{ row.label|default(t('documents.version') ~ ' ' ~ row.version) }}</a> · {{ row.document_date|date('d.m.Y') }} · {{ t('documents.status.' ~ row.status) }}</li>{% endif %}{% endfor %}
</ul></details>{% endif %}
{% include 'components/pagination.twig' %}
{% endblock %}
