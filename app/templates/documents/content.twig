<p class="text-muted">{{ document.kind == 'minutes' ? t('documents.field.document_date') : t('documents.valid_from') }}: {{ document.document_date|date('d.m.Y') }} · {{ document.label|default(t('documents.version') ~ ' ' ~ document.version) }} · {{ t('documents.status.' ~ document.status) }}</p>
{% if document.kind == 'minutes' %}<p>{{ t('documents.field.meeting_type') }}: {{ t('documents.type.' ~ document.meeting_type) }}</p><p>{{ t('documents.field.participants') }}: {{ document.participants }}</p>{% endif %}
{% if document.source == 'editor' %}<div class="document-content">{{ document.content|raw }}</div>{% else %}<p>{{ document.file_name }} · {{ (document.file_size / 1024)|round }} KB</p>{% endif %}
<a class="btn btn-outline-primary mt-3" href="/documents/{{ document.kind }}/{{ document.document_id }}/pdf{% if document.kind != 'minutes' or historic|default(false) %}?version={{ document.version }}{% endif %}">{{ t('documents.pdf') }}</a>
