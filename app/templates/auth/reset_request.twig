{% extends 'layout.twig' %}
{% block title %}{{ t('reset.title') }}{% endblock %}
{% block content %}
<div class="panel"><div class="panel-body">
    <h1 class="h2">{{ t('reset.title') }}</h1>
    {% if not configured %}
    <p role="status">{{ t('reset.disabled') }}</p>
    {% elseif sent %}
    <p role="status">{{ t('reset.sent') }}</p>
    {% else %}
    <p>{{ t('reset.instructions') }}</p>
    <form method="post" action="/password-reset">
        {{ csrf_field() }}
        <div class="mb-4">
            <label class="label" for="email">{{ t('auth.login.email') }}</label>
            <input class="input" type="email" id="email" name="email" autocomplete="username" required>
        </div>
        <button class="btn btn-primary w-full" type="submit">{{ t('reset.request') }}</button>
    </form>
    {% endif %}
    <a class="btn btn-link w-full mt-2" href="/login">{{ t('reset.login') }}</a>
</div></div>
{% endblock %}
