{% extends 'layout.twig' %}
{% block title %}{{ t('auth.login.title') }}{% endblock %}
{% block content %}
<h1>{{ t('auth.login.title') }}</h1>
{% if error %}<p role="alert">{{ t('auth.login.error') }}</p>{% endif %}
<form method="post" action="/login">
    {{ csrf_field() }}
    <p>
        <label for="email">{{ t('auth.login.email') }}</label><br>
        <input type="email" id="email" name="email" value="{{ email }}" autocomplete="username" required>
    </p>
    <p>
        <label for="password">{{ t('auth.login.password') }}</label><br>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
    </p>
    <p><button type="submit">{{ t('auth.login.submit') }}</button></p>
</form>
{% endblock %}
