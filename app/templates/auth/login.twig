{% extends 'layout.twig' %}
{% block title %}{{ t('auth.login.title') }}{% endblock %}
{% block content %}
<div class="panel">
    <div class="panel-body">
        <h1 class="h2 text-center mb-6">{{ t('auth.login.title') }}</h1>
        {% if error %}<div class="alert alert-danger" role="alert">{{ t('auth.login.error') }}</div>{% endif %}
        {% if throttled|default(false) %}<div class="alert alert-danger" role="alert">{{ t('auth.login.throttled') }}</div>{% endif %}
        <form method="post" action="/login">
            {{ csrf_field() }}
            <div class="mb-4">
                <label class="label" for="email">{{ t('auth.login.email') }}</label>
                <input type="email" class="input" id="email" name="email" value="{{ email }}" autocomplete="username" data-mask="none" required>
            </div>
            <div class="mb-4">
                <label class="label" for="password">{{ t('auth.login.password') }}</label>
                <input type="password" class="input" id="password" name="password" autocomplete="current-password" required>
            </div>
            <button type="submit" class="btn btn-primary w-full">{{ t('auth.login.submit') }}</button>
        </form>
        {% if password_reset_available() %}
        <a class="btn btn-link w-full mt-2" href="/password-reset">{{ t('reset.title') }}</a>
        {% endif %}
    </div>
</div>
{% endblock %}
