{% extends 'layout.twig' %}
{% block title %}{{ t('funding.title') }}{% endblock %}
{% block content %}
<h1>{{ t('funding.title') }}</h1>
{% if can('funding.write') %}<div class="mb-4"><a class="btn btn-primary" href="/funding/new">{{ t('funding.new') }}</a></div>{% endif %}
{% embed 'components/data_grid.twig' with {rows: applications, server_paged: false, columns: [
{key: 'title', label: t('funding.field.title')},
{key: 'funder', label: t('foundation.field.funder')},
{key: 'status', label: t('foundation.field.status')},
{key: 'requested_amount', label: t('foundation.field.requested_amount'), type: 'money'},
{key: 'approved_amount', label: t('foundation.field.approved_amount'), type: 'money'},
{key: 'received', label: t('funding.received'), type: 'money'}
], label: t('funding.title'), empty_text: t('funding.empty')} %}
{% block cell %}
{% if column.key == 'title' %}<a href="/funding/{{ row.id }}">{{ row.title }}</a>
{% elseif column.key == 'status' %}{{ t('funding.status.' ~ row.status) }}
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% endembed %}
{% endblock %}
