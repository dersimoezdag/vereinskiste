{% extends 'layout.twig' %}
{% block title %}{{ application ? application.title : t('funding.new') }}{% endblock %}
{% block content %}
{% set writable = can('funding.write') %}
<h1>{{ application ? application.title : t('funding.new') }}</h1>
{% if errors.delete is defined %}<p class="alert alert-warning" role="alert">{{ t(errors.delete) }}</p>{% endif %}
{% if errors.version is defined %}<p class="alert alert-warning" role="alert">{{ t(errors.version) }}</p>{% endif %}
{% if application %}
<p><strong>{{ t('funding.received') }}: {{ application.received|eur }}</strong><br><span class="field-hint">{{ t('funding.received_hint') }}</span></p>
{% endif %}
<form method="post" action="{{ application ? '/funding/' ~ application.id : '/funding/new' }}" class="panel panel-body mb-4">
    {{ csrf_field() }}
    <input type="hidden" name="version" value="{{ application ? application.version : 0 }}">
    <fieldset{% if not writable %} disabled{% endif %}>
    <div class="grid-12 gap-4 mb-4">
        <div class="col-span-12 md:col-span-6"><label class="label" for="funding-title">{{ t('funding.field.title') }}</label>
            <input class="input{% if errors.title is defined %} is-invalid{% endif %}" id="funding-title" name="title" maxlength="200" required value="{{ input.title|default('') }}">
            {% if errors.title is defined %}<div class="field-error">{{ t(errors.title) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-6"><label class="label" for="funding-funder">{{ t('foundation.field.funder') }}</label>
            <input class="input{% if errors.funder is defined %} is-invalid{% endif %}" id="funding-funder" name="funder" maxlength="200" required value="{{ input.funder|default('') }}">
            {% if errors.funder is defined %}<div class="field-error">{{ t(errors.funder) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-6"><label class="label" for="funding-event">{{ t('foundation.field.event_id') }}</label>
            <select class="input{% if errors.event_id is defined %} is-invalid{% endif %}" id="funding-event" name="event_id"><option value="">{{ t('events.none') }}</option>
            {% for event in events %}<option value="{{ event.id }}"{% if input.event_id|default('') ~ '' == event.id ~ '' %} selected{% endif %}>{{ event.title }} ({{ event.starts_on|date('d.m.Y') }})</option>{% endfor %}</select></div>
        <div class="col-span-12 md:col-span-6"><label class="label" for="funding-status">{{ t('foundation.field.status') }}</label>
            <select class="input" id="funding-status" name="status">{% for status in statuses %}<option value="{{ status }}"{% if input.status|default('draft') == status %} selected{% endif %}>{{ t('funding.status.' ~ status) }}</option>{% endfor %}</select></div>
        {% for field in ['requested_amount', 'approved_amount'] %}
        <div class="col-span-12 md:col-span-6"><label class="label" for="funding-{{ field }}">{{ t('foundation.field.' ~ field) }}</label>
            <input class="input{% if errors[field] is defined %} is-invalid{% endif %}" id="funding-{{ field }}" name="{{ field }}" data-mask="{{ field == 'approved_amount' ? 'approved_amount' : 'amount' }}" inputmode="decimal"{% if field == 'requested_amount' %} required{% endif %} value="{{ input[field]|default('') }}">
            {% if errors[field] is defined %}<div class="field-error">{{ t(errors[field]) }}</div>{% endif %}</div>
        {% endfor %}
        {% for field in ['submitted_on', 'decided_on', 'proof_due_on'] %}
        <div class="col-span-12 md:col-span-4"><label class="label" for="funding-{{ field }}">{{ t('foundation.field.' ~ field) }}</label>
            <input class="input{% if errors[field] is defined %} is-invalid{% endif %}" type="date" id="funding-{{ field }}" name="{{ field }}" value="{{ input[field]|default('') }}">
            {% if errors[field] is defined %}<div class="field-error">{{ t(errors[field]) }}</div>{% endif %}</div>
        {% endfor %}
        <div class="col-span-12"><label class="label" for="funding-notes">{{ t('foundation.field.notes') }}</label>
            {% if writable %}<textarea class="input{% if errors.notes is defined %} is-invalid{% endif %}" id="funding-notes" name="notes" rows="8" data-rich-text>{{ input.notes|default('')|note|e }}</textarea>{% elseif input.notes|default('') %}<div class="document-content" id="funding-notes">{{ input.notes|note }}</div>{% else %}<p id="funding-notes">–</p>{% endif %}</div>
    </div>
    {% if writable %}<div><button class="btn btn-primary" type="submit">{{ t('foundation.save') }}</button></div>{% endif %}
    </fieldset>
</form>
{% if application %}
<div class="panel mb-4"><div class="panel-body">
    <h2 class="panel-title">{{ t('funding.items') }}</h2>
    {% set sum = 0 %}
    <table class="data-table table-cards"><thead><tr><th>{{ t('funding.item.label') }}</th><th>{{ t('bookings.amount_eur') }}</th>{% if writable %}<th>{{ t('events.remove') }}</th>{% endif %}</tr></thead><tbody>
    {% for item in items %}<tr>
        <td data-label="{{ t('funding.item.label') }}">{{ item.label }}</td>
        <td data-label="{{ t('bookings.amount_eur') }}">{{ item.amount is null ? '–' : item.amount|eur }}</td>
        {% if writable %}<td data-label="{{ t('events.remove') }}"><form method="post" action="/funding/{{ application.id }}/item-remove/{{ item.id }}">{{ csrf_field() }}<button class="btn btn-link p-0" type="submit">{{ t('events.remove') }}</button></form></td>{% endif %}
    </tr>{% else %}<tr><td colspan="3">{{ t('foundation.empty') }}</td></tr>{% endfor %}
    </tbody></table>
    {% if writable %}
    <form method="post" action="/funding/{{ application.id }}/item" class="grid-12 gap-2 mt-2">
        {{ csrf_field() }}
        <div class="col-span-12 md:col-span-6"><label class="label" for="item-label">{{ t('funding.item.label') }}</label>
            <input class="input{% if errors.label is defined %} is-invalid{% endif %}" id="item-label" name="label" maxlength="200" required></div>
        <div class="col-span-12 md:col-span-3"><label class="label" for="item-amount">{{ t('funding.item.amount') }}</label>
            <input class="input{% if errors.amount is defined %} is-invalid{% endif %}" id="item-amount" name="amount" inputmode="decimal">
            {% if errors.amount is defined %}<div class="field-error">{{ t(errors.amount) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-3 flex items-end"><button class="btn btn-soft w-full" type="submit">{{ t('funding.item.add') }}</button></div>
    </form>
    {% endif %}
</div></div>
{% if can('bookings.read') %}
<div class="panel mb-4"><div class="panel-body">
    <h2 class="panel-title">{{ t('events.bookings') }}</h2>
    <ul class="mb-0">{% for booking in bookings %}<li>{{ booking.booking_date|date('d.m.Y') }} · <a href="/bookings/{{ booking.id }}">{{ booking.description }}</a> · {{ booking.direction == 'out' ? '-' : '' }}{{ booking.amount|eur }}</li>{% else %}<li>{{ t('events.bookings_empty') }}</li>{% endfor %}</ul>
</div></div>
{% endif %}
{% if writable %}<form method="post" action="/funding/{{ application.id }}/delete" class="mb-4">{{ csrf_field() }}<button class="btn btn-danger-soft" type="submit">{{ t('events.delete') }}</button></form>{% endif %}
{% endif %}
<a class="btn btn-link" href="/funding">{{ t('common.back') }}</a>
{% include 'components/foundation_history.twig' %}
{% endblock %}
{% block scripts %}{% if can('funding.write') %}<script src="{{ asset('vendor/tinymce/tinymce.min.js') }}"></script><script src="{{ asset('rich-text.js') }}"></script>{% endif %}{% endblock %}
