{% extends 'layout.twig' %}
{% block title %}{{ t('events.title') }}{% endblock %}
{% block content %}
<h1>{{ t('events.title') }}</h1>
<nav class="tabs mb-4" aria-label="{{ t('events.title') }}">
    <a class="tab{% if kind == 'event' %} active{% endif %}" href="/events">{{ t('events.title') }}</a>
    <a class="tab{% if kind == 'template' %} active{% endif %}" href="/events?view=templates">{{ t('events.templates') }}</a>
</nav>
{% if can('events.write') %}
<div class="flex flex-wrap gap-2 mb-4">
    <a class="btn btn-primary" href="/events/new{% if kind == 'template' %}?kind=template{% endif %}">{{ t(kind == 'template' ? 'events.new_template' : 'events.new') }}</a>
</div>
{% endif %}
{% set columns = [{key: 'title', label: t('foundation.field.title')}] %}
{% if kind == 'event' %}
{% set columns = columns|merge([
{key: 'starts_on', label: t('foundation.field.starts_on'), type: 'date'},
{key: 'status', label: t('foundation.field.status')}
]) %}
{% endif %}
{% set columns = columns|merge([
{key: 'location', label: t('foundation.field.location')},
{key: 'tasks_done', label: t('events.tasks_progress')}
]) %}
{% embed 'components/data_grid.twig' with {rows: events, columns: columns, server_paged: false, label: t(kind == 'template' ? 'events.templates' : 'events.title'), empty_text: t(kind == 'template' ? 'events.templates_empty' : 'events.empty')} %}
{% block cell %}
{% if column.key == 'title' %}<a href="/events/{{ row.id }}">{{ row.title }}</a>
{% elseif column.key == 'starts_on' %}{{ row.starts_on|date('d.m.Y') }}{% if row.ends_on %} – {{ row.ends_on|date('d.m.Y') }}{% endif %}
{% elseif column.key == 'status' %}{{ t('events.status.' ~ row.status) }}
{% elseif column.key == 'tasks_done' %}{{ row.tasks_done }} / {{ row.tasks_total }}
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% endembed %}
{% endblock %}
