{% extends 'layout.twig' %}
{% block title %}Belegeingang{% endblock %}
{% block content %}
<h1>Belegeingang</h1>
<p>Belege werden ausschließlich gezielt hochgeladen. Eine automatische Übernahme aus E-Mails findet nicht statt.</p>
{% if can('invoices.write') %}<a class="btn btn-primary mb-3" href="/invoices/import">Beleg hochladen</a>{% endif %}
<div class="card"><div class="card-body"><h2>Belege zur Prüfung</h2>
{% for document in documents %}<div class="border-bottom py-3"><a href="/invoices/{{ document.invoice_id }}">Rechnung #{{ document.invoice_id }}</a> · {{ document.original_name }}<p>{{ t('intake.security.' ~ document.security_status) }} · {{ t('invoices.extraction.' ~ document.extraction_status) }}</p></div>{% else %}<p>Keine Belege zur Prüfung.</p>{% endfor %}
</div></div>
{% endblock %}
