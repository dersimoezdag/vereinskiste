{% set request = payment.request %}
<div class="card card-body mt-3"><h2>{{ t('intake.payment.title') }}</h2>
<p>Bezahlt: {{ payment.paid|eur }} · Verbleibend: {{ payment.remaining|eur }}. Stornierte Bankbuchungen zählen nicht als Zahlung.</p>
{% if request %}<p>Status: {{ t('intake.payment.' ~ request.status) }}</p><dl><dt>Empfänger</dt><dd>{{ request.recipient }}</dd><dt>IBAN</dt><dd>{{ request.iban }}</dd><dt>Verwendungszweck</dt><dd>{{ request.purpose }}</dd></dl>{% endif %}
{% if can('invoices.write') and invoice.status!='cancelled' and invoice.kind=='invoice' and (not request or request.status=='draft') %}
<form method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version|default(0) }}"><input type="hidden" name="action" value="save">
<label class="form-label" for="payment-kind">Zahlungsart</label><select class="form-select mb-3" id="payment-kind" name="kind"><option value="supplier"{% if request.kind=='supplier' %} selected{% endif %}>Rechnung an Lieferanten zahlen</option><option value="reimbursement"{% if request.kind=='reimbursement' %} selected{% endif %}>Auslage an Mitglied erstatten</option></select>
<label class="form-label" for="payment-member">Mitglied bei Erstattung</label><select class="form-select mb-3" id="payment-member" name="member_id"><option value="">Bitte wählen</option>{% for member in members %}<option value="{{ member.id }}"{% if request.member_id==member.id %} selected{% endif %}>{{ member.name }}</option>{% endfor %}</select>
<p class="text-muted">Bei einer Erstattung wird der Name des gewählten Mitglieds als Empfänger übernommen.</p>
{% for field,label in {'recipient':'Empfänger (bei Lieferantenzahlung)','iban':'Geprüfte IBAN','purpose':'Verwendungszweck','reason':'Anlass / Veranstaltung und Begründung'} %}<label class="form-label" for="payment-{{ field }}">{{ label }}</label><input class="form-control mb-3" id="payment-{{ field }}" name="{{ field }}" value="{{ request[field]|default('') }}" maxlength="{{ field=='reason'?500:200 }}"{% if field!='recipient' %} required{% endif %}>{% endfor %}
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="recipient_verified" value="1" required><span class="form-check-label">Empfänger, Anspruch auf Erstattung und Bankverbindung unabhängig von der eingegangenen E-Mail geprüft.</span></label><button class="btn btn-primary">Zahlungsvorschlag speichern</button>
</form>{% endif %}
{% if request and request.status=='draft' and can('payments.approve') %}<form class="mt-3" method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version }}"><label class="form-label" for="payment-approval-reason">Begründung der Entscheidung</label><input class="form-control mb-3" id="payment-approval-reason" name="reason" maxlength="500" required><p>Freigabe erst nach Belegprüfung. {% if payment_policy.four_eyes %}Vier-Augen-Prinzip aktiv: Eigene Belege und Zahlungsvorschläge benötigen eine andere freigebende Person.{% else %}Einzelbearbeitung aktiv: Der Kassenwart kann Beleg und Zahlung selbst freigeben.{% endif %} Erstattungen an dein eigenes verknüpftes Mitglied benötigen weiterhin eine andere Person.</p><button class="btn btn-primary" name="action" value="approve">Zahlung freigeben</button> <button class="btn btn-outline-danger" name="action" value="reject">Ablehnen</button></form>{% endif %}
{% if request and request.status=='approved' and invoice.status=='reviewed' %}<p class="alert alert-info mt-3">Die Freigabe löst keine Überweisung aus. Zahlung im Bankprogramm ausführen und danach die tatsächliche Buchung zuordnen.</p>
{% if can('invoices.write') and can('bookings.write') and payment.remaining!='0.00' %}<form method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version }}"><input type="hidden" name="action" value="allocate"><label class="form-label" for="payment-booking">Bankbuchung auswählen (nur unzugeordnete Ausgaben bis zum Restbetrag)</label><select class="form-select mb-3" id="payment-booking" name="booking_id" required><option value="">Bitte wählen und Empfänger abgleichen</option>{% for booking in payment.candidates %}<option value="{{ booking.id }}">#{{ booking.id }} · {{ booking.booking_date|date('d.m.Y') }} · {{ booking.amount|eur }} · {{ booking.counterparty }} · {{ booking.description }}</option>{% endfor %}</select><label class="form-label" for="payment-allocation-reason">Begründung der Zuordnung</label><input class="form-control mb-3" id="payment-allocation-reason" name="reason" maxlength="500" required><button class="btn">Zahlung zuordnen</button></form>{% endif %}{% endif %}
{% for allocation in payment.allocations %}<div class="border-top mt-3 pt-3"><a href="/bookings/{{ allocation.booking_id }}">Buchung #{{ allocation.booking_id }}</a> · {{ allocation.amount|eur }} · {{ allocation.status=='active'?'Aktiv':'Storniert' }}
{% if can('invoices.write') and can('bookings.write') %}<form class="mt-2" method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version }}"><input type="hidden" name="booking_id" value="{{ allocation.booking_id }}"><input type="hidden" name="action" value="unlink"><input class="form-control mb-2" name="reason" maxlength="500" aria-label="Begründung für das Aufheben der Zuordnung" required><button class="btn btn-sm">Zuordnung aufheben</button></form>{% endif %}</div>{% endfor %}
{% if payment.history %}<h3 class="mt-3">Zahlungshistorie</h3>{% for entry in payment.history %}<p>{{ entry.at|date('d.m.Y H:i') }} · {{ entry.actor }} · {{ entry.reason }}</p>{% endfor %}{% endif %}
</div>
