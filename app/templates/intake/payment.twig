{% set request = payment.request %}
<div class="card card-body mt-3"><h2>{{ t('intake.payment.title') }}</h2>
<p>{{ t('ui.bezahlt') }} {{ payment.paid|eur }} {{ t('ui.verbleibend') }} {{ payment.remaining|eur }}{{ t('ui.stornierte_bankbuchungen_zaehlen_nicht_als_zahlung') }}</p>
{% if request %}<p>{{ t('ui.status') }} {{ t('intake.payment.' ~ request.status) }}</p><dl><dt>{{ t('ui.empfaenger') }}</dt><dd>{{ request.recipient }}</dd><dt>{{ t('foundation.field.iban') }}</dt><dd>{{ request.iban }}</dd><dt>{{ t('bank.field.purpose') }}</dt><dd>{{ request.purpose }}</dd></dl>{% endif %}
{% if can('invoices.write') and invoice.status!='cancelled' and invoice.kind=='invoice' and (not request or request.status=='draft') %}
<form method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version|default(0) }}"><input type="hidden" name="action" value="save">
<label class="form-label" for="payment-kind">{{ t('ui.zahlungsart') }}</label><select class="form-select mb-3" id="payment-kind" name="kind"><option value="supplier"{% if request.kind=='supplier' %} selected{% endif %}>{{ t('ui.rechnung_an_lieferanten_zahlen') }}</option><option value="reimbursement"{% if request.kind=='reimbursement' %} selected{% endif %}>{{ t('ui.auslage_an_mitglied_erstatten') }}</option></select>
<label class="form-label" for="payment-member">{{ t('ui.mitglied_bei_erstattung') }}</label><select class="form-select mb-3" id="payment-member" name="member_id"><option value="">{{ t('bookings.choose') }}</option>{% for member in members %}<option value="{{ member.id }}"{% if request.member_id==member.id %} selected{% endif %}>{{ member.name }}</option>{% endfor %}</select>
<p class="text-muted">{{ t('ui.bei_einer_erstattung_wird_der_name_des_gewaehlten_mitglieds_als_e') }}</p>
{% for field,label in {'recipient':'Empfänger (bei Lieferantenzahlung)','iban':'Geprüfte IBAN','purpose':'Verwendungszweck','reason':'Anlass / Veranstaltung und Begründung'} %}<label class="form-label" for="payment-{{ field }}">{{ label }}</label><input class="form-control mb-3" id="payment-{{ field }}" name="{{ field }}" value="{{ request[field]|default('') }}" maxlength="{{ field=='reason'?500:200 }}"{% if field!='recipient' %} required{% endif %}>{% endfor %}
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="recipient_verified" value="1" required><span class="form-check-label">{{ t('intake.payment.recipient_verified') }}</span></label><button class="btn btn-primary">{{ t('ui.zahlungsvorschlag_speichern') }}</button>
</form>{% endif %}
{% if request and request.status=='draft' and can('payments.approve') %}<form class="mt-3" method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version }}"><label class="form-label" for="payment-approval-reason">{{ t('ui.begruendung_der_entscheidung') }}</label><input class="form-control mb-3" id="payment-approval-reason" name="reason" maxlength="500" required><p>{{ t('ui.freigabe_erst_nach_belegpruefung') }} {% if payment_policy.four_eyes %}{{ t('ui.vier_augen_prinzip_aktiv_eigene_belege_und_zahlungsvorschlaege_be') }}{% else %}{{ t('ui.einzelbearbeitung_aktiv_der_kassenwart_kann_beleg_und_zahlung_sel') }}{% endif %} {{ t('ui.erstattungen_an_dein_eigenes_verknuepftes_mitglied_benoetigen_wei') }}</p><button class="btn btn-primary" name="action" value="approve">{{ t('ui.zahlung_freigeben') }}</button> <button class="btn btn-outline-danger" name="action" value="reject">{{ t('ui.ablehnen') }}</button></form>{% endif %}
{% if request and request.status=='approved' and invoice.status=='reviewed' %}<p class="alert alert-info mt-3">{{ t('ui.die_freigabe_loest_keine_ueberweisung_aus_zahlung_im_bankprogramm') }}</p>
{% if can('invoices.write') and can('bookings.write') and payment.remaining!='0.00' %}<form method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version }}"><input type="hidden" name="action" value="allocate"><label class="form-label" for="payment-booking">{{ t('ui.bankbuchung_auswaehlen_nur_unzugeordnete_ausgaben_bis_zum_restbet') }}</label><select class="form-select mb-3" id="payment-booking" name="booking_id" required><option value="">{{ t('ui.bitte_waehlen_und_empfaenger_abgleichen') }}</option>{% for booking in payment.candidates %}<option value="{{ booking.id }}">#{{ booking.id }} · {{ booking.booking_date|date('d.m.Y') }} · {{ booking.amount|eur }} · {{ booking.counterparty }} · {{ booking.description }}</option>{% endfor %}</select><label class="form-label" for="payment-allocation-reason">{{ t('ui.begruendung_der_zuordnung') }}</label><input class="form-control mb-3" id="payment-allocation-reason" name="reason" maxlength="500" required><button class="btn">{{ t('ui.zahlung_zuordnen') }}</button></form>{% endif %}{% endif %}
{% for allocation in payment.allocations %}<div class="border-top mt-3 pt-3"><a href="/bookings/{{ allocation.booking_id }}">{{ t('ui.buchung') }}{{ allocation.booking_id }}</a> · {{ allocation.amount|eur }} · {{ allocation.status=='active'?'Aktiv':'Storniert' }}
{% if can('invoices.write') and can('bookings.write') %}<form class="mt-2" method="post" action="/invoices/{{ invoice.id }}/payment">{{ csrf_field() }}<input type="hidden" name="version" value="{{ request.version }}"><input type="hidden" name="booking_id" value="{{ allocation.booking_id }}"><input type="hidden" name="action" value="unlink"><input class="form-control mb-2" name="reason" maxlength="500" aria-label="{{ t('ui.begruendung_fuer_das_aufheben_der_zuordnung') }}" required><button class="btn btn-sm">{{ t('ui.zuordnung_aufheben') }}</button></form>{% endif %}</div>{% endfor %}
{% if payment.history %}<h3 class="mt-3">{{ t('ui.zahlungshistorie') }}</h3>{% for entry in payment.history %}<p>{{ entry.at|date('d.m.Y H:i') }} · {{ entry.actor }} · {{ entry.reason }}</p>{% endfor %}{% endif %}
</div>
