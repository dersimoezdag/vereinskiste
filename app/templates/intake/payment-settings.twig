{% extends 'layout.twig' %}
{% block title %}{{ t('audit.subject.payment_policy') }}{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
<h2>{{ t('audit.subject.payment_policy') }}</h2>
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
<form class="card card-body" method="post" action="/settings/payments">{{ csrf_field() }}<input type="hidden" name="version" value="{{ policy.version }}">
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="four_eyes" value="1"{% if policy.four_eyes %} checked{% endif %}><span class="form-check-label">{{ t('ui.vier_augen_prinzip_fuer_zahlungsfreigaben_verpflichtend_machen') }}</span></label>
<p>{{ t('ui.ausgeschaltet_personen_mit_freigaberecht_insbesondere_der_kassenw') }}</p>
<p>{{ t('ui.erstattungen_an_das_eigene_verknuepfte_mitglied_benoetigen_in_bei') }}</p>
<label class="form-label" for="policy-reason">{{ t('ui.begruendung_der_aenderung') }}</label><input class="form-control mb-3" id="policy-reason" name="reason" maxlength="500" required><button class="btn btn-primary">{{ t('common.save') }}</button>
</form>
{% for row in history %}<p class="mt-3">{{ row.at|date('d.m.Y H:i') }} · {{ row.actor }} · {{ row.reason }}</p>{% endfor %}
{% endblock %}
