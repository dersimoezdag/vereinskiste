{% extends 'layout.twig' %}
{% block title %}Belegpostfach{% endblock %}
{% block content %}
{% include 'components/settings_tabs.twig' %}
<h1>Belegpostfach</h1>
<p>Ein separates Postfach oder einen eigenen Ordner verwenden, etwa für belege@verein.de. Nachrichten bleiben auf dem Mailserver erhalten. Es werden höchstens fünf neue Nachrichten je Abruf übernommen.</p>
<div class="alert {{ imap_available and processing_available ? 'alert-info' : 'alert-warning' }}">
    IMAP: {{ imap_available ? 'vorhanden' : 'PHP-IMAP-Erweiterung fehlt' }} · Lokale Verarbeitung: {{ processing_available ? 'Programme vorhanden; erfolgreiche Prüfung je Beleg erforderlich' : 'Scanner, OCR oder Sandbox fehlen' }}
</div>
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
<form class="card card-body" method="post" action="/settings/receipt-mailbox">{{ csrf_field() }}<input type="hidden" name="version" value="{{ version }}">
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="enabled" value="1"{% if input.enabled %} checked{% endif %}><span class="form-check-label">Postfach automatisch abrufen</span></label>
{% for field,label in {'host':'IMAP-Server (TLS, Port 993)','username':'Benutzername','folder':'Ordner'} %}<label class="form-label" for="intake-{{ field }}">{{ label }}</label><input class="form-control mb-3" id="intake-{{ field }}" name="{{ field }}" value="{{ input[field] }}" maxlength="{{ field=='host'?253:254 }}" required autocomplete="off">{% endfor %}
<label class="form-label" for="intake-password">Passwort / App-Passwort</label><input class="form-control mb-2" id="intake-password" name="password" type="password" autocomplete="new-password" maxlength="1000"><p class="text-muted">{{ has_password ? 'Passwort gespeichert. Leer lassen, um es beizubehalten.' : 'Noch kein Passwort gespeichert.' }}</p>
<label class="form-check mb-3"><input class="form-check-input" type="checkbox" name="clear_password" value="1"><span class="form-check-label">Gespeichertes Passwort entfernen</span></label>
<label class="form-label" for="intake-actor">Benutzer für die technische Beleganlage</label><select class="form-select mb-3" name="actor_id" id="intake-actor"><option value="">Bitte wählen</option>{% for u in users %}<option value="{{ u.id }}"{% if input.actor_id==u.id %} selected{% endif %}>{{ u.name }}</option>{% endfor %}</select>
<p class="text-muted">Dieser Benutzer benötigt Schreibrechte für Rechnungen. Die Freigaberegel lässt sich unter Einstellungen → Zahlungsfreigabe festlegen. Die E-Mail-Adresse allein bestätigt weder das Mitglied noch dessen Bankverbindung.</p>
<button class="btn btn-primary">Speichern</button>
</form>
{% endblock %}
