<dialog class="modal modal-lg" id="membership-modal" aria-labelledby="membership-modal-title">
            <div class="modal-header">
                <h2 class="modal-title h3" id="membership-modal-title">{{ t('members.period.title') }}</h2>
                <button type="button" class="btn-close" data-dialog-close aria-label="{{ t('foundation.history.close') }}"></button>
            </div>
            <div class="modal-body">
                    {% if errors.date %}
                    <div class="alert alert-danger mb-4">{{ t(errors.date) }}</div>
                    {% endif %}

                    {% include 'members/membership_summary.twig' %}
                    {% if member.current %}
                        {% if (can('members.write') and not member.anonymized_at) %}
                        <form method="post" action="/members/{{ member.id }}/leave" class="border border-line rounded-lg p-4 bg-subtle mb-4">
                            {{ csrf_field() }}
                            <h4 class="h5 mb-2">{{ t('members.period.leave') }}</h4>
                            <div class="mb-2">
                                <label for="leave-date" class="label">{{ t('members.period.end') }}</label>
                                <input type="date" id="leave-date" name="date" value="{{ period_input.date|default(today) }}" class="input input-sm" required>
                            </div>
                            <div class="mb-4">
                                <label for="leave-reason" class="label">{{ t('members.period.end_reason') }}</label>
                                <input type="text" id="leave-reason" name="end_reason" value="{{ period_input.end_reason|default('') }}" class="input input-sm" maxlength="500">
                            </div>
                            <button type="submit" class="btn btn-sm btn-danger-soft w-full">{{ t('members.period.leave') }} {{ t('ui.erfassen') }}</button>
                        </form>
                        {% endif %}
                    {% else %}
                        {% if (can('members.write') and not member.anonymized_at) %}
                        <form method="post" action="/members/{{ member.id }}/join" class="border border-line rounded-lg p-4 bg-subtle mb-4">
                            {{ csrf_field() }}
                            <h4 class="h5 mb-2">{{ t('members.period.join') }}</h4>
                            <div class="mb-4">
                                <label for="join-date" class="label">{{ t('members.period.start') }}</label>
                                <input type="date" id="join-date" name="date" value="{{ period_input.date|default(today) }}" class="input input-sm" required>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary w-full">{{ t('members.period.join') }} {{ t('ui.erfassen') }}</button>
                        </form>
                        {% endif %}
                    {% endif %}

            </div>
</dialog>
