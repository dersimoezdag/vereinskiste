{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="mx-auto w-full max-w-7xl">
    <div class="page-header print:hidden mb-4">
        <h1 class="page-title">{{ t('members.new') }}</h1>
    </div>

    <div class="grid-12 gap-x-6 justify-center">
        <div class="lg:col-span-8 col-span-12">
            <div class="panel">
                <div class="panel-header">
                    <h3 class="panel-title">{{ t('members.new') }}</h3>
                </div>
                <div class="panel-body">
                    <form method="post" action="/members/new" novalidate>
                        {{ csrf_field() }}
                        <input type="hidden" name="version" value="{{ input.version|default(0) }}">

                        {% include 'members/_name_fields.twig' with {id_prefix: 'member', values: input, errors: errors} %}

                        <div class="grid-12 gap-4 mb-4">
                            <div class="md:col-span-6 col-span-12">
                                <label for="member-email" class="label">{{ t('members.field.email') }}</label>
                                <input type="email" id="member-email" name="email" value="{{ input.email|default('') }}"
                                       class="input{% if errors.email %} is-invalid{% endif %}" maxlength="254">
                                {% if errors.email %}
                                <div class="field-error">{{ t(errors.email) }}</div>
                                {% endif %}
                            </div>
                            <div class="md:col-span-6 col-span-12">
                                <label for="member-phone" class="label">{{ t('members.field.phone') }}</label>
                                <input type="tel" id="member-phone" name="phone" value="{{ input.phone|default('') }}"
                                       class="input{% if errors.phone %} is-invalid{% endif %}" maxlength="50">
                                {% if errors.phone %}
                                <div class="field-error">{{ t(errors.phone) }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="grid-12 gap-4 mb-4">
                            <div class="md:col-span-9 col-span-12">
                                <label for="member-address" class="label">{{ t('members.field.address') }}</label>
                                <input type="text" id="member-address" name="address" value="{{ input.address|default('') }}"
                                       class="input{% if errors.address %} is-invalid{% endif %}" maxlength="200" autocomplete="address-line1">
                                {% if errors.address %}<div class="field-error">{{ t(errors.address) }}</div>{% endif %}
                            </div>
                            <div class="md:col-span-3 col-span-12">
                                <label for="member-house-number" class="label">{{ t('members.field.house_number') }}</label>
                                <input type="text" id="member-house-number" name="house_number" value="{{ input.house_number|default('') }}"
                                       class="input{% if errors.house_number %} is-invalid{% endif %}" maxlength="20">
                                {% if errors.house_number %}<div class="field-error">{{ t(errors.house_number) }}</div>{% endif %}
                            </div>
                        </div>

                        <div class="grid-12 gap-4 mb-4">
                            <div class="md:col-span-4 col-span-12">
                                <label for="member-zip" class="label">{{ t('members.field.zip') }}</label>
                                <input type="text" id="member-zip" name="zip" value="{{ input.zip|default('') }}"
                                       class="input{% if errors.zip %} is-invalid{% endif %}" maxlength="20">
                                {% if errors.zip %}
                                <div class="field-error">{{ t(errors.zip) }}</div>
                                {% endif %}
                            </div>
                            <div class="md:col-span-5 col-span-12">
                                <label for="member-city" class="label">{{ t('members.field.city') }}</label>
                                <input type="text" id="member-city" name="city" value="{{ input.city|default('') }}"
                                       class="input{% if errors.city %} is-invalid{% endif %}" maxlength="100">
                                {% if errors.city %}
                                <div class="field-error">{{ t(errors.city) }}</div>
                                {% endif %}
                            </div>
                            <div class="md:col-span-3 col-span-12">
                                <label for="member-country" class="label">{{ t('members.field.country') }}</label>
                                <input type="text" id="member-country" name="country" value="{{ input.country|default('Deutschland') }}"
                                       class="input{% if errors.country %} is-invalid{% endif %}" maxlength="100">
                                {% if errors.country %}
                                <div class="field-error">{{ t(errors.country) }}</div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="member-birth-date" class="label">{{ t('members.field.birth_date') }}</label>
                            <input type="date" id="member-birth-date" name="birth_date" value="{{ input.birth_date|default('') }}"
                                   class="input{% if errors.birth_date %} is-invalid{% endif %}">
                            {% if errors.birth_date %}
                            <div class="field-error">{{ t(errors.birth_date) }}</div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            <label for="member-notes" class="label">{{ t('members.field.notes') }}</label>
                            <textarea id="member-notes" name="notes" rows="3"
                                      class="input{% if errors.notes %} is-invalid{% endif %}" maxlength="1000">{{ input.notes|default('') }}</textarea>
                            {% if errors.notes %}
                            <div class="field-error">{{ t(errors.notes) }}</div>
                            {% endif %}
                        </div>

                        <div class="flex justify-between pt-4 border-t border-line">
                            <a href="/members" class="btn">{{ t('common.cancel') }}</a>
                            <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
