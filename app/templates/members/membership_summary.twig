<p class="{{ member.current ? 'text-success font-semibold' : 'text-muted' }} mb-4">
    {{ t(member.current ? 'ui.das_mitglied_hat_eine_aktive_mitgliedschaft' : 'ui.aktuell_keine_laufende_mitgliedschaft') }}
</p>
                    <!-- Liste bisheriger Mitgliedszeiträume -->
                    {% if member.periods is not empty %}
                    <div class="mt-4">
                        <div class="text-muted text-sm font-semibold mb-2">{{ t('ui.zeitraeume') }}</div>
                        <ul class="list list-flush text-sm">
                            {% for p in member.periods %}
                            <li class="list-item px-0 py-2 flex justify-between items-center">
                                <div>
                                    <span class="font-semibold">{{ p.start_date|date('d.m.Y') }}</span> {{ t('ui.bis') }}
                                    {% if p.end_date %}
                                        <span class="font-semibold">{{ p.end_date|date('d.m.Y') }}</span>
                                        {% if p.end_reason %}<div class="text-muted italic">{{ t('ui.grund') }} {{ p.end_reason }}</div>{% endif %}
                                    {% else %}
                                        <span class="badge bg-success-soft text-success">{{ t('ui.heute_offen') }}</span>
                                    {% endif %}
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
