<p class="{{ member.current ? 'text-success fw-semibold' : 'text-muted' }} mb-3">
    {{ t(member.current ? 'ui.das_mitglied_hat_eine_aktive_mitgliedschaft' : 'ui.aktuell_keine_laufende_mitgliedschaft') }}
</p>
                    <!-- Liste bisheriger Mitgliedszeiträume -->
                    {% if member.periods is not empty %}
                    <div class="mt-3">
                        <div class="text-muted small fw-bold mb-2">{{ t('ui.zeitraeume') }}</div>
                        <ul class="list-group list-group-flush small">
                            {% for p in member.periods %}
                            <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">{{ p.start_date|date('d.m.Y') }}</span> {{ t('ui.bis') }}
                                    {% if p.end_date %}
                                        <span class="fw-semibold">{{ p.end_date|date('d.m.Y') }}</span>
                                        {% if p.end_reason %}<div class="text-muted fst-italic">{{ t('ui.grund') }} {{ p.end_reason }}</div>{% endif %}
                                    {% else %}
                                        <span class="badge bg-success-subtle text-success">{{ t('ui.heute_offen') }}</span>
                                    {% endif %}
                                </div>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
