{% extends 'layout.twig' %}
{% block content %}
<h1>{{ t('applications.decision.title') }} · {{ application.applicant_name }}</h1>
<p>{{ application.email }}</p>
<p><a class="btn" href="/members/applications/{{ application.id }}/pdf">{{ t('applications.pdf') }}</a></p>
{% if signatures is not empty %}
<section class="panel panel-body mb-4" aria-labelledby="declarations-heading">
    <h2 id="declarations-heading" class="panel-title">{{ t('declarations.title') }}</h2>
    <ul class="divide-y divide-line">
    {% for s in signatures %}
        <li class="py-3">
            <div class="flex flex-wrap items-center gap-3">
                <strong class="min-w-0 flex-1">{{ s.snapshot.title|default('') }}</strong>
                <span class="text-sm text-muted">{{ t('declarations.field.version') }} {{ s.version }}</span>
                <span>{% if s.kind == 'consent' %}{{ t(s.granted ? 'declarations.consent_yes' : 'declarations.consent_no') }}{% elseif s.kind == 'confirmation' %}{{ t('declarations.confirmed') }}{% else %}{{ t('declarations.noticed') }}{% endif %}</span>
            </div>
            {% if s.has_signature %}
            <div class="mt-2 flex flex-wrap items-end gap-4">
                <img class="h-16 w-auto rounded border border-line bg-white" src="/members/applications/{{ application.id }}/signatures/{{ s.id }}.png" alt="{{ t('declarations.signature') }}">
                <span class="text-sm text-muted">{{ t('declarations.place_date') }}: {{ s.signed_place }}, {{ s.signed_at|date('d.m.Y') }}</span>
            </div>
            {% endif %}
            <details class="mt-2"><summary class="text-sm">{{ t('privacy.snapshot') }}</summary><div class="rich-text text-sm">{{ s.snapshot.content|default('')|note }}</div><code class="text-xs">{{ s.snapshot_hash }}</code></details>
        </li>
    {% endfor %}
    </ul>
</section>
{% endif %}
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
{% if not system_mail_available() %}<p class="alert alert-warning">{{ t('applications.mail.disabled') }}</p>{% endif %}
{% if application.status == 'pending' %}
<form action="/members/applications/{{ application.id }}/decision" method="post" class="panel panel-body">
{{ csrf_field() }}
{% if preview %}
<h2>{{ t('applications.decision.preview') }}</h2><p>{{ t('applications.status.' ~ input.decision) }}</p><h3>{{ input.subject }}</h3><pre class="text-wrap">{{ input.message }}</pre><p>{{ input.reason }}</p>
{% for key in ['decision','subject','message','reason'] %}<input type="hidden" name="{{ key }}" value="{{ input[key] }}">{% endfor %}
<button class="btn btn-primary mb-2" name="stage" value="confirm">{{ t('applications.decision.confirm') }}</button><button class="btn" name="stage" value="edit">{{ t('applications.decision.edit') }}</button>
{% else %}
<label class="label" for="decision">{{ t('applications.decision.title') }}</label><select id="decision" class="input mb-4" name="decision"><option value="approved"{% if input.decision=='approved' %} selected{% endif %}>{{ t('applications.approve') }}</option><option value="rejected"{% if input.decision=='rejected' %} selected{% endif %}>{{ t('applications.reject') }}</option></select>
<label class="label" for="decision-subject">{{ t('applications.mail.subject') }}</label><input class="input mb-4" id="decision-subject" name="subject" value="{{ input.subject }}" maxlength="200" required>
<label class="label" for="decision-message">{{ t('applications.mail.message') }}</label><textarea class="input mb-4" id="decision-message" name="message" rows="8" maxlength="10000" required>{{ input.message }}</textarea>
<label class="label" for="decision-reason">{{ t('applications.reject_reason') }}</label><input class="input mb-4" id="decision-reason" name="reason" value="{{ input.reason }}" maxlength="500">
<button class="btn btn-primary" name="stage" value="preview">{{ t('applications.decision.preview') }}</button>
{% endif %}
</form>{% endif %}
<a class="btn mt-4" href="/members/applications">{{ t('common.back') }}</a>
{% endblock %}
