{% extends 'layout.twig' %}
{% block title %}{{ t('applications.title') }}{% endblock %}
{% block content %}
<div class="mx-auto w-full max-w-7xl">
    <h1 class="page-title mb-4">{{ t('applications.title') }}</h1>
    <nav class="tabs" aria-label="{{ t('applications.title') }}">
        <a class="tab{% if tab == 'applications' %} active{% endif %}" href="/members/applications?filter={{ filter|url_encode }}"{% if tab == 'applications' %} aria-current="page"{% endif %}>{{ t('applications.tabs.applications') }}</a>
        <a class="tab{% if tab == 'messages' %} active{% endif %}" href="/members/applications?tab=messages&amp;filter={{ filter|url_encode }}"{% if tab == 'messages' %} aria-current="page"{% endif %}>{{ t('applications.tabs.messages') }}</a>
    </nav>
    {% if tab == 'applications' %}
        {% include 'members/_applications_table.twig' %}
    {% else %}
        {% include 'members/_application_messages.twig' %}
    {% endif %}
</div>
{% endblock %}
