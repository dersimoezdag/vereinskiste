<div class="panel">
    <div class="panel-header flex flex-wrap items-center justify-between gap-3">
        <span class="text-sm text-muted">{{ applications|length }} {{ t('applications.tabs.applications') }}</span>
        <nav class="flex flex-wrap gap-1" aria-label="{{ t('privacy.field.status') }}">
            {% for value, label in {'pending': 'applications.status.pending', 'all': 'invoices.status.all', 'approved': 'applications.status.approved', 'rejected': 'applications.status.rejected'} %}
            <a href="/members/applications?filter={{ value }}" class="btn btn-sm{% if filter == value %} btn-primary{% endif %}"{% if filter == value %} aria-current="page"{% endif %}>{{ t(label) }}</a>
            {% endfor %}
        </nav>
    </div>
    <div class="table-scroll">
        <table class="data-table table-cards mb-0">
            <thead><tr>
                <th>{{ t('members.field.name') }}</th>
                <th>{{ t('applications.received_at') }}</th>
                <th>{{ t('privacy.field.status') }}</th>
                <th class="text-right">{{ t('audit.action') }}</th>
            </tr></thead>
            <tbody>
            {% for a in applications %}
                <tr>
                    <td data-label="{{ t('members.field.name') }}">
                        <div class="min-w-0">
                            <div class="font-semibold">{{ a.applicant_name }}</div>
                            <div class="text-sm text-muted break-all">{{ a.email }}</div>
                            {% include 'members/_application_details.twig' %}
                        </div>
                    </td>
                    <td data-label="{{ t('applications.received_at') }}" class="whitespace-nowrap">
                        <div>
                            <div>{{ a.created_at|date('d.m.Y') }}</div>
                            <div class="text-sm text-muted">{{ a.created_at|date('H:i') }} · #{{ a.id }}</div>
                        </div>
                    </td>
                    <td data-label="{{ t('privacy.field.status') }}">
                        <div>
                            {% set tone = a.status == 'pending' ? 'bg-warning-soft text-warning' : (a.status == 'approved' ? 'bg-success-soft text-success' : 'bg-danger-soft text-danger') %}
                            <span class="badge {{ tone }}">{{ t('applications.status.' ~ a.status) }}</span>
                            {% if a.reviewer_name %}<div class="text-sm text-muted mt-1">{{ t('ui.geprueft_von') }} {{ a.reviewer_name }}</div>{% endif %}
                        </div>
                    </td>
                    <td data-label="{{ t('audit.action') }}">
                        <div class="flex flex-wrap justify-end gap-2">
                            {% if a.status == 'pending' and can('members.write') %}
                            <a class="btn btn-sm btn-primary" href="/members/applications/{{ a.id }}/decision">{{ t('applications.review') }}</a>
                            {% elseif a.status == 'approved' and a.member_id %}
                            <a class="btn btn-sm" href="/members/{{ a.member_id }}">{{ t('applications.open_member') }}</a>
                            {% endif %}
                            {% if a.status == 'rejected' and can('settings.manage') %}
                            <a class="btn btn-sm" href="/members/applications/{{ a.id }}/privacy">{{ t('privacy.title') }}</a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-center text-muted py-12">{{ t('applications.none') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
