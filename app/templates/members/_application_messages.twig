{% if not system_mail_available() %}<p class="alert alert-warning mb-4">{{ t('applications.mail.disabled') }}</p>{% endif %}
{% embed 'components/data_grid.twig' with {rows: outbox, columns: [
{key: 'kind', label: t('applications.message_type'), sort_values: {
    submitted: t('applications.message_kind.submitted'), approved: t('applications.message_kind.approved'),
    rejected: t('applications.message_kind.rejected'), internal: t('applications.message_kind.internal')
}},
{key: 'recipient', label: t('applications.recipient')},
{key: 'status', label: t('privacy.field.status'), type: 'badge', values: {
pending: {label: t('applications.outbox.pending'), tone: 'bg-subtle text-muted'},
sending: {label: t('applications.outbox.sending'), tone: 'bg-info-soft text-info'},
sent: {label: t('applications.outbox.sent'), tone: 'bg-success-soft text-success'},
failed: {label: t('applications.outbox.failed'), tone: 'bg-danger-soft text-danger'},
uncertain: {label: t('applications.outbox.uncertain'), tone: 'bg-warning-soft text-warning'},
cancelled: {label: t('applications.outbox.cancelled'), tone: 'bg-subtle text-muted'}
}},
{key: 'created_at', label: t('applications.created_at'), type: 'date'},
{key: 'actions', label: t('audit.action'), actions: true}
], label: t('applications.tabs.messages'), empty_text: t('applications.messages_empty')} %}
{% block filters %}
<details class="text-sm text-muted"><summary class="cursor-pointer">{{ t('applications.outbox') }}</summary><p class="mt-2 max-w-xl">{{ t('applications.outbox.explanation') }}</p></details>
{% endblock %}
{% block cell %}
{% set mail = row %}
{% if column.key == 'kind' %}
<div class="min-w-0">
<div class="font-semibold">{{ t('applications.message_kind.' ~ mail.kind) }}</div>
<div class="text-sm text-muted">{{ t('applications.document_title') }} #{{ mail.application_id }}</div>
<details class="text-sm mt-2">
<summary class="cursor-pointer text-primary">{{ t('audit.detail') }}</summary>
<dl class="mt-2 space-y-2 text-muted">
<div><dt class="font-medium">{{ t('applications.mail.subject') }}</dt><dd class="break-words">{{ mail.subject }}</dd></div>
{% if mail.sent_at %}<div><dt class="font-medium">{{ t('applications.sent_at') }}</dt><dd>{{ mail.sent_at|date('d.m.Y H:i') }}</dd></div>{% endif %}
</dl>
</details>
</div>
{% elseif column.key == 'status' %}
{{ parent() }}
{% elseif column.key == 'actions' %}
{% if mail.status in ['failed','uncertain'] and can('members.write') %}
<form method="post" action="/members/application-mails/{{ mail.id }}/retry">
{{ csrf_field() }}
<input type="hidden" name="version" value="{{ mail.version }}">
<button class="btn btn-sm whitespace-normal">{{ t('applications.outbox.retry') }}</button>
</form>
{% endif %}
{% else %}
{{ parent() }}
{% endif %}
{% endblock %}
{% endembed %}
