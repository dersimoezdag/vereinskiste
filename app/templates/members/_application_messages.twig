{% if not system_mail_available() %}<p class="alert alert-warning mb-4">{{ t('applications.mail.disabled') }}</p>{% endif %}
<div class="panel">
    <div class="panel-header"><p class="text-sm text-muted mb-0">{{ t('applications.outbox.explanation') }}</p></div>
    <div class="table-scroll">
        <table class="data-table table-cards mb-0">
            <thead><tr>
                <th>{{ t('applications.message_type') }}</th>
                <th>{{ t('applications.recipient') }}</th>
                <th>{{ t('privacy.field.status') }}</th>
                <th>{{ t('applications.created_at') }}</th>
                <th class="text-right">{{ t('audit.action') }}</th>
            </tr></thead>
            <tbody>
            {% for mail in outbox %}
                <tr>
                    <td data-label="{{ t('applications.message_type') }}">
                        <div class="min-w-0">
                        <div class="font-semibold">{{ t('applications.message_kind.' ~ mail.kind) }}</div>
                        <div class="text-sm text-muted">{{ t('applications.document_title') }} #{{ mail.application_id }}</div>
                        <details class="text-sm mt-2">
                            <summary class="cursor-pointer text-primary">{{ t('audit.detail') }}</summary>
                            <dl class="mt-2 space-y-2 text-muted">
                                <div><dt class="font-medium">{{ t('applications.mail.subject') }}</dt><dd class="break-words">{{ mail.subject }}</dd></div>
                                {% if mail.sent_at %}<div><dt class="font-medium">{{ t('applications.sent_at') }}</dt><dd>{{ mail.sent_at|date('d.m.Y H:i') }}</dd></div>{% endif %}
                            </dl>
                        </details>
                        </div>
                    </td>
                    <td data-label="{{ t('applications.recipient') }}" class="break-all">{{ mail.recipient }}</td>
                    <td data-label="{{ t('privacy.field.status') }}">
                        {% set tone = mail.status == 'sent' ? 'bg-success-soft text-success' : (mail.status in ['failed', 'uncertain'] ? 'bg-danger-soft text-danger' : 'bg-subtle text-muted') %}
                        <span class="badge {{ tone }}">{{ t('applications.outbox.' ~ mail.status) }}</span>
                    </td>
                    <td data-label="{{ t('applications.created_at') }}" class="whitespace-nowrap"><div>{{ mail.created_at|date('d.m.Y') }}<div class="text-sm text-muted">{{ mail.created_at|date('H:i') }}</div></div></td>
                    <td data-label="{{ t('audit.action') }}" class="text-right">
                        {% if mail.status in ['failed','uncertain'] and can('members.write') %}
                        <form method="post" action="/members/application-mails/{{ mail.id }}/retry">
                            {{ csrf_field() }}
                            <input type="hidden" name="version" value="{{ mail.version }}">
                            <button class="btn btn-sm whitespace-normal">{{ t('applications.outbox.retry') }}</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted py-12">{{ t('applications.messages_empty') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
