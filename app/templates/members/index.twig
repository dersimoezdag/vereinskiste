{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="mx-auto w-full max-w-7xl">
    <div class="page-header print:hidden mb-4">
        <div class="flex flex-wrap items-center gap-4">
            <div class="min-w-0 flex-1">
                <h1 class="page-title">{{ t('members.title') }}</h1>
            </div>
            <div class="shrink-0 flex flex-wrap gap-2 print:hidden">
                <a href="/members.csv?state={{ state|url_encode }}&amp;q={{ search|url_encode }}" class="btn">{{ t('members.export.csv') }}</a>
            </div>
            {% if can('members.write') %}
            <div class="shrink-0 flex flex-wrap gap-2 ms-auto print:hidden">
                <a href="/members/new" class="btn btn-primary">
                    {{ t('members.new') }}
                </a>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Filter und Suche -->
    <div class="panel mb-4">
        <div class="panel-body">
            <form method="get" action="/members" class="grid-12 gap-2 items-center">
                {% if per_page %}<input type="hidden" name="per_page" value="{{ per_page }}">{% endif %}
                <input type="hidden" name="state" value="{{ state }}">
                <div class="md:col-span-6 col-span-12">
                    <div class="input-group">
                        <input type="text" name="q" value="{{ search }}" class="input"
                               placeholder="{{ t('members.search') }}" aria-label="{{ t('members.search') }}">
                        <button type="submit" class="btn">{{ t('common.search') }}</button>
                    </div>
                </div>
                <div class="md:col-span-6 col-span-12 flex gap-2 md:justify-end">
                    <a href="/members?state=current{% if search %}&q={{ search|url_encode }}{% endif %}"
                       class="btn btn-sm {% if state == 'current' %}btn-primary{% else %}{% endif %}">
                        {{ t('members.state.current') }}
                    </a>
                    <a href="/members?state=left{% if search %}&q={{ search|url_encode }}{% endif %}"
                       class="btn btn-sm {% if state == 'left' %}btn-primary{% else %}{% endif %}">
                        {{ t('members.state.left') }}
                    </a>
                    <a href="/members?state=all{% if search %}&q={{ search|url_encode }}{% endif %}"
                       class="btn btn-sm {% if state == 'all' %}btn-primary{% else %}{% endif %}">
                        {{ t('members.state.all') }}
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Mitglieder-Tabelle -->
    <div class="panel">
        <div class="table-scroll">
            <table class="data-table table-cards mb-0">
                <thead>
                    <tr>
                        <th class="w-px whitespace-nowrap">{{ t('members.no') }}</th>
                        <th>{{ t('members.field.name') }}</th>
                        <th>{{ t('members.field.email') }}</th>
                        <th>{{ t('privacy.field.status') }}</th>
                        <th class="w-px whitespace-nowrap text-center" title="{{ t('members.user.title') }}">{{ icons.icon('users') }}</th>
                        <th class="w-px whitespace-nowrap text-right">{{ t('audit.action') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% if members is empty %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-6">
                            {{ t('ui.keine_mitglieder_gefunden') }}
                        </td>
                    </tr>
                {% else %}
                    {% for m in members %}
                    <tr>
                        <td data-label="{{ t('members.no') }}" class="text-muted font-mono">
                            #{{ m.member_no }}
                        </td>
                        <td data-label="{{ t('members.field.name') }}">
                            <a href="/members/{{ m.id }}" class="font-semibold text-inherit">
                                {{ m.name }}
                            </a>
                        </td>
                        <td data-label="{{ t('members.field.email') }}" class="text-muted">
                            {{ m.data.email ?: '–' }}
                        </td>
                        <td data-label="Status">
                            {% if m.current %}
                                <span class="badge bg-success-soft text-success border border-success/30">{{ t('bookings.status.active') }}</span>
                            {% else %}
                                <span class="badge bg-subtle text-muted border border-line ">{{ t('ui.ausgetreten') }}</span>
                            {% endif %}
                        </td>
                        <td data-label="Benutzerzugang" class="text-center">
                            {% if m.user_id %}
                                <span class="text-primary" title="{{ t('ui.benutzerzugang_vorhanden') }}">{{ icons.icon('users') }}</span>
                            {% else %}
                                <span class="text-muted opacity-25">–</span>
                            {% endif %}
                        </td>
                        <td data-label="Aktion" class="text-right">
                            <a href="/members/{{ m.id }}" class="btn btn-sm">
                                {{ t('audit.detail') }}
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>
    {% include 'components/pagination.twig' %}
</div>
{% endblock %}
