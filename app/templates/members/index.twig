{% extends 'layout.twig' %}
{% block title %}{{ t('members.title') }}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-7xl">
    <div class="page-header print:hidden mb-4">
        <div class="flex flex-wrap items-center gap-4">
            <div class="min-w-0 flex-1">
                <h1 class="page-title">{{ t('members.title') }}</h1>
            </div>
            <div class="shrink-0 flex flex-wrap gap-2 print:hidden">
                <a href="/members.csv?state={{ state|url_encode }}&amp;q={{ search|url_encode }}" class="btn">{{ t('members.export.csv') }}</a>
            </div>
            {% if can('members.write') %}
            <div class="shrink-0 flex flex-wrap gap-2 ms-auto print:hidden">
                <a href="/members/new" class="btn btn-primary">
                    {{ t('members.new') }}
                </a>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Filter und Suche -->
    <div class="panel mb-4">
        <div class="panel-body">
            <form method="get" action="/members" class="grid-12 gap-2 items-center">
                {% if per_page %}<input type="hidden" name="per_page" value="{{ per_page }}">{% endif %}
                <input type="hidden" name="state" value="{{ state }}">
                <div class="md:col-span-6 col-span-12">
                    <div class="input-group">
                        <input type="text" name="q" value="{{ search }}" class="input"
                               placeholder="{{ t('members.search') }}" aria-label="{{ t('members.search') }}">
                        <button type="submit" class="btn">{{ t('common.search') }}</button>
                    </div>
                </div>
                <div class="md:col-span-6 col-span-12 flex gap-2 md:justify-end">
                    <a href="/members?state=current{% if search %}&q={{ search|url_encode }}{% endif %}"
                       class="btn btn-sm {% if state == 'current' %}btn-primary{% else %}{% endif %}">
                        {{ t('members.state.current') }}
                    </a>
                    <a href="/members?state=left{% if search %}&q={{ search|url_encode }}{% endif %}"
                       class="btn btn-sm {% if state == 'left' %}btn-primary{% else %}{% endif %}">
                        {{ t('members.state.left') }}
                    </a>
                    <a href="/members?state=all{% if search %}&q={{ search|url_encode }}{% endif %}"
                       class="btn btn-sm {% if state == 'all' %}btn-primary{% else %}{% endif %}">
                        {{ t('members.state.all') }}
                    </a>
                </div>
            </form>
        </div>
    </div>

    {% include 'members/_list_table.twig' %}
    {% include 'components/pagination.twig' %}
</div>
{% endblock %}
