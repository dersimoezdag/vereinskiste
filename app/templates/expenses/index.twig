{% extends 'layout.twig' %}
{% block title %}{{ t('expenses.title') }}{% endblock %}
{% block content %}
<div class="flex flex-wrap justify-between items-center gap-2 mb-4">
    <h1 class="mb-0">{{ t('expenses.title') }}</h1>
    {% if can('bookings.write') %}<a class="btn btn-primary" href="/expenses/new">{{ t('expenses.new') }}</a>{% endif %}
</div>
<p><strong>{{ t('expenses.open_total') }}: {{ open.total|eur }}</strong> ({{ open.count }})</p>
<nav class="tabs mb-4" aria-label="{{ t('expenses.title') }}">
    {% for value in ['open', 'reimbursed', 'all'] %}<a class="tab{% if state == value %} active{% endif %}" href="/expenses?state={{ value }}">{{ t('expenses.filter.' ~ value) }}</a>{% endfor %}
</nav>
{% embed 'components/data_grid.twig' with {rows: expenses, server_paged: true, columns: [
{key: 'spent_on', label: t('foundation.field.spent_on'), type: 'date'},
{key: 'person', label: t('expenses.person')},
{key: 'purpose', label: t('foundation.field.purpose')},
{key: 'amount', label: t('bookings.amount_eur'), type: 'money'},
{key: 'has_receipt', label: t('foundation.field.has_receipt'), sort_values: {'1': t('users.roles.allowed'), '0': t('users.roles.denied')}},
{key: 'reimbursed', label: t('foundation.field.status'), sort_values: {'1': t('expenses.status.reimbursed'), '0': t('expenses.status.open')}}
], label: t('expenses.title'), empty_text: t('expenses.empty')} %}
{% block cell %}
{% if column.key == 'spent_on' %}{{ row.spent_on|date('d.m.Y') }}
{% elseif column.key == 'purpose' %}<a href="/expenses/{{ row.id }}">{{ row.purpose }}</a>
{% elseif column.key == 'has_receipt' %}{{ row.has_receipt ? t('users.roles.allowed') : t('users.roles.denied') }}
{% elseif column.key == 'reimbursed' %}{% include 'expenses/_badge.twig' with {expense: row} %}
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% endembed %}
{% include 'components/pagination.twig' %}
{% endblock %}
