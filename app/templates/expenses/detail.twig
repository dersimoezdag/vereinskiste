{% extends 'layout.twig' %}
{% block title %}{{ expense ? expense.purpose : t('expenses.new') }}{% endblock %}
{% block content %}
{% set writable = can('bookings.write') %}
<h1>{{ expense ? expense.purpose : t('expenses.new') }}</h1>
{% if expense %}<p>{% include 'expenses/_badge.twig' %}{% if expense.reimbursed %} {{ expense.reimbursed_on|date('d.m.Y') }} · <a href="/bookings/{{ expense.booking_id }}">{{ t('expenses.to_booking') }}</a>{% endif %}</p>{% endif %}
{% for key in ['delete', 'version', 'booking_id'] %}{% if errors[key] is defined %}<p class="alert alert-warning" role="alert">{{ t(errors[key]) }}</p>{% endif %}{% endfor %}

<form method="post" action="{{ expense ? '/expenses/' ~ expense.id : '/expenses/new' }}" enctype="multipart/form-data" class="panel panel-body mb-4">
    {{ csrf_field() }}
    <input type="hidden" name="version" value="{{ expense ? expense.version : 0 }}">
    <fieldset{% if not writable %} disabled{% endif %}>
    <div class="grid-12 gap-4 mb-4">
        <div class="col-span-12 md:col-span-6">
            {% include 'components/person_picker.twig' with {
                id: 'expense-member',
                name: 'member_id',
                label: t('events.task.member'),
                value: input.member_id|default(''),
                persons: members,
                disabled: not writable,
                is_invalid: errors.member_id is defined,
                error: errors.member_id|default(null)
            } %}
        </div>
        <div class="col-span-12 md:col-span-6"><label class="label" for="expense-person">{{ t('events.task.person') }}</label>
            <input class="input" id="expense-person" name="person_name" maxlength="200" value="{{ input.person_name|default('') }}"></div>
        <div class="col-span-12"><label class="label" for="expense-purpose">{{ t('foundation.field.purpose') }}</label>
            <input class="input{% if errors.purpose is defined %} is-invalid{% endif %}" id="expense-purpose" name="purpose" maxlength="200" required value="{{ input.purpose|default('') }}">
            {% if errors.purpose is defined %}<div class="field-error">{{ t(errors.purpose) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-4"><label class="label" for="expense-amount">{{ t('bookings.amount_eur') }}</label>
            <input class="input{% if errors.amount is defined %} is-invalid{% endif %}" id="expense-amount" name="amount" inputmode="decimal" required value="{{ input.amount|default('') }}">
            {% if errors.amount is defined %}<div class="field-error">{{ t(errors.amount) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-4"><label class="label" for="expense-date">{{ t('foundation.field.spent_on') }}</label>
            <input class="input{% if errors.spent_on is defined %} is-invalid{% endif %}" type="date" id="expense-date" name="spent_on" required value="{{ input.spent_on|default('') }}">
            {% if errors.spent_on is defined %}<div class="field-error">{{ t(errors.spent_on) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-4"><label class="label" for="expense-event">{{ t('events.single') }}</label>
            <select class="input" id="expense-event" name="event_id"><option value="">{{ t('events.none') }}</option>
            {% for event in events %}<option value="{{ event.id }}"{% if input.event_id|default('') ~ '' == event.id ~ '' %} selected{% endif %}>{{ event.title }} ({{ event.starts_on|date('d.m.Y') }})</option>{% endfor %}</select></div>
        <div class="col-span-12" id="expense-upload">
            {% include 'receipts/_dropzone.twig' with {id_prefix: 'expense-receipt', errors: errors} %}
        </div>
    </div>
    {% if writable %}<div><button class="btn btn-primary" type="submit">{{ t('foundation.save') }}</button></div>{% endif %}
    </fieldset>
</form>

{% if expense and documents %}
<section class="panel panel-body mb-4" aria-label="{{ t('expenses.documents') }}">
    <h2 class="panel-title">{{ t('expenses.documents') }}</h2>
    <ul>{% for document in documents %}<li>
        <a href="/documents/{{ document.file_id }}">{{ document.original_name }}</a>
        · {{ t(document.review_status == 'reviewed' ? 'expenses.document_reviewed' : 'expenses.document_pending') }}
        {% if writable and document.review_status == 'pending' %}
        <form method="post" action="/expenses/{{ expense.id }}/documents/{{ document.id }}/review" class="inline">
            {{ csrf_field() }}<button class="btn btn-soft" type="submit">{{ t('expenses.review_document') }}</button>
        </form>{% endif %}
    </li>{% endfor %}</ul>
</section>
{% endif %}

{% if expense and writable %}
{% if expense.reimbursed %}
<form method="post" action="/expenses/{{ expense.id }}/unlink" class="mb-4">{{ csrf_field() }}<button class="btn" type="submit">{{ t('expenses.unlink') }}</button></form>
{% else %}
<div class="panel mb-4"><div class="panel-body">
    <h2 class="panel-title">{{ t('expenses.reimburse') }}</h2>
    <p>{{ t('expenses.reimburse_hint') }}</p>
    <form method="post" action="/expenses/{{ expense.id }}/reimburse" class="grid-12 gap-2">
        {{ csrf_field() }}
        <div class="col-span-12 md:col-span-4"><label class="label" for="pay-account">{{ t('bookings.account') }}</label>
            <select class="input{% if errors.account_id is defined %} is-invalid{% endif %}" id="pay-account" name="account_id" required><option value="">{{ t('bookings.choose') }}</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.name }}</option>{% endfor %}</select>
            {% if errors.account_id is defined %}<div class="field-error">{{ t(errors.account_id) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-3"><label class="label" for="pay-date">{{ t('bookings.date') }}</label>
            <input class="input{% if errors.booking_date is defined %} is-invalid{% endif %}" type="date" id="pay-date" name="booking_date" required value="{{ today }}">
            {% if errors.booking_date is defined %}<div class="field-error">{{ t(errors.booking_date) }}</div>{% endif %}</div>
        <div class="col-span-12 md:col-span-3"><label class="label" for="pay-category">{{ t('bookings.category') }}</label>
            <select class="input" id="pay-category" name="category_id"><option value="">{{ t('bookings.no_category') }}</option>{% for category in categories %}<option value="{{ category.id }}">{{ category.name }}</option>{% endfor %}</select></div>
        <div class="col-span-12 md:col-span-2 flex items-end"><button class="btn btn-primary w-full" type="submit">{{ t('expenses.reimburse_action') }}</button></div>
    </form>
    {% if candidates %}
    <h3 class="mt-6">{{ t('expenses.link') }}</h3>
    <form method="post" action="/expenses/{{ expense.id }}/link" class="grid-12 gap-2">
        {{ csrf_field() }}
        <div class="col-span-12 md:col-span-10"><label class="label" for="link-booking">{{ t('expenses.link_label') }}</label>
            <select class="input" id="link-booking" name="booking_id" required><option value="">{{ t('bookings.choose') }}</option>{% for booking in candidates %}<option value="{{ booking.id }}">{{ booking.booking_date|date('d.m.Y') }} · {{ booking.description }}{% if booking.counterparty %} · {{ booking.counterparty }}{% endif %}</option>{% endfor %}</select></div>
        <div class="col-span-12 md:col-span-2 flex items-end"><button class="btn btn-soft w-full" type="submit">{{ t('expenses.link_action') }}</button></div>
    </form>
    {% endif %}
</div></div>
{% if not expense.booking_id %}<form method="post" action="/expenses/{{ expense.id }}/delete" class="mb-4">{{ csrf_field() }}<button class="btn btn-danger-soft" type="submit">{{ t('events.delete') }}</button></form>{% endif %}
{% endif %}
{% endif %}
<a class="btn btn-link" href="/expenses">{{ t('common.back') }}</a>
{% include 'components/foundation_history.twig' %}
{% endblock %}
