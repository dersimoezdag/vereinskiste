{% extends 'layout.twig' %}
{% import 'components/help.twig' as help %}
{% block title %}Kontoauszug hochladen{% endblock %}
{% block content %}
<h1>Kontoauszug hochladen</h1>
<p>CSV mit Kopfzeile, bis 10 MB und 10.000 Umsätzen. Im nächsten Schritt ordnen Sie die Spalten zu.
CAMT, MT940 und PDF-Umsatzimport folgen nach Prüfung geeigneter Bankbeispiele.</p>
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
{% if not accounts %}<p class="alert alert-info">Bitte zuerst ein aktives Bankkonto in der Kontenverwaltung anlegen lassen.</p>{% endif %}
<form method="post" action="/imports/bank/new" enctype="multipart/form-data" class="card card-body">
{{ csrf_field() }}
<label for="bank-account" class="form-label">Zielkonto {{ help.tip('Bereits importierte Buchungen werden anhand von Datum, Betrag und Verwendungszweck automatisch erkannt und als Dubletten markiert.') }}</label>
<select id="bank-account" name="account_id" class="form-select mb-3" required><option value="">Bitte auswählen</option>
{% for account in accounts %}<option value="{{ account.id }}">{{ account.name }}{% if account.iban %} · {{ account.iban }}{% endif %}</option>{% endfor %}</select>
<label for="bank-file" class="form-label">CSV-Datei</label><input id="bank-file" name="receipt" type="file" accept=".csv,text/csv" class="form-control mb-3" required>
<label for="bank-delimiter" class="form-label">Trennzeichen</label><select id="bank-delimiter" name="delimiter" class="form-select mb-3">
<option value="">Automatisch erkennen</option><option value=";">Semikolon</option><option value=",">Komma</option><option value="tab">Tabulator</option></select>
<label for="bank-encoding" class="form-label">Zeichenkodierung</label><select id="bank-encoding" name="encoding" class="form-select mb-3">
<option value="">Automatisch erkennen</option><option value="UTF-8">UTF-8</option><option value="Windows-1252">Windows-1252</option></select>
<button type="submit" class="btn btn-primary">Vorschau öffnen</button>
</form>
{% endblock %}
