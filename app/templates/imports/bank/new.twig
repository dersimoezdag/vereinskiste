{% extends 'layout.twig' %}
{% import 'components/help.twig' as help %}
{% block title %}{{ t('ui.kontoauszug_hochladen') }}{% endblock %}
{% block content %}
<h1>{{ t('ui.kontoauszug_hochladen') }}</h1>
<p>{{ t('ui.csv_mit_kopfzeile_bis_10_mb_und_10_000_umsaetzen_im_naechsten_sch') }}</p>
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
{% if not accounts %}<p class="alert alert-info">{{ t('ui.bitte_zuerst_ein_aktives_bankkonto_in_der_kontenverwaltung_anlege') }}</p>{% endif %}
<form method="post" action="/imports/bank/new" enctype="multipart/form-data" class="card card-body">
{{ csrf_field() }}
<label for="bank-account" class="form-label">{{ t('ui.zielkonto') }} {{ help.tip(t('ui.bereits_importierte_buchungen_werden_anhand_von_datum_betrag_und_')) }}</label>
<select id="bank-account" name="account_id" class="form-select mb-3" required><option value="">{{ t('ui.bitte_auswaehlen') }}</option>
{% for account in accounts %}<option value="{{ account.id }}">{{ account.name }}{% if account.iban %} · {{ account.iban }}{% endif %}</option>{% endfor %}</select>
<label for="bank-file" class="form-label">{{ t('ui.csv_datei') }}</label><input id="bank-file" name="receipt" type="file" accept=".csv,text/csv" class="form-control mb-3" required>
<label for="bank-delimiter" class="form-label">{{ t('ui.trennzeichen') }}</label><select id="bank-delimiter" name="delimiter" class="form-select mb-3">
<option value="">{{ t('ui.automatisch_erkennen') }}</option><option value=";">{{ t('ui.semikolon') }}</option><option value=",">{{ t('ui.komma') }}</option><option value="tab">{{ t('ui.tabulator') }}</option></select>
<label for="bank-encoding" class="form-label">{{ t('ui.zeichenkodierung') }}</label><select id="bank-encoding" name="encoding" class="form-select mb-3">
<option value="">{{ t('ui.automatisch_erkennen') }}</option><option value="UTF-8">{{ t('ui.utf_8') }}</option><option value="Windows-1252">{{ t('ui.windows_1252') }}</option></select>
<button type="submit" class="btn btn-primary">{{ t('ui.vorschau_oeffnen') }}</button>
</form>
{% endblock %}
