{% extends 'layout.twig' %}
{% block title %}{{ t('booking_import.title') }}{% endblock %}
{% block content %}
{% include 'components/finance_tabs.twig' %}
<h1>{{ t('booking_import.title') }}</h1>
<p>{{ t('booking_import.intro') }}</p>
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
{% if can('bookings.write') %}
<form method="post" action="/imports/bookings" enctype="multipart/form-data" class="panel panel-body mb-4">
    {{ csrf_field() }}
    <label class="label" for="import-account">{{ t('booking_import.account') }}</label>
    <select class="input" id="import-account" name="account_id" required><option value="">{{ t('bookings.choose') }}</option>
        {% for account in accounts %}<option value="{{ account.id }}">{{ account.name }}</option>{% endfor %}</select>
    <div class="field-hint mb-4">{{ t('booking_import.account_hint') }}</div>
    <label class="label" for="import-file">{{ t('booking_import.file') }}</label>
    <input class="input mb-4" type="file" id="import-file" name="receipt" accept=".xlsx,.csv" required>
    <div><button class="btn btn-primary" type="submit">{{ t('booking_import.upload') }}</button></div>
</form>
{% endif %}
<h2>{{ t('booking_import.history') }}</h2>
<p class="field-hint">{{ t('booking_import.draft_hint') }}</p>
{% embed 'components/data_grid.twig' with {rows: imports, server_paged: false, columns: [
{key: 'file_name', label: t('booking_import.file_name')},
{key: 'account_name', label: t('booking_import.account')},
{key: 'status', label: t('foundation.field.status')},
{key: 'created_count', label: t('booking_import.count')}
], label: t('booking_import.history'), empty_text: t('booking_import.empty')} %}
{% block cell %}
{% if column.key == 'file_name' %}<a href="/imports/bookings/{{ row.id }}">{{ row.file_name }}</a>
{% elseif column.key == 'status' %}{{ t('booking_import.status.' ~ row.status) }}
{% else %}{{ parent() }}{% endif %}
{% endblock %}
{% endembed %}
{% endblock %}
