{% import 'components/icons.twig' as icons %}
{% import 'components/nav.twig' as nav %}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('app.name') }}{% endblock %} – {{ t('app.name') }}</title>
    <link rel="icon" href="{{ asset('logo.svg') }}" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="{{ asset('logo-dark.svg') }}" type="image/svg+xml" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="{{ asset('app.css') }}">
    <meta name="color-scheme" content="light dark">
    <script src="{{ asset('theme.js') }}"></script>
</head>
<body>
<a class="skip-link" href="#main-content">{{ t('nav.skip') }}</a>
{% set user = current_user() %}
{% set path = current_path() %}
<div class="min-h-screen lg:flex">
    {% if user %}
    <aside class="sticky top-0 z-30 border-b border-line bg-surface lg:z-auto lg:flex lg:h-screen lg:w-64 lg:shrink-0 lg:flex-col lg:border-r lg:border-b-0" aria-label="{{ t('nav.main') }}">
        <div class="flex items-center justify-between gap-2 px-4 py-3 lg:px-5 lg:pt-5 lg:pb-4">
            <a href="/" class="flex items-center gap-2.5 text-ink no-underline hover:no-underline">
                {% include 'components/logo.twig' with {size: 32, class: 'size-8 shrink-0'} %}
                <span class="text-base font-semibold tracking-tight">{{ t('app.name') }}</span>
            </a>
            <button class="group btn btn-ghost btn-icon lg:hidden" type="button" data-nav-toggle aria-controls="sidebar-menu" aria-expanded="false" aria-label="{{ t('nav.toggle') }}">
                <svg viewBox="0 0 24 24" class="size-6 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                <svg viewBox="0 0 24 24" class="hidden size-6 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
        </div>
        <div class="sidebar-menu hidden flex-col gap-4 px-3 pb-3 [&.is-open]:flex lg:flex lg:min-h-0 lg:flex-1" id="sidebar-menu">
            <nav class="flex flex-col lg:min-h-0 lg:flex-1 lg:overflow-y-auto">
                <a class="nav-link{% if path == '/' or path starts with '/dashboard/preferences' %} active{% endif %}" href="/">{{ icons.icon('home') }}<span>{{ t('nav.home') }}</span></a>
                {% set documentsActive = path starts with '/documents' %}
                <details class="nav-group"{% if documentsActive %} open{% endif %}>
                    <summary class="nav-link">{{ icons.icon('audit') }}<span>{{ t('documents.title') }}</span><span class="nav-chevron">{{ icons.icon('chevron-up') }}</span></summary>
                    <div class="flex flex-col pb-1" id="documents-menu">
                        {% for kind in ['minutes','constitution','rules'] %}{{ nav.sub('/documents/' ~ kind, t('documents.kind.' ~ kind), path starts with '/documents/' ~ kind) }}{% endfor %}
                    </div>
                </details>
                {% if can('members.read') %}
                {% set membersActive = path starts with '/members' or path == '/settings/club-roles' %}
                {% set pendingApps = pending_applications_count() %}
                <details class="nav-group"{% if membersActive %} open{% endif %}>
                    <summary class="nav-link">{{ icons.icon('members') }}<span>{{ t('nav.members') }}</span>
                        {% if pendingApps > 0 %}<span class="badge bg-primary text-on-primary ms-auto" title="{{ pendingApps }} offene Anträge">{{ pendingApps }}</span>{% endif %}
                        <span class="nav-chevron{% if pendingApps > 0 %} ms-0{% endif %}">{{ icons.icon('chevron-up') }}</span></summary>
                    <div class="flex flex-col pb-1" id="members-menu">
                        {{ nav.sub('/members', t('members.list'), path == '/members' or (path starts with '/members/' and not (path starts with '/members/applications'))) }}
                        <a class="nav-sublink{% if path starts with '/members/applications' %} active{% endif %}" href="/members/applications"{% if path starts with '/members/applications' %} aria-current="page"{% endif %}>
                            <span>{{ t('applications.tab_applications') }}</span>
                            {% if pendingApps > 0 %}<span class="badge bg-primary-soft text-primary">{{ pendingApps }}</span>{% endif %}
                        </a>
                        {% if can('settings.manage') %}{{ nav.sub('/settings/club-roles', t('nav.club_roles'), path == '/settings/club-roles') }}{% endif %}
                    </div>
                </details>
                {% endif %}
                {% if can('bookings.read') %}
                {% set cashActive = path == '/cashbook' or path starts with '/expenses' or path starts with '/bookings' or path starts with '/accounts' or path starts with '/categories' or path starts with '/imports' or path starts with '/invoices' or path starts with '/contacts' or path == '/receipt-inbox'  or path starts with '/transfers' or path starts with '/corrections' %}
                <details class="nav-group"{% if cashActive %} open{% endif %}>
                    <summary class="nav-link">{{ icons.icon('bookings') }}<span>{{ t('nav.cashbook') }}</span><span class="nav-chevron">{{ icons.icon('chevron-up') }}</span></summary>
                    <div class="flex flex-col pb-1" id="cashbook-menu">
                        {{ nav.sub('/cashbook', t('cashbook.overview'), path == '/cashbook') }}
                        {{ nav.sub('/expenses', t('expenses.title'), path starts with '/expenses') }}
                        {{ nav.sub('/bookings', t('nav.bookings'), path starts with '/bookings' or path starts with '/transfers' or path starts with '/corrections' or path starts with '/imports') }}
                        {{ nav.sub('/accounts', t('finance.master_data'), path starts with '/accounts' or path starts with '/categories' or path starts with '/contacts') }}
                        {% if can('invoices.read') %}{{ nav.sub('/invoices', t('finance.documents'), path starts with '/invoices') }}{% endif %}
                    </div>
                </details>
                {% endif %}
                {% if can('events.read') %}
                <a class="nav-link{% if path starts with '/events' %} active{% endif %}" href="/events">{{ icons.icon('rocket') }}<span>{{ t('events.title') }}</span></a>
                {% endif %}
                {% if can('funding.read') %}
                <a class="nav-link{% if path starts with '/funding' %} active{% endif %}" href="/funding">{{ icons.icon('accounts') }}<span>{{ t('funding.title') }}</span></a>
                {% endif %}
                {% if can('reports.read') %}
                <a class="nav-link{% if path starts with '/reports' %} active{% endif %}" href="/reports/summary">{{ icons.icon('reports') }}<span>{{ t('nav.reports') }}</span></a>
                {% endif %}
            </nav>
            <div class="flex flex-col gap-2 border-t border-line pt-3">
                {% if can('settings.manage') %}
                <a class="nav-link{% if path starts with '/settings' or path starts with '/users' or path in ['/update', '/audit-log'] %} active{% endif %}"
                   href="/settings"{% if path == '/settings' or path == '/update' %} aria-current="page"{% endif %}>{{ icons.icon('settings') }}<span>{{ t('nav.settings') }}</span></a>
                {% endif %}
                {% include 'components/user_card.twig' %}
            </div>
        </div>
    </aside>
    {% endif %}
    <div class="flex min-w-0 flex-1 flex-col">
        {% if user %}{% include 'components/topbar.twig' %}{% endif %}
        <main class="flex-1" id="main-content" tabindex="-1">
            <div class="{% if user %}mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8{% elseif path starts with '/install' and authorized|default(false) %}mx-auto w-full max-w-3xl px-4 py-8{% else %}mx-auto w-full max-w-md px-4 py-10{% endif %}">
                {% if not user %}
                <div class="mb-2 flex justify-end">
                    {% include 'components/theme-picker.twig' %}
                </div>
                <div class="mb-8 text-center">
                    <a href="/" class="inline-flex items-center gap-3 text-ink no-underline hover:no-underline">
                        {% include 'components/logo.twig' with {size: 48, class: 'size-12'} %}
                        <span class="text-3xl font-semibold tracking-tight">{{ t('app.name') }}</span>
                    </a>
                </div>
                {% endif %}
                {% set message = flash() %}
                {% if message %}<div class="snackbar" role="status" aria-live="polite" data-snackbar>{{ message }}</div>{% endif %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
</div>
<script type="application/json" id="interface-texts">{{ interface_texts()|raw }}</script>
<script src="{{ asset('interface-texts.js') }}"></script>
<script src="{{ asset('ui.js') }}"></script>
<script src="{{ asset('input-masks.js') }}"></script>
<script src="{{ asset('app.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
