{% import 'components/icons.twig' as icons %}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('app.name') }}{% endblock %} – {{ t('app.name') }}</title>
    <link rel="icon" href="{{ asset('logo.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('vendor/tabler/tabler.min.css') }}">
    <link rel="stylesheet" href="{{ asset('app.css') }}">
    <link rel="stylesheet" href="{{ asset('user-card.css') }}">
    <script>
        (function() {
            var t = null;
            try { t = localStorage.getItem('vk-theme'); } catch(e) {}
            if (!t) { t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
</head>
<body>
<a class="skip-link" href="#main-content">{{ t('nav.skip') }}</a>
{% set user = current_user() %}
{% set path = current_path() %}
<div class="page{% if not user %} page-center{% endif %}">
    {% if user %}
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark" aria-label="{{ t('nav.main') }}">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
                    aria-controls="sidebar-menu" aria-expanded="false" aria-label="{{ t('nav.toggle') }}">
                <span class="navbar-toggler-icon"></span>
            </button>
            <h1 class="navbar-brand navbar-brand-autodark">
                <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="{{ asset('logo.svg') }}" alt="" width="32" height="32" class="navbar-brand-image">
                    <span>{{ t('app.name') }}</span>
                </a>
            </h1>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                <ul class="navbar-nav pt-lg-3">
                    <li class="nav-item{% if path == '/' %} active{% endif %}">
                        <a class="nav-link" href="/"><span class="nav-link-icon">{{ icons.icon('home') }}</span><span class="nav-link-title">{{ t('nav.home') }}</span></a>
                    </li>
                    {% if can('bookings.read') %}
                    {% set cashActive = path starts with '/bookings' or path starts with '/accounts' or path starts with '/categories' %}
                    <li class="nav-item dropdown{% if cashActive %} active{% endif %}">
                        <a class="nav-link dropdown-toggle{% if cashActive %} show{% endif %}" href="#cashbook-menu" data-bs-toggle="dropdown"
                           data-bs-auto-close="false" role="button" aria-expanded="{{ cashActive ? 'true' : 'false' }}" aria-controls="cashbook-menu">
                            <span class="nav-link-icon">{{ icons.icon('bookings') }}</span><span class="nav-link-title">{{ t('nav.cashbook') }}</span>
                        </a>
                        <div class="dropdown-menu{% if cashActive %} show{% endif %}" id="cashbook-menu">
                            <a class="dropdown-item{% if path starts with '/bookings' %} active{% endif %}" href="/bookings">{{ t('nav.bookings') }}</a>
                            <a class="dropdown-item{% if path starts with '/accounts' %} active{% endif %}" href="/accounts">{{ t('nav.accounts') }}</a>
                            <a class="dropdown-item{% if path starts with '/categories' %} active{% endif %}" href="/categories">{{ t('nav.categories') }}</a>
                        </div>
                    </li>
                    {% endif %}
                    {% if can('reports.read') %}
                    <li class="nav-item{% if path starts with '/reports' %} active{% endif %}">
                        <a class="nav-link" href="/reports/summary"><span class="nav-link-icon">{{ icons.icon('reports') }}</span><span class="nav-link-title">{{ t('nav.reports') }}</span></a>
                    </li>
                    {% endif %}
                    {% if can('settings.manage') %}
                    <li class="nav-item{% if path starts with '/settings/closing' %} active{% endif %}">
                        <a class="nav-link" href="/settings/closing"><span class="nav-link-icon">{{ icons.icon('closing') }}</span><span class="nav-link-title">{{ t('nav.closing') }}</span></a>
                    </li>
                    {% endif %}
                    {% if can('imports.read') %}
                    <li class="nav-item{% if path starts with '/imports/bank' %} active{% endif %}">
                        <a class="nav-link" href="/imports/bank"><span class="nav-link-icon">{{ icons.icon('imports') }}</span><span class="nav-link-title">Kontoauszug-Import</span></a>
                    </li>
                    {% endif %}
                    {% if can('contacts.read') %}
                    <li class="nav-item{% if path starts with '/contacts' %} active{% endif %}">
                        <a class="nav-link" href="/contacts"><span class="nav-link-icon">{{ icons.icon('contacts') }}</span><span class="nav-link-title">{{ t('foundation.contacts') }}</span></a>
                    </li>
                    {% endif %}
                </ul>
                <div class="nav-user mt-auto pt-3">
                    {% if can('settings.manage') %}
                    <a class="btn btn-outline-secondary w-100 mb-3{% if path starts with '/settings' or path starts with '/users' or path in ['/update', '/audit-log'] %} active{% endif %}"
                       href="/settings"{% if path == '/settings' or path == '/update' %} aria-current="page"{% endif %}>{{ icons.icon('settings') }}{{ t('nav.settings') }}</a>
                    {% endif %}
                    {% include 'components/user_card.twig' %}
                    </div>
                </div>
            </div>
    </aside>
    {% endif %}
    <div class="page-wrapper">
        <main class="page-body" id="main-content" tabindex="-1">
            <div class="{% if user %}container-xl{% else %}container-tight py-4{% endif %}">
                {% if user %}
                <div class="topbar border-bottom py-2 px-1 mb-4 d-flex align-items-center justify-content-between">
                    <nav aria-label="Brotkrumen">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/" class="text-decoration-none d-flex align-items-center gap-1">{{ icons.icon('home') }}<span>{{ t('nav.home') }}</span></a></li>
                            {% if path != '/' %}
                                {% if path starts with '/bookings' %}
                                    <li class="breadcrumb-item"><a href="/bookings" class="text-decoration-none">{{ t('nav.bookings') }}</a></li>
                                    {% if path == '/bookings/new' %}<li class="breadcrumb-item active" aria-current="page">Neu</li>{% endif %}
                                {% elseif path starts with '/transfers/new' %}
                                    <li class="breadcrumb-item"><a href="/bookings" class="text-decoration-none">{{ t('nav.bookings') }}</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">Umbuchung</li>
                                {% elseif path starts with '/corrections/new' %}
                                    <li class="breadcrumb-item"><a href="/bookings" class="text-decoration-none">{{ t('nav.bookings') }}</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">Korrektur</li>
                                {% elseif path starts with '/accounts' %}
                                    <li class="breadcrumb-item"><a href="/accounts" class="text-decoration-none">{{ t('nav.accounts') }}</a></li>
                                {% elseif path starts with '/categories' %}
                                    <li class="breadcrumb-item"><a href="/categories" class="text-decoration-none">{{ t('nav.categories') }}</a></li>
                                {% elseif path starts with '/reports' %}
                                    <li class="breadcrumb-item"><a href="/reports/summary" class="text-decoration-none">{{ t('nav.reports') }}</a></li>
                                {% elseif path starts with '/settings' %}
                                    <li class="breadcrumb-item"><a href="/settings" class="text-decoration-none">{{ t('nav.settings') }}</a></li>
                                    {% if path == '/settings/club' %}<li class="breadcrumb-item active" aria-current="page">{{ t('foundation.club') }}</li>
                                    {% elseif path == '/settings/closing' %}<li class="breadcrumb-item active" aria-current="page">{{ t('nav.closing') }}</li>{% endif %}
                                {% elseif path starts with '/users' %}
                                    <li class="breadcrumb-item"><a href="/users" class="text-decoration-none">{{ t('nav.users') }}</a></li>
                                {% elseif path starts with '/contacts' %}
                                    <li class="breadcrumb-item"><a href="/contacts" class="text-decoration-none">{{ t('foundation.contacts') }}</a></li>
                                {% elseif path starts with '/imports' %}
                                    <li class="breadcrumb-item"><a href="/imports/bank" class="text-decoration-none">Kontoauszug-Import</a></li>
                                {% elseif path == '/audit-log' %}
                                    <li class="breadcrumb-item active" aria-current="page">{{ t('nav.audit') }}</li>
                                {% elseif path == '/update' %}
                                    <li class="breadcrumb-item active" aria-current="page">Aktualisierung</li>
                                {% endif %}
                            {% endif %}
                        </ol>
                    </nav>
                    <div class="topbar-actions d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-icon theme-toggle" id="theme-toggle"
                                aria-label="Farbschema wechseln" title="Farbschema wechseln">
                            <span class="theme-icon-light d-none">{{ icons.icon('light-mode') }}</span>
                            <span class="theme-icon-dark">{{ icons.icon('dark-mode') }}</span>
                        </button>
                    </div>
                </div>
                {% endif %}
                {% if not user %}
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-icon theme-toggle" id="auth-theme-toggle"
                            aria-label="Farbschema wechseln" title="Farbschema wechseln">
                        <span class="theme-icon-light d-none">{{ icons.icon('light-mode') }}</span>
                        <span class="theme-icon-dark">{{ icons.icon('dark-mode') }}</span>
                    </button>
                </div>
                <div class="text-center mb-4">
                    <a href="/" class="navbar-brand navbar-brand-autodark d-inline-flex align-items-center gap-2 text-decoration-none">
                        <img src="{{ asset('logo.svg') }}" alt="" width="48" height="48" class="navbar-brand-image">
                        <span class="fs-1 fw-bold text-reset">{{ t('app.name') }}</span>
                    </a>
                </div>
                {% endif %}
                {% set message = flash() %}
                {% if message %}<div class="alert alert-success" role="status">{{ message }}</div>{% endif %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
</div>
<script src="{{ asset('vendor/tabler/tabler.min.js') }}"></script>
<script src="{{ asset('app.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
