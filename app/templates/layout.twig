{% import 'components/icons.twig' as icons %}
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ t('app.name') }}{% endblock %} – {{ t('app.name') }}</title>
    <link rel="icon" href="{{ asset('logo.svg') }}" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="{{ asset('logo-dark.svg') }}" type="image/svg+xml" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="{{ asset('vendor/tabler/tabler.min.css') }}">
    <link rel="stylesheet" href="{{ asset('app.css') }}">
    <link rel="stylesheet" href="{{ asset('user-card.css') }}">
    <meta name="color-scheme" content="light dark">
    <script src="{{ asset('theme.js') }}"></script>
</head>
<body>
<a class="skip-link" href="#main-content">{{ t('nav.skip') }}</a>
{% set user = current_user() %}
{% set path = current_path() %}
<div class="page{% if not user %} page-center{% endif %}">
    {% if user %}
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark" aria-label="{{ t('nav.main') }}">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
                    aria-controls="sidebar-menu" aria-expanded="false" aria-label="{{ t('nav.toggle') }}">
                <span class="navbar-toggler-icon"></span>
            </button>
            <h1 class="navbar-brand navbar-brand-autodark">
                <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="{{ asset('logo-dark.svg') }}" alt="" width="32" height="32" class="navbar-brand-image">
                    <span>{{ t('app.name') }}</span>
                </a>
            </h1>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                <ul class="navbar-nav pt-lg-3">
                    <li class="nav-item{% if path == '/' or path starts with '/dashboard/preferences' %} active{% endif %}">
                        <a class="nav-link" href="/"><span class="nav-link-icon">{{ icons.icon('home') }}</span><span class="nav-link-title">{{ t('nav.home') }}</span></a>
                    </li>
                    {% if can('members.read') %}
                    {% set membersActive = path starts with '/members' or path == '/settings/club-roles' %}
                    {% set pendingApps = pending_applications_count() %}
                    <li class="nav-item dropdown{% if membersActive %} active{% endif %}">
                        <a class="nav-link dropdown-toggle{% if membersActive %} show{% endif %}" href="#members-menu" data-bs-toggle="dropdown"
                           data-bs-auto-close="false" role="button" aria-expanded="{{ membersActive ? 'true' : 'false' }}" aria-controls="members-menu">
                            <span class="nav-link-icon">{{ icons.icon('members') }}</span>
                            <span class="nav-link-title">{{ t('nav.members') }}</span>
                            {% if pendingApps > 0 %}
                            <span class="badge bg-primary ms-auto" title="{{ pendingApps }} offene Anträge">{{ pendingApps }}</span>
                            {% endif %}
                        </a>
                        <div class="dropdown-menu{% if membersActive %} show{% endif %}" id="members-menu">
                            <a class="dropdown-item{% if path == '/members' or (path starts with '/members/' and not (path starts with '/members/applications')) %} active{% endif %}" href="/members">{{ t('members.list') }}</a>
                            <a class="dropdown-item d-flex align-items-center justify-content-between{% if path starts with '/members/applications' %} active{% endif %}" href="/members/applications">
                                <span>{{ t('applications.tab_applications') }}</span>
                                {% if pendingApps > 0 %}
                                <span class="badge bg-primary-subtle text-primary">{{ pendingApps }}</span>
                                {% endif %}
                            </a>
                            {% if can('settings.manage') %}
                            <a class="dropdown-item{% if path == '/settings/club-roles' %} active{% endif %}" href="/settings/club-roles">{{ t('nav.club_roles') }}</a>
                            {% endif %}
                        </div>
                    </li>
                    {% endif %}
                    {% if can('bookings.read') %}
                    {% set cashActive = path starts with '/bookings' or path starts with '/accounts' or path starts with '/categories' or path starts with '/imports' or path starts with '/invoices' or path starts with '/contacts' or path == '/receipt-inbox'  or path starts with '/transfers' or path starts with '/corrections' %}
                    <li class="nav-item dropdown{% if cashActive %} active{% endif %}">
                        <a class="nav-link dropdown-toggle{% if cashActive %} show{% endif %}" href="#cashbook-menu" data-bs-toggle="dropdown"
                           data-bs-auto-close="false" role="button" aria-expanded="{{ cashActive ? 'true' : 'false' }}" aria-controls="cashbook-menu">
                            <span class="nav-link-icon">{{ icons.icon('bookings') }}</span><span class="nav-link-title">{{ t('nav.cashbook') }}</span>
                        </a>
                        <div class="dropdown-menu{% if cashActive %} show{% endif %}" id="cashbook-menu">
                            <a class="dropdown-item{% if path starts with '/bookings' or path starts with '/transfers' or path starts with '/corrections' or path starts with '/imports' %} active{% endif %}" href="/bookings">{{ t('nav.bookings') }}</a>
                            <a class="dropdown-item{% if path starts with '/accounts' or path starts with '/categories' or path starts with '/contacts' %} active{% endif %}" href="/accounts">{{ t('finance.master_data') }}</a>
                            {% if can('invoices.read') %}
                            <a class="dropdown-item{% if path starts with '/invoices' %} active{% endif %}" href="/invoices">{{ t('finance.documents') }}</a>
                            {% endif %}
                        </div>
                    </li>
                    {% endif %}
                    {% if can('reports.read') %}
                    <li class="nav-item{% if path starts with '/reports' %} active{% endif %}">
                        <a class="nav-link" href="/reports/summary"><span class="nav-link-icon">{{ icons.icon('reports') }}</span><span class="nav-link-title">{{ t('nav.reports') }}</span></a>
                    </li>
                    {% endif %}
                </ul>
                <div class="nav-user mt-auto pt-3">
                    {% if can('settings.manage') %}
                    <a class="btn btn-outline-secondary w-100 mb-3{% if path starts with '/settings' or path starts with '/users' or path in ['/update', '/audit-log'] %} active{% endif %}"
                       href="/settings"{% if path == '/settings' or path == '/update' %} aria-current="page"{% endif %}>{{ icons.icon('settings') }}{{ t('nav.settings') }}</a>
                    {% endif %}
                    {% include 'components/user_card.twig' %}
                    </div>
                </div>
            </div>
    </aside>
    {% endif %}
    <div class="page-wrapper">
        {% if user %}{% include 'components/topbar.twig' %}{% endif %}
        <main class="page-body" id="main-content" tabindex="-1">
            <div class="{% if user %}container-xl{% elseif path starts with '/install' and authorized|default(false) %}container-md py-4{% else %}container-tight py-4{% endif %}">
                {% if not user %}
                <div class="d-flex justify-content-end mb-2">
                    {% include 'components/theme-picker.twig' %}
                </div>
                <div class="text-center mb-4">
                    <a href="/" class="navbar-brand navbar-brand-autodark d-inline-flex align-items-center gap-2 text-decoration-none">
                        {% include 'components/logo.twig' with {size: 48, class: 'navbar-brand-image'} %}
                        <span class="fs-1 fw-bold text-reset">{{ t('app.name') }}</span>
                    </a>
                </div>
                {% endif %}
                {% set message = flash() %}
                {% if message %}<div class="alert alert-success" role="status">{{ message }}</div>{% endif %}
                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
</div>
<script src="{{ asset('vendor/tabler/tabler.min.js') }}"></script>
<script type="application/json" id="interface-texts">{{ interface_texts()|raw }}</script>
<script src="{{ asset('interface-texts.js') }}"></script>
<script src="{{ asset('input-masks.js') }}"></script>
<script src="{{ asset('app.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
