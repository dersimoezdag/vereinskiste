{% extends 'layout.twig' %}
{% block title %}{{ t('home.title') }}{% endblock %}
{% block content %}
{% import 'components/icons.twig' as icons %}
<form method="post" action="/dashboard/preferences" data-dashboard-form data-dashboard-editable>
    {{ csrf_field() }}
    <input type="hidden" name="version" value="{{ preferences.version }}">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div><h1 class="mb-1">{{ t('home.title') }}</h1><p class="text-muted mb-0">{{ t('home.tagline') }}</p></div>
        <div class="d-flex gap-2">
            <button type="button" class="btn dashboard-edit-button" data-dashboard-edit aria-pressed="false">{{ icons.icon('settings') }} {{ t('home.edit') }}</button>
            <button class="btn btn-primary dashboard-edit-only" data-layout-save>{{ t('common.save') }}</button>
        </div>
        <noscript><a href="/dashboard/preferences" class="btn">{{ t('home.customize') }}</a></noscript>
    </div>
    {% for key, catalog in {'cards': cards, 'shortcuts': shortcuts} %}
        {% if key == 'shortcuts' %}<h2 class="mt-4 mb-3">{{ t('ui.schnellaktionen') }}</h2>{% endif %}
        <div class="{{ key == 'cards' ? 'dashboard-grid' : 'dashboard-shortcuts' }}" data-dashboard-list data-dashboard-group="{{ key }}">
            {% for id in preferences[key] %}
                {% include 'dashboard/tile.twig' with {item: catalog[id], metric: key == 'cards' ? metrics[id] : {}} %}
            {% endfor %}
        </div>
        <p class="text-muted mt-2" data-dashboard-empty="{{ key }}" {% if preferences[key]|length %}hidden{% endif %}>{{ t('home.empty.' ~ key) }}</p>
        <div class="dashboard-edit-only mt-3 d-flex flex-wrap gap-2" data-dashboard-additions="{{ key }}" aria-label="{{ t('home.add') }}">
            {% for id, item in catalog %}
                <button type="button" class="btn btn-sm" data-dashboard-add="{{ id }}" data-dashboard-group="{{ key }}" {% if id in preferences[key] %}hidden{% endif %}>+ {{ t(item.label) }}</button>
                <template data-dashboard-template="{{ key }}:{{ id }}">
                    {% include 'dashboard/tile.twig' with {metric: key == 'cards' ? metrics[id] : {}} %}
                </template>
            {% endfor %}
        </div>
    {% endfor %}
    <div class="mt-3" role="status" aria-live="polite" data-dashboard-status></div>
</form>
{% endblock %}
{% block scripts %}<script src="{{ asset('home-dashboard.js') }}"></script>{% endblock %}
