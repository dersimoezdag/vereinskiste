{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="mx-auto w-full max-w-7xl py-12">
    <div class="grid-12 gap-x-6 justify-center">
        <div class="md:col-span-7 col-span-12">
            <div class="panel shadow-panel border-0 text-center p-12">
                <div class="mb-4">
                    {% include 'components/logo.twig' with {size: 64, alt: 'Vereinskiste Logo'} %}
                </div>
                <div class="badge bg-success-soft text-success p-4 rounded-full inline-block mx-auto mb-4" style="width: 60px; height: 60px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h1 class="h2 font-semibold text-success mb-2">{{ t('applications.success_title') }}</h1>
                <p class="text-lg text-muted mb-6">
                    {{ t('applications.success_message') }}
                </p>
                <div>
                    <a href="/" class="btn btn-primary px-6">{{ t('applications.back_home') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
