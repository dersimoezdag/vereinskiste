{% extends 'public/membership_layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="mx-auto w-full max-w-7xl py-12">
    <div class="grid-12 gap-x-6 justify-center">
        <div class="md:col-span-6 col-span-12">
            <div class="panel shadow-panel border-0 text-center p-6">
                <div class="mb-4">
                    {% include 'components/logo.twig' with {size: 56, alt: 'Vereinskiste Logo'} %}
                </div>
                <h1 class="h3 font-semibold mb-2">{{ t('ui.mitgliedsantrag') }}</h1>
                <div class="alert alert-warning my-4">
                    {% if reason == 'revoked' %}
                        {{ t('applications.link_revoked') }}
                    {% elseif reason == 'expired' %}
                        {{ t('applications.link_expired') }}
                    {% elseif reason == 'used' %}
                        {{ t('applications.link_used') }}
                    {% else %}
                        {{ t('applications.link_invalid') }}
                    {% endif %}
                </div>
                <p class="text-muted text-sm">
                    {{ t('ui.bitte_wende_dich_an_den_vereinsvorstand_um_einen_neuen_antrags_li') }}
                </p>
                <div class="mt-4">
                    <a href="/" class="btn">{{ t('applications.back_home') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
