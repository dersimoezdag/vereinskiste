{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="container-xl py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-12">
            <div class="card shadow-sm border-0 text-center p-4">
                <div class="mb-3">
                    <img src="{{ asset('logo.svg') }}" alt="Vereinskiste Logo" width="56" height="56">
                </div>
                <h1 class="h3 fw-bold mb-2">Mitgliedsantrag</h1>
                <div class="alert alert-warning my-3">
                    {% if reason == 'expired' %}
                        {{ t('applications.link_expired') }}
                    {% elseif reason == 'used' %}
                        {{ t('applications.link_used') }}
                    {% else %}
                        {{ t('applications.link_invalid') }}
                    {% endif %}
                </div>
                <p class="text-muted small">
                    Bitte wende dich an den Vereinsvorstand, um einen neuen Antrags-Link zu erhalten.
                </p>
                <div class="mt-3">
                    <a href="/" class="btn btn-outline-secondary">{{ t('applications.back_home') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
