{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="container-xl py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-12">
            <div class="card shadow-sm border-0 text-center p-4">
                <div class="mb-3">
                    {% include 'components/logo.twig' with {size: 56, alt: 'Vereinskiste Logo'} %}
                </div>
                <h1 class="h3 fw-bold mb-2">{{ t('ui.mitgliedsantrag') }}</h1>
                <div class="alert alert-warning my-3">
                    {% if reason == 'expired' %}
                        {{ t('applications.link_expired') }}
                    {% elseif reason == 'used' %}
                        {{ t('applications.link_used') }}
                    {% else %}
                        {{ t('applications.link_invalid') }}
                    {% endif %}
                </div>
                <p class="text-muted small">
                    {{ t('ui.bitte_wende_dich_an_den_vereinsvorstand_um_einen_neuen_antrags_li') }}
                </p>
                <div class="mt-3">
                    <a href="/" class="btn btn-outline-secondary">{{ t('applications.back_home') }}</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
