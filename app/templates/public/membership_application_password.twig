{% extends 'public/membership_layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="mx-auto w-full max-w-7xl py-12">
    <div class="grid-12 gap-x-6 justify-center">
        <div class="md:col-span-6 col-span-12">
            <div class="panel shadow-panel border-0 text-center p-6">
                <div class="mb-4">
                    {% if club_logo() %}
                        {% include 'components/club_logo.twig' with {size: 56, class: 'mx-auto max-h-14 w-auto object-contain'} %}
                    {% else %}
                        {% include 'components/logo.twig' with {size: 56, alt: 'Vereinskiste Logo'} %}
                    {% endif %}
                </div>
                <h1 class="h3 font-semibold mb-2">{{ t('applications.password_prompt.title') }}</h1>
                <p class="text-muted mb-6">{{ t('applications.password_prompt.info') }}</p>

                {% if error %}
                <div class="alert alert-danger mb-4">{{ t(error) }}</div>
                {% endif %}

                <form method="post" action="/antrag/{{ token }}/unlock" class="text-left">
                    {{ csrf_field() }}
                    <div class="mb-4">
                        <label for="invite-password" class="label required">{{ t('applications.password_prompt.field') }}</label>
                        <input type="password" id="invite-password" name="password" class="input input-lg" required autofocus>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-full">
                        {{ t('applications.password_prompt.submit') }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
