{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}

{% block content %}
<div class="container-xl py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-12">
            <div class="card shadow-sm border-0 text-center p-4">
                <div class="mb-3">
                    {% include 'components/logo.twig' with {size: 56, alt: 'Vereinskiste Logo'} %}
                </div>
                <h1 class="h3 fw-bold mb-2">{{ t('applications.password_prompt.title') }}</h1>
                <p class="text-muted mb-4">{{ t('applications.password_prompt.info') }}</p>

                {% if error %}
                <div class="alert alert-danger mb-3">{{ t(error) }}</div>
                {% endif %}

                <form method="post" action="/antrag/{{ token }}/unlock" class="text-start">
                    {{ csrf_field() }}
                    <div class="mb-3">
                        <label for="invite-password" class="form-label required">{{ t('applications.password_prompt.field') }}</label>
                        <input type="password" id="invite-password" name="password" class="form-control form-control-lg" required autofocus>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        {{ t('applications.password_prompt.submit') }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
