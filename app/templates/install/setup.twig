{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}
{% import 'components/stepper.twig' as stepper %}
{% block title %}{{ t('install.title') }}{% endblock %}
{% block content %}
{% if installed %}
<div class="panel shadow-panel border-0">
    <div class="panel-body p-6 text-center">
        <div class="avatar avatar-lg bg-success-soft text-success rounded-full mb-4 mx-auto">
            {{ icons.icon('check') }}
        </div>
        <h1 class="panel-title h2 mb-2">{{ t('install.title') }}</h1>
        <p class="text-muted mb-6" role="alert">{{ t('install.locked') }}</p>
        <a href="/login" class="btn btn-primary inline-flex items-center gap-2">
            <span>{{ t('nav.login') }}</span>
            {{ icons.icon('arrow-forward') }}
        </a>
    </div>
</div>
{% elseif not authorized %}
<div class="panel shadow-panel border-0">
    <div class="panel-body p-6 text-center">
        <div class="avatar avatar-lg bg-primary-soft text-primary rounded-full mb-4 mx-auto">
            {{ icons.icon('shield') }}
        </div>
        <h1 class="panel-title h2 mb-2">{{ t('install.title') }}</h1>
        <p class="text-muted mb-6">{{ t('install.key.help') }}</p>
        {% if error %}<div class="alert alert-danger text-left flex items-center gap-2" role="alert">{{ icons.icon('error') }}<div>{{ t('install.key.invalid') }}</div></div>{% endif %}
        <form method="post" action="/install/unlock" class="text-left">
            {{ csrf_field() }}
            <div class="mb-4">
                <label class="label required" for="setup-key">{{ t('install.key.label') }}</label>
                <div class="input-group">
                    <span class="input-addon">{{ icons.icon('password') }}</span>
                    <input class="input" id="setup-key" type="password" name="setup_key" autocomplete="off" placeholder="••••••••••••" required autofocus>
                </div>
            </div>
            <button class="btn btn-primary w-full inline-flex items-center justify-center gap-2" type="submit">
                <span>{{ t('install.key.submit') }}</span>
                {{ icons.icon('arrow-forward') }}
            </button>
        </form>
    </div>
</div>
{% else %}
{% set steps = [
    {'title': 'install.step.check', 'icon': 'shield', 'fields': {}},
    {'title': 'install.club', 'icon': 'club', 'fields': {'club_name': 'text', 'base_url': 'url'}},
    {'title': 'install.database', 'icon': 'database', 'fields': {'db_host': 'text', 'db_port': 'number', 'db_name': 'text', 'db_user': 'text', 'db_password': 'password'}},
    {'title': 'install.admin', 'icon': 'admin', 'fields': {'admin_name': 'text', 'admin_email': 'email', 'admin_password': 'password'}},
    {'title': 'install.smtp', 'icon': 'mail', 'fields': {'smtp_host': 'text', 'smtp_port': 'number', 'smtp_from': 'email', 'smtp_username': 'text', 'smtp_password': 'password', 'smtp_encryption': 'select'}}
] %}
{% set allOk = true %}{% for check in checks %}{% if not check.ok %}{% set allOk = false %}{% endif %}{% endfor %}

<div class="text-center mb-6">
    <h1 class="h2 mb-1">{{ t('install.title') }}</h1>
    <p class="text-muted mb-0">{{ t('install.subtitle') }}</p>
</div>

{% if error %}
<div class="alert alert-danger flex items-center gap-2 mb-6" role="alert">
    {{ icons.icon('error') }}
    <div>{{ t('install.error') }}</div>
</div>
{% endif %}

<form method="post" action="/install" data-stepper data-checks-ok="{{ allOk ? '1' : '0' }}"{% if error %} data-start-last{% endif %}>
    {{ csrf_field() }}
    {% set stepItems = [] %}
    {% for step in steps %}{% set stepItems = stepItems|merge([{'title': t(step.title), 'icon': step.icon}]) %}{% endfor %}
    {{ stepper.steps(stepItems, t('install.steps'), true) }}

    {% for step in steps %}
    <fieldset class="panel mb-6 stepper-panel shadow-panel border-0" data-step="{{ loop.index0 }}">
        <legend class="sr-only">{{ t(step.title) }}</legend>
        <div class="panel-header bg-transparent py-4 border-b border-line flex items-center gap-4">
            <span class="avatar avatar-md bg-primary-soft text-primary rounded-full">
                {{ icons.icon(step.icon) }}
            </span>
            <div>
                <div class="uppercase text-muted text-sm font-semibold">{{ t('install.step') }} {{ loop.index }} {{ t('install.step.of') }} {{ steps|length }}</div>
                <div class="panel-title h3 mb-0" aria-hidden="true">{{ t(step.title) }}</div>
            </div>
        </div>
        <div class="panel-body p-6">
        {% if loop.first %}
            <div class="list mb-4">
            {% for check in checks %}
            <div class="list-item check-item {{ check.ok ? 'check-ok' : 'check-fail' }} p-4 flex items-center gap-4">
                <span class="avatar avatar-sm rounded-full {{ check.ok ? 'bg-success text-white' : 'bg-danger text-white' }}" aria-hidden="true">
                    {{ icons.icon(check.ok ? 'check' : 'error') }}
                </span>
                <div class="flex-1">
                    <div class="check-name font-semibold font-mono">{{ check.name }}</div>
                    <div class="check-message text-muted text-sm">{{ check.message }}</div>
                </div>
                {% if not check.ok %}
                    <span class="badge bg-danger text-white">{{ t('install.failed') }}</span>
                {% else %}
                    <span class="badge bg-success-soft text-success">{{ t('install.ok') }}</span>
                {% endif %}
            </div>
            {% endfor %}
            </div>
            {% if not allOk %}
                <div class="alert alert-danger flex items-center gap-2 mb-0" role="alert">
                    {{ icons.icon('error') }}
                    <div>{{ t('install.check.blocked') }}</div>
                </div>
            {% else %}
                <div class="alert alert-success flex items-center gap-2 mb-0" role="status">
                    {{ icons.icon('check') }}
                    <div><strong>{{ t('install.ready.title') }}</strong> {{ t('install.ready.text') }}</div>
                </div>
            {% endif %}
        {% endif %}

        {% if step.title == 'install.smtp' %}
        <p class="text-muted text-sm mb-4">{{ t('install.smtp.optional') }}</p>
        {% endif %}

        <div class="grid-12 gap-4">
        {% for field, type in step.fields %}
            {% set colClass = 'col-span-12' %}
            {% if field in ['db_host', 'smtp_host'] %}
                {% set colClass = 'col-span-12 md:col-span-9' %}
            {% elseif field in ['db_port', 'smtp_port'] %}
                {% set colClass = 'col-span-12 md:col-span-3' %}
            {% elseif field in ['db_user', 'db_password', 'admin_name', 'admin_email', 'smtp_username', 'smtp_password'] %}
                {% set colClass = 'col-span-12 md:col-span-6' %}
            {% endif %}
            <div class="{{ colClass }}">
                <label class="label{% if step.title != 'install.smtp' and field != 'db_password' %} required{% endif %}" for="{{ field }}">{{ t('install.' ~ field) }}</label>
                {% if type == 'select' %}
                <select class="input" id="{{ field }}" name="{{ field }}">
                    {% for value in ['tls', 'ssl'] %}<option value="{{ value }}" {% if input[field]|default('tls') == value %}selected{% endif %}>{{ value|upper }}</option>{% endfor %}
                </select>
                {% else %}
                <input class="input" type="{{ type }}" id="{{ field }}" name="{{ field }}"
                       {% if type != 'password' %}value="{{ input[field]|default('') }}"{% else %}autocomplete="new-password"{% endif %}
                       {% if step.title != 'install.smtp' and field != 'db_password' %}required{% endif %}
                       {% if field == 'admin_password' %}minlength="10"{% endif %}>
                {% endif %}
            </div>
        {% endfor %}
        </div>
        </div>
    </fieldset>
    {% endfor %}

    <div class="stepper-actions flex justify-between items-center mt-4 pt-4">
        <button class="btn inline-flex items-center gap-1" type="button" data-step-prev hidden>
            {{ icons.icon('arrow-back') }}
            <span>{{ t('install.back') }}</span>
        </button>
        <button class="btn btn-primary ms-auto inline-flex items-center gap-1" type="button" data-step-next hidden>
            <span>{{ t('install.next') }}</span>
            {{ icons.icon('arrow-forward') }}
        </button>
        <button class="btn btn-success ms-auto inline-flex items-center gap-1" type="submit" data-step-submit>
            {{ icons.icon('check') }}
            <span>{{ t('install.submit') }}</span>
        </button>
    </div>
</form>
{% endif %}
{% endblock %}
