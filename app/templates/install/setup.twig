{% extends 'layout.twig' %}
{% block title %}{{ t('install.title') }}{% endblock %}
{% block content %}
<h1>{{ t('install.title') }}</h1>
{% if installed %}<p role="alert">{{ t('install.locked') }}</p>
{% elseif not authorized %}
<p>{{ t('install.key.help') }}</p>
{% if error %}<p class="alert alert-danger" role="alert">{{ t('install.key.invalid') }}</p>{% endif %}
<form method="post" action="/install/unlock">
    {{ csrf_field() }}
    <label class="form-label" for="setup-key">{{ t('install.key.label') }}</label>
    <input class="form-control mb-3" id="setup-key" type="password" name="setup_key" autocomplete="off" required>
    <button class="btn btn-primary" type="submit">{{ t('install.key.submit') }}</button>
</form>
{% else %}
<ul class="list-group mb-3">
{% for check in checks %}<li class="list-group-item">{{ check.name }}: {{ check.message }} {% if not check.ok %}({{ t('install.failed') }}){% endif %}</li>{% endfor %}
</ul>
{% if error %}<p class="alert alert-danger" role="alert">{{ t('install.error') }}</p>{% endif %}
<form method="post" action="/install">
    {{ csrf_field() }}
    {% for group, fields in {
        'install.club': {'club_name': 'text', 'base_url': 'url'},
        'install.database': {'db_host': 'text', 'db_port': 'number', 'db_name': 'text', 'db_user': 'text', 'db_password': 'password'},
        'install.admin': {'admin_name': 'text', 'admin_email': 'email', 'admin_password': 'password'},
        'install.smtp': {'smtp_host': 'text', 'smtp_port': 'number', 'smtp_from': 'email', 'smtp_username': 'text', 'smtp_password': 'password', 'smtp_encryption': 'select'}
    } %}
    <fieldset class="mb-4"><legend class="h3">{{ t(group) }}</legend>
    {% if group == 'install.smtp' %}<p>{{ t('install.smtp.optional') }}</p>{% endif %}
    {% for field, type in fields %}
    <div class="mb-3">
        <label class="form-label" for="{{ field }}">{{ t('install.' ~ field) }}</label>
        {% if type == 'select' %}
        <select class="form-select" id="{{ field }}" name="{{ field }}">
            {% for value in ['tls', 'ssl'] %}<option value="{{ value }}" {% if input[field]|default('tls') == value %}selected{% endif %}>{{ value|upper }}</option>{% endfor %}
        </select>
        {% else %}
        <input class="form-control" type="{{ type }}" id="{{ field }}" name="{{ field }}"
               {% if type != 'password' %}value="{{ input[field]|default('') }}"{% else %}autocomplete="new-password"{% endif %}
               {% if group != 'install.smtp' and field != 'db_password' %}required{% endif %}
               {% if field == 'admin_password' %}minlength="10"{% endif %}>
        {% endif %}
    </div>
    {% endfor %}</fieldset>
    {% endfor %}
    <button class="btn btn-primary w-100" type="submit">{{ t('install.submit') }}</button>
</form>
{% endif %}
{% endblock %}
