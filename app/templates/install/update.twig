{% extends 'layout.twig' %}
{% block title %}{{ t('nav.settings') }}{% endblock %}
{% block content %}
<h1>{{ t('nav.settings') }}</h1>
{% include 'components/settings_tabs.twig' %}
<section class="card mb-4" aria-labelledby="version-title">
    <div class="card-body">
        <h2 class="card-title" id="version-title">{{ t('settings.version') }}</h2>
        <p class="h2 mb-0">{{ version }}</p>
    </div>
</section>
<section class="card" aria-labelledby="updates-title"><div class="card-body">
<h2 class="card-title" id="updates-title">{{ t('settings.updates') }}</h2>
<p>{{ t('settings.github.source') }} <a href="https://github.com/dersimoezdag/vereinskiste/releases" rel="noreferrer">GitHub Releases</a></p>
<form method="post" action="/settings/check-updates" class="mb-3">
    {{ csrf_field() }}
    <button class="btn btn-outline-primary" type="submit">{{ t('settings.github.check') }}</button>
</form>
{% if release.status != 'unchecked' %}
<p role="status">{{ t('settings.github.' ~ release.status) }}{% if release.version is defined %} {{ release.version }}{% endif %}</p>
{% if release.status == 'error' and release.reason is defined %}
<p class="alert alert-warning">{{ t('settings.github.error.' ~ release.reason) }}{% if release.http_status is defined %} (HTTP {{ release.http_status }}){% endif %}</p>
{% endif %}
{% if release.status == 'available' %}
    {% if release.manifest is defined and release.signature is defined and automatic_supported and not pending %}
    <form method="post" action="/settings/auto-update/start" class="card card-body mb-3">
        {{ csrf_field() }}<input type="hidden" name="version" value="{{ release.version }}">
        <p>{{ t('auto_update.explain') }}</p>
        <label class="form-check mb-3"><input type="checkbox" name="backup_confirmed" value="1" class="form-check-input" required>
            {{ t('auto_update.backup_confirm') }}</label>
        <button class="btn btn-primary" type="submit">{{ t('auto_update.install') }} {{ release.version }}</button>
    </form>
    {% endif %}
    {% if release.download is defined %}<a class="btn btn-primary mb-3" href="{{ release.download }}" rel="noreferrer">{{ t('settings.github.download') }}</a>
    {% else %}<p>{{ t('settings.github.missing_package') }}</p>{% endif %}
    <a class="btn btn-link mb-3" href="{{ release.url }}" rel="noreferrer">{{ t('settings.github.release') }}</a>
{% endif %}
{% endif %}
{% if operation.phase != 'idle' %}<p><a href="/settings/auto-update">{{ t('auto_update.progress') }}</a></p>{% endif %}
<p class="text-secondary">{{ t('settings.updates.help') }}</p>
{% if error %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endif %}
{% if done %}<p class="alert alert-success" role="status">{{ t('update.done') }}</p>{% endif %}
{% if not compatible %}
<p class="alert alert-danger" role="alert">{{ t('update.incompatible') }}</p>
{% elseif pending %}
<p>{{ t('update.instructions') }}</p>
<form method="post" action="/settings/update">
    {{ csrf_field() }}
    <label class="form-check mb-3" for="backup">
        <input class="form-check-input" id="backup" type="checkbox" name="backup_confirmed" value="1" required>
        <span class="form-check-label">{{ t('update.backup') }}</span>
    </label>
    <button class="btn btn-primary" type="submit">{{ t('update.run') }}</button>
</form>
{% else %}<p>{{ t('update.current') }}</p>{% endif %}
</div></section>
{% endblock %}
