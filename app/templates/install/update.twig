{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}
{% block title %}{{ t('nav.settings') }}{% endblock %}
{% block content %}
<div class="page-header d-print-none mb-3">
    <h1 class="page-title">{{ t('nav.settings') }}</h1>
</div>

{% include 'components/settings_tabs.twig' %}

<!-- Version Header Card -->
<section class="card mb-4 shadow-sm border-0" aria-labelledby="version-title">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <div class="avatar avatar-lg bg-primary-subtle text-primary rounded-circle">
                    {{ icons.icon('settings') }}
                </div>
            </div>
            <div class="col">
                <h2 class="card-title text-secondary small fw-bold text-uppercase mb-1" id="version-title">{{ t('settings.version') }}</h2>
                <div class="d-flex align-items-center gap-3 mt-1 flex-wrap">
                    <span class="h1 mb-0 fw-bold">v{{ version }}</span>
                    {% if release.status == 'current' %}
                        <span class="badge bg-success-subtle text-success fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                            {{ icons.icon('check') }}
                            <span>{{ t('update.current') }}</span>
                        </span>
                    {% elseif release.status == 'available' %}
                        <span class="badge bg-primary-subtle text-primary fs-6 py-2 px-3 d-inline-flex align-items-center gap-1">
                            {{ icons.icon('rocket') }}
                            <span>{{ t('settings.github.available') }} v{{ release.version }}</span>
                        </span>
                    {% elseif release.status != 'unchecked' %}
                        <span class="badge bg-secondary-subtle text-secondary fs-6 py-2 px-3">
                            {{ t('settings.github.' ~ release.status) }}
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="col-auto">
                <form method="post" action="/settings/check-updates">
                    {{ csrf_field() }}
                    <button class="btn btn-outline-primary d-inline-flex align-items-center gap-2" type="submit">
                        {{ icons.icon('sync') }}
                        <span>{{ t('settings.github.check') }}</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Fehlermeldungen & Benachrichtigungen -->
{% if error %}<p class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">{{ icons.icon('error') }}<span>{{ t(error) }}</span></p>{% endif %}
{% if done %}<p class="alert alert-success d-flex align-items-center gap-2 mb-4" role="status">{{ icons.icon('check') }}<span>{{ t('update.done') }}</span></p>{% endif %}
{% if not compatible %}<p class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">{{ icons.icon('error') }}<span>{{ t('update.incompatible') }}</span></p>{% endif %}

{% if release.status == 'error' and release.reason is defined %}
<p class="alert alert-warning d-flex align-items-center gap-2 mb-4">{{ icons.icon('error') }}<span>{{ t('settings.github.error.' ~ release.reason) }}{% if release.http_status is defined %} (HTTP {{ release.http_status }}){% endif %}</span></p>
{% endif %}

<!-- Laufendes Auto-Update Banner -->
{% if operation.phase not in ['idle', 'done', 'failed', 'cancelled', 'rolled_back'] %}
<div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-4">
    <div class="d-flex align-items-center gap-2">
        <span class="spinner-border spinner-border-sm" role="status"></span>
        <div><strong>{{ t('auto_update.running') }}</strong> {{ t('auto_update.status_is') }} <em>{{ t('auto_update.phase.' ~ operation.phase) }}</em>.</div>
    </div>
    <a href="/settings/auto-update" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1">
        <span>{{ t('auto_update.progress') }}</span>
        {{ icons.icon('arrow-forward') }}
    </a>
</div>
{% endif %}

<!-- Wenn neues Release verfügbar ist -->
{% if release.status == 'available' %}
<div class="card mb-4 border-primary shadow-sm">
    <div class="card-header bg-primary-subtle py-3 d-flex align-items-center gap-2">
        <span class="avatar avatar-sm bg-primary text-white rounded-circle">{{ icons.icon('rocket') }}</span>
        <h2 class="card-title h3 mb-0 text-primary">{{ t('settings.github.available') }}: Version {{ release.version }}</h2>
    </div>
    <div class="card-body p-4">
        {% if release.manifest is defined and release.signature is defined and automatic_supported and not pending %}
        <div class="row g-4 align-items-center">
            <div class="col-lg-8 col-12">
                <h3 class="h4 mb-2">{{ t('auto_update.recommended') }}</h3>
                <p class="text-secondary mb-3">{{ t('auto_update.explain') }}</p>
                <div class="d-flex align-items-center gap-3 text-secondary small flex-wrap">
                    <span class="d-inline-flex align-items-center gap-1">{{ icons.icon('shield') }} {{ t('auto_update.feature.signed') }}</span>
                    <span class="d-inline-flex align-items-center gap-1">{{ icons.icon('database') }} {{ t('auto_update.feature.backup') }}</span>
                    <span class="d-inline-flex align-items-center gap-1">{{ icons.icon('sync') }} {{ t('auto_update.feature.rollback') }}</span>
                </div>
            </div>
            <div class="col-lg-4 col-12">
                <form method="post" action="/settings/auto-update/start" class="card bg-light-subtle p-3 border shadow-none">
                    {{ csrf_field() }}
                    <input type="hidden" name="version" value="{{ release.version }}">
                    <div class="form-check mb-3">
                        <input type="checkbox" name="backup_confirmed" value="1" id="auto-backup-confirm" class="form-check-input" required>
                        <label class="form-check-label small" for="auto-backup-confirm">
                            {{ t('auto_update.backup_confirm') }}
                        </label>
                    </div>
                    <button class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2" type="submit">
                        {{ icons.icon('rocket') }}
                        <span>{{ t('auto_update.install') }} {{ release.version }}</span>
                    </button>
                </form>
            </div>
        </div>
        <hr class="my-4">
        {% endif %}

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="text-secondary small">
                {{ t('settings.github.source') }} <a href="https://github.com/dersimoezdag/vereinskiste/releases" target="_blank" rel="noreferrer" class="text-reset text-decoration-underline">GitHub Releases</a>
            </div>
            <div class="d-flex gap-2">
                {% if release.download is defined %}
                <a class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" href="{{ release.download }}" rel="noreferrer">
                    {{ icons.icon('download') }}
                    <span>{{ t('settings.github.download') }}</span>
                </a>
                {% else %}
                <span class="text-muted small">{{ t('settings.github.missing_package') }}</span>
                {% endif %}
                <a class="btn btn-link btn-sm text-secondary" href="{{ release.url }}" target="_blank" rel="noreferrer">
                    {{ t('settings.github.release') }}
                </a>
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Ausstehende Datenbank-Migrationen -->
{% if pending %}
<div class="card mb-4 border-warning shadow-sm">
    <div class="card-header bg-warning-subtle py-3 d-flex align-items-center gap-2">
        <span class="avatar avatar-sm bg-warning text-dark rounded-circle">{{ icons.icon('database') }}</span>
        <h2 class="card-title h3 mb-0">{{ t('update.title') }}</h2>
    </div>
    <div class="card-body p-4">
        <p class="lead mb-3">{{ t('update.instructions') }}</p>
        <form method="post" action="/settings/update" class="card bg-light-subtle p-3 border shadow-none">
            {{ csrf_field() }}
            <div class="form-check mb-3">
                <input class="form-check-input" id="backup" type="checkbox" name="backup_confirmed" value="1" required>
                <label class="form-check-label" for="backup">{{ t('update.backup') }}</label>
            </div>
            <div>
                <button class="btn btn-warning d-inline-flex align-items-center gap-2" type="submit">
                    {{ icons.icon('check') }}
                    <span>{{ t('update.run') }}</span>
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<!-- Allgemeine Update-Hinweise -->
<section class="card border-0 bg-transparent mb-0" aria-labelledby="updates-title">
    <div class="card-body p-0">
        <h2 class="h4 mb-2" id="updates-title">{{ t('settings.updates') }}</h2>
        <div class="text-secondary small d-flex align-items-start gap-2">
            <span class="text-muted mt-1">{{ icons.icon('shield') }}</span>
            <p class="mb-0">{{ t('settings.updates.help') }}</p>
        </div>
    </div>
</section>
{% endblock %}
