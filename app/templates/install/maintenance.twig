<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ updating ? t('update.maintenance.running_title') : t('update.maintenance.title') }} – {{ t('app.name') }}</title>
    <style>
        :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; background: light-dark(#f8fafc, #0b0f19); color: light-dark(#0f172a, #f8fafc); }
        main { max-width: 36rem; padding: 2rem; text-align: center; }
        h1 { font-size: 1.75rem; } p { line-height: 1.6; } a { color: light-dark(#1565c0, #90caf9); }
        a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
    </style>
</head>
<body>
    <main>
        <h1>{{ updating ? t('update.maintenance.running_title') : t('update.maintenance.title') }}</h1>
        <p>{{ updating ? t('update.maintenance.running_text') : t('update.maintenance.text') }}</p>
        <p><a href="/login">{{ t('update.maintenance.admin_login') }}</a></p>
    </main>
</body>
</html>
