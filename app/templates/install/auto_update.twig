{% extends 'layout.twig' %}
{% import 'components/icons.twig' as icons %}
{% import 'components/stepper.twig' as stepper %}
{% block title %}{{ t('auto_update.title') }}{% endblock %}
{% block content %}
<div class="row"><div class="col-lg-8 mx-auto py-3">
    <div class="text-center mb-4">
        <span class="avatar avatar-xl bg-primary-subtle text-primary rounded-circle mb-3">
            {{ icons.icon('sync') }}
        </span>
        <h1 class="h2 mb-1">{{ t('auto_update.title') }}</h1>
        {% if operation.version is defined %}
        <p class="text-secondary">{{ t('auto_update.target') }} <strong class="badge bg-primary-subtle text-primary fs-6">{{ t('ui.v') }}{{ operation.version }}</strong></p>
        {% endif %}
    </div>

    {% if error %}
    <p class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
        {{ icons.icon('error') }}
        <span>{{ t(error) }}</span>
    </p>
    {% endif %}

    <section class="card shadow-sm border-0 mb-3" id="automatic-update" data-phase="{{ operation.phase }}">
        <!-- Phasen-Anzeige (gleiche Komponente wie die Einrichtung; wird von auto-update.js live nachgefuehrt) -->
        {% set stages = [
            {'title': t('auto_update.step.check'), 'icon': 'shield', 'phases': ['manifest', 'signature']},
            {'title': t('auto_update.step.download'), 'icon': 'download', 'phases': ['download', 'inspect', 'extract']},
            {'title': t('auto_update.step.backup'), 'icon': 'database', 'phases': ['waiting', 'backup']},
            {'title': t('auto_update.step.activate'), 'icon': 'rocket', 'phases': ['activate']},
            {'title': t('auto_update.step.finish'), 'icon': 'check', 'phases': ['verify']}
        ] %}
        {% set stopped = operation.phase in ['failed', 'cancelled', 'rollback', 'rolled_back', 'recovery_required'] %}
        {% set focus = stopped ? operation.failed_phase|default('') : operation.phase %}
        {% set current = -1 %}
        {% for stage in stages %}{% if focus in stage.phases %}{% set current = loop.index0 %}{% endif %}{% endfor %}
        {% if operation.phase == 'done' %}{% set current = stages|length %}{% endif %}
        {% set stageItems = [] %}
        {% for stage in stages %}
            {% set state = loop.index0 < current ? 'done' : (loop.index0 == current ? (stopped ? 'failed' : 'active') : '') %}
            {% set stageItems = stageItems|merge([stage|merge({'state': state})]) %}
        {% endfor %}
        <div class="card-header bg-transparent border-bottom py-4 pb-2">
            {{ stepper.steps(stageItems, t('auto_update.pipeline')) }}
        </div>

        <div class="card-body p-4 text-center">
            <!-- Animated Progress Bar -->
            <div class="progress progress-sm mb-4" aria-hidden="true">
                {% if operation.phase == 'done' %}
                <div class="progress-bar w-100 bg-success" id="automatic-progress"></div>
                {% elseif operation.phase in ['failed', 'cancelled', 'rolled_back'] %}
                <div class="progress-bar w-100 bg-danger" id="automatic-progress"></div>
                {% elseif operation.phase == 'recovery_required' %}
                <div class="progress-bar w-100 bg-warning" id="automatic-progress"></div>
                {% else %}
                <div class="progress-bar progress-bar-indeterminate bg-primary" id="automatic-progress"></div>
                {% endif %}
            </div>

            <!-- Status Headline & Details -->
            <div class="status-box mb-3">
                <h2 id="automatic-status" role="status" class="h3 mb-2">{{ t('auto_update.phase.' ~ operation.phase) }}</h2>
                <p id="automatic-detail" class="text-secondary font-monospace small mb-0">
                    {% if operation.downloaded is defined %}{{ operation.downloaded|number_format(0, ',', '.') }} / {{ operation.size|number_format(0, ',', '.') }} {{ t('ui.bytes') }}{% endif %}
                </p>
                <progress id="automatic-download" class="progress progress-sm mt-2" max="{{ operation.size|default(0) }}" value="{{ operation.downloaded|default(0) }}" aria-label="{{ t('auto_update.step.download') }}"{% if operation.downloaded is not defined or not operation.size %} hidden{% endif %}></progress>
            </div>

            <!-- Error Box -->
            <p id="automatic-error" class="alert alert-danger d-flex align-items-center gap-2 text-start mt-3 mb-0"{% if operation.error is not defined %} hidden{% endif %}>
                {{ icons.icon('error') }}
                <span>{% if operation.error is defined %}{{ t('auto_update.error.' ~ operation.error) }}{% endif %}</span>
            </p>

            <p id="automatic-stalled" class="alert alert-warning d-flex align-items-center gap-2 text-start mt-3 mb-0" role="alert" hidden>
                {{ icons.icon('error') }}
                <span>{{ t('auto_update.stalled') }}</span>
            </p>

            {% if operation.phase not in ['idle','done','failed','cancelled','rolled_back'] %}
            <div class="mt-4 p-3 bg-light-subtle rounded border text-start">
                {% if operation.phase == 'recovery_required' %}
                <div class="d-flex align-items-start gap-2 small">
                    <span class="text-warning mt-1">{{ icons.icon('error') }}</span>
                    <div>
                        <strong>{{ t('auto_update.keep_open') }}</strong>
                        <div class="mt-1 text-secondary">{{ t('auto_update.recovery_hint') }}</div>
                    </div>
                </div>
                {% else %}
                <div class="d-flex align-items-start gap-2 text-secondary small">
                    <span class="spinner-border spinner-border-sm text-primary mt-1" role="status"></span>
                    <div>
                        <strong>{{ t('auto_update.keep_open') }}</strong>
                        <div class="mt-1">{{ operation.phase == 'rollback' ? t('auto_update.rolling_back_hint') : t('auto_update.automatic_hint') }}</div>
                    </div>
                </div>
                {% endif %}
            </div>

            {% if operation.probe_url is defined %}
            <div class="mt-3">
                <a href="{{ operation.probe_url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">{{ t('auto_update.probe') }}</a>
            </div>
            {% endif %}

            <div class="d-flex gap-2 justify-content-center mt-4">
                <form method="post" action="/settings/auto-update/step" id="automatic-step">
                    {{ csrf_field() }}
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1">
                        {{ icons.icon('arrow-forward') }}
                        <span>{{ t('auto_update.continue') }}</span>
                    </button>
                </form>
                <form method="post" action="/settings/auto-update/cancel">
                    {{ csrf_field() }}
                    <button type="submit" class="btn btn-outline-danger d-inline-flex align-items-center gap-1">
                        {{ icons.icon('error') }}
                        <span>{{ t('auto_update.cancel') }}</span>
                    </button>
                </form>
            </div>
            {% endif %}

            {% if operation.phase == 'done' %}
            <div class="mt-4">
                <a href="/settings" class="btn btn-success d-inline-flex align-items-center gap-2">
                    {{ icons.icon('check') }}
                    <span>{{ t('auto_update.settings_back') }}</span>
                </a>
            </div>
            {% endif %}
        </div>
    </section>

    <div class="text-center mt-3">
        <a href="/settings" class="text-secondary small d-inline-flex align-items-center gap-1">
            {{ icons.icon('arrow-back') }}
            <span>{{ t('auto_update.back') }}</span>
        </a>
    </div>

    <!-- Hidden Message Templates for JS -->
    <div id="automatic-messages" hidden>
        {% for phase in ['idle','manifest','signature','download','inspect','extract','waiting','backup','activate','verify','rollback','recovery_required','done','failed','cancelled','rolled_back'] %}
        <span data-phase="{{ phase }}">{{ t('auto_update.phase.' ~ phase) }}</span>
        {% endfor %}
        <span data-label="backup_rows">{{ t('auto_update.backup_rows') }}</span>
        {% for reason in ['signature','manifest','requirements','download','download_url','download_limit','range','checksum','archive','archive_limit','php','space','storage','schema','backup','backup_limit','restore_timeout','update','health','busy','state','signed_release','schema_pending','release_changed'] %}
        <span data-error="{{ reason }}">{{ t('auto_update.error.' ~ reason) }}</span>
        {% endfor %}
    </div>
</div></div>
{% endblock %}
{% block scripts %}<script src="{{ asset('auto-update.js') }}"></script>{% endblock %}
