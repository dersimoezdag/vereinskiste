{% extends 'layout.twig' %}
{% block title %}{{ t('bookings.edit.title') }} #{{ booking.id }}{% endblock %}
{% block content %}
<div class="flex flex-wrap justify-between items-center gap-2 mb-6">
    <h1 class="mb-0">{{ t('bookings.edit.title') }} #{{ booking.id }}</h1>
    <a class="btn" href="/bookings/{{ booking.id }}">{{ t('bookings.back_to_booking') }}</a>
</div>

<div class="panel">
    <div class="panel-body">
        <p class="text-muted">{{ t('bookings.edit.hint') }}</p>
        <form method="post" action="/bookings/{{ booking.id }}/edit" novalidate>
            {{ csrf_field() }}
            <input type="hidden" name="version" value="{{ version }}">
            {% include 'bookings/_fields.twig' %}
            {% include 'bookings/_reason.twig' %}
            <div class="mt-6 flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">{{ t('bookings.edit.submit') }}</button>
                <a class="btn" href="/bookings/{{ booking.id }}">{{ t('common.cancel') }}</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
