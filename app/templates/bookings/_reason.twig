{# Pflichtbegruendung fuer den Aenderungsverlauf. Erwartet: reason, errors; optional: reason_label, reason_id #}
{% set reason_id = reason_id ?? 'b-reason' %}
<div class="mt-4">
    <label class="label required" for="{{ reason_id }}">{{ t(reason_label ?? 'bookings.reason') }}</label>
    <textarea id="{{ reason_id }}" name="reason" rows="2" maxlength="500" required
              aria-describedby="{{ reason_id }}-help"
              class="input{% if errors.reason is defined %} is-invalid{% endif %}">{{ reason }}</textarea>
    {% if errors.reason is defined %}<div class="field-error">{{ t(errors.reason) }}</div>{% endif %}
    <div class="field-hint" id="{{ reason_id }}-help">{{ t('bookings.reason.help') }}</div>
</div>
