{% import 'components/help.twig' as help %}
            <div class="grid-12 gap-4">
                <div class="col-span-12">
                    <label class="label" for="b-contact">{{ t('foundation.contacts') }}</label>
                    <select class="input" id="b-contact" name="finance_contact_id">
                        <option value="">{{ t('bookings.choose') }}</option>
                        {% for contact in contacts|default([]) %}{% if contact.active or input.finance_contact_id|default('') == contact.id ~ '' %}
                        <option value="{{ contact.id }}"{% if input.finance_contact_id|default('') == contact.id ~ '' %} selected{% endif %}>{{ contact.name }}</option>
                        {% endif %}{% endfor %}
                    </select>
                    {% if errors.finance_contact_id is defined %}<p role="alert">{{ t(errors.finance_contact_id) }}</p>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="b-account">{{ t('bookings.account') }} {{ help.tip(t('ui.das_zugehoerige_vereinskonto_z_b_girokonto_oder_kasse')) }}</label>
                    <select id="b-account" name="account_id" required
                            class="input{% if errors.account_id is defined %} is-invalid{% endif %}">
                        <option value="">{{ t('bookings.choose') }}</option>
                        {% for account in accounts %}
                        <option value="{{ account.id }}"{% if input.account_id == (account.id ~ '') %} selected{% endif %}>{{ account.name }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.account_id is defined %}<div class="field-error">{{ t(errors.account_id) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="b-category">{{ t('bookings.category') }} {{ help.tip(t('ui.ordnet_die_buchung_einer_auswertungskategorie_bzw_einem_steuerlic')) }}</label>
                    <select id="b-category" name="category_id"
                            class="input{% if errors.category_id is defined %} is-invalid{% endif %}">
                        <option value="">{{ t('bookings.no_category') }}</option>
                        {% for category in categories %}
                        <option value="{{ category.id }}"{% if input.category_id == (category.id ~ '') %} selected{% endif %}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.category_id is defined %}<div class="field-error">{{ t(errors.category_id) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="b-event">{{ t('events.single') }}</label>
                    <select id="b-event" name="event_id" class="input{% if errors.event_id is defined %} is-invalid{% endif %}">
                        <option value="">{{ t('events.none') }}</option>
                        {% for event in events|default([]) %}
                        <option value="{{ event.id }}"{% if input.event_id|default('') == (event.id ~ '') %} selected{% endif %}>{{ event.title }} ({{ event.starts_on|date('d.m.Y') }})</option>
                        {% endfor %}
                    </select>
                    {% if errors.event_id is defined %}<div class="field-error">{{ t(errors.event_id) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="b-funding">{{ t('funding.single') }}</label>
                    <select id="b-funding" name="funding_id" class="input{% if errors.funding_id is defined %} is-invalid{% endif %}">
                        <option value="">{{ t('funding.none') }}</option>
                        {% for application in funding_applications|default([]) %}
                        <option value="{{ application.id }}"{% if input.funding_id|default('') == (application.id ~ '') %} selected{% endif %}>{{ application.title }} ({{ application.funder }})</option>
                        {% endfor %}
                    </select>
                    {% if errors.funding_id is defined %}<div class="field-error">{{ t(errors.funding_id) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-4">
                    <label class="label" for="b-date">{{ t('bookings.date') }}</label>
                    <input type="date" id="b-date" name="booking_date" required
                            class="input{% if errors.booking_date is defined %} is-invalid{% endif %}"
                            value="{{ input.booking_date }}">
                    {% if errors.booking_date is defined %}<div class="field-error">{{ t(errors.booking_date) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-4">
                    <label class="label" for="b-direction">{{ t('bookings.direction') }}</label>
                    <select id="b-direction" name="direction"
                            class="input{% if errors.direction is defined %} is-invalid{% endif %}">
                        <option value="in"{% if input.direction == 'in' %} selected{% endif %}>{{ t('bookings.direction.in') }}</option>
                        <option value="out"{% if input.direction == 'out' %} selected{% endif %}>{{ t('bookings.direction.out') }}</option>
                    </select>
                    {% if errors.direction is defined %}<div class="field-error">{{ t(errors.direction) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-4">
                    <label class="label" for="b-amount">{{ t('bookings.amount_eur') }}</label>
                    <input type="text" inputmode="decimal" id="b-amount" name="amount" data-mask="signed_amount" data-sign-select="b-direction" required
                            class="input{% if errors.amount is defined %} is-invalid{% endif %}"
                            value="{{ input.amount }}">
                    {% if errors.amount is defined %}<div class="field-error">{{ t(errors.amount) }}</div>{% endif %}
                </div>
                <div class="col-span-12">
                    <label class="label" for="b-description">{{ t('bookings.description') }}</label>
                    <input type="text" id="b-description" name="description" maxlength="500"{% if not (description_optional ?? false) %} required{% endif %}
                            class="input{% if errors.description is defined %} is-invalid{% endif %}"
                            value="{{ input.description }}">
                    {% if errors.description is defined %}<div class="field-error">{{ t(errors.description) }}</div>{% endif %}
                    {% if description_optional ?? false %}<div class="field-hint">{{ t('bookings.correction.description_help') }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="b-counterparty">{{ t('bookings.counterparty') }}</label>
                    <input type="text" id="b-counterparty" name="counterparty" maxlength="200"
                            class="input{% if errors.counterparty is defined %} is-invalid{% endif %}"
                            value="{{ input.counterparty }}">
                    {% if errors.counterparty is defined %}<div class="field-error">{{ t(errors.counterparty) }}</div>{% endif %}
                </div>
                <div class="col-span-12 md:col-span-6">
                    <label class="label" for="b-receipt-no">{{ t('bookings.receipt_no') }} {{ help.tip(t('ui.gobd_grundsatz_keine_buchung_ohne_beleg_eindeutige_nummer_zur_sch')) }}</label>
                    <input type="text" id="b-receipt-no" name="receipt_no" maxlength="100"
                            class="input{% if errors.receipt_no is defined %} is-invalid{% endif %}"
                            value="{{ input.receipt_no }}">
                    {% if errors.receipt_no is defined %}<div class="field-error">{{ t(errors.receipt_no) }}</div>{% endif %}
                </div>
            </div>
