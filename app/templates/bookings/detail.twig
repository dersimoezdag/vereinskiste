{% extends 'layout.twig' %}
{% import 'components/help.twig' as help %}
{% block title %}{{ t('bookings.detail') }} #{{ booking.id }}{% endblock %}
{% block content %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">{{ t('bookings.detail') }} #{{ booking.id }}</h1>
    <div class="d-flex flex-wrap gap-2">
        {% if can('bookings.write') and booking.kind != 'transfer' and booking.status == 'active' %}
        <a class="btn btn-primary" href="/bookings/{{ booking.id }}/edit">{{ t('bookings.edit') }}</a>
        {% endif %}
        {% if can('bookings.write') %}
        <a class="btn" href="/corrections/new?of={{ booking.id }}">{{ t('bookings.correction.of_this') }}</a>
        {% endif %}
        <a class="btn" href="/bookings">{{ t('bookings.back') }}</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">{{ t('bookings.date') }}</dt>
            <dd class="col-sm-8">{{ booking.booking_date|date('d.m.Y') }}</dd>

            <dt class="col-sm-4">{{ t('bookings.amount') }}</dt>
            <dd class="col-sm-8 {{ booking.direction == 'in' ? 'text-success' : 'text-danger' }}">
                {{ (booking.direction == 'in' ? '+' : '−') ~ (booking.amount|eur) }}
                ({{ t('bookings.direction.' ~ booking.direction) }})
            </dd>

            <dt class="col-sm-4">{{ t('bookings.description') }}</dt>
            <dd class="col-sm-8">{{ booking.description }}</dd>

            <dt class="col-sm-4">{{ t('bookings.account') }}</dt>
            <dd class="col-sm-8">{{ booking.account_name }}</dd>

            <dt class="col-sm-4">{{ t('bookings.category') }}</dt>
            <dd class="col-sm-8">{{ booking.category_name ?? '–' }}</dd>

            <dt class="col-sm-4">{{ t('bookings.counterparty') }}</dt>
            <dd class="col-sm-8">{{ booking.counterparty ?? '–' }}</dd>

            <dt class="col-sm-4">{{ t('bookings.receipt_no') }}</dt>
            <dd class="col-sm-8">{{ booking.receipt_no ?? '–' }}</dd>

            <dt class="col-sm-4">{{ t('bookings.kind') }} {{ help.tip('Buchungsart: Reguläre Buchung, Geldtransit/Umbuchung zwischen Konten oder GoBD-Korrekturbuchung.') }}</dt>
            <dd class="col-sm-8">{{ t('bookings.kind.' ~ booking.kind) }}</dd>

            {% if original %}
            <dt class="col-sm-4">{{ t('bookings.correction.original') }}</dt>
            <dd class="col-sm-8"><a href="/bookings/{{ original.id }}">#{{ original.id }} {{ original.description }}</a></dd>
            {% endif %}

            {% for leg in counterparts %}
            <dt class="col-sm-4">{{ t('bookings.transfer.counterpart') }}</dt>
            <dd class="col-sm-8">
                <a href="/bookings/{{ leg.id }}">#{{ leg.id }}</a>
                {{ leg.account_name }} ({{ t('bookings.direction.' ~ leg.direction) }})
            </dd>
            {% endfor %}

            <dt class="col-sm-4">{{ t('bookings.status') }}</dt>
            <dd class="col-sm-8">{{ t('bookings.status.' ~ booking.status) }}</dd>

            <dt class="col-sm-4">{{ t('bookings.created') }}</dt>
            <dd class="col-sm-8">{{ booking.created_at|date('d.m.Y H:i') }} · {{ booking.created_by_name }}</dd>

            <dt class="col-sm-4">{{ t('bookings.version') }} {{ help.tip('Revisionsnummer zur Vermeidung von Konflikten bei gleichzeitiger Bearbeitung.') }}</dt>
            <dd class="col-sm-8">{{ booking.version }}</dd>
        </dl>
    </div>
</div>

{% if can('bookings.write') %}
{% set action = booking.status == 'active' ? 'cancel' : 'restore' %}
<div class="card mb-4">
    <div class="card-header"><h2 class="card-title">{{ t('bookings.' ~ action ~ '.title') }} {{ help.tip('GoBD-Storno: Buchungen werden nicht gelöscht, sondern revisionssicher als storniert markiert.') }}</h2></div>
    <div class="card-body">
        {% include 'bookings/_status_form.twig' with {action: action, version: booking.version, reason: '', errors: {}} %}
    </div>
</div>
{% endif %}

{% include 'receipts/_list.twig' %}

{% include 'bookings/_history.twig' %}
{% endblock %}
