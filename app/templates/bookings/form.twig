{% extends 'layout.twig' %}
{% block title %}{{ t('bookings.new') }}{% endblock %}
{% block content %}
<h1 class="mb-4">{{ t('bookings.new') }}</h1>

<div class="card">
    <div class="card-body">
        <form method="post" action="/bookings/new" enctype="multipart/form-data" novalidate>
            {{ csrf_field() }}
            {% include 'bookings/_fields.twig' %}
            <h2 class="card-title mt-4">{{ t('receipts.optional') }}</h2>
            {% include 'receipts/_input.twig' with {id_prefix: 'b-receipt'} %}
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">{{ t('bookings.create') }}</button>
                <a class="btn" href="/bookings">{{ t('common.cancel') }}</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
