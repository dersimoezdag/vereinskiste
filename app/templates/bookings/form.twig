{% extends 'layout.twig' %}
{% block title %}{{ t('bookings.new') }}{% endblock %}
{% block content %}
<h1 class="mb-6">{{ t('bookings.new') }}</h1>

<div class="panel">
    <div class="panel-body">
        <form method="post" action="/bookings/new" enctype="multipart/form-data" novalidate>
            {{ csrf_field() }}
            {% include 'bookings/_fields.twig' %}
            <h2 class="panel-title mt-6">{{ t('receipts.optional') }}</h2>
            {% include 'receipts/_dropzone.twig' with {id_prefix: 'b-receipt', errors: errors|default({})} %}
            <div class="mt-6 flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">{{ t('bookings.create') }}</button>
                <a class="btn" href="/bookings">{{ t('common.cancel') }}</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
