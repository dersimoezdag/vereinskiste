{# Belegdatei waehlen oder direkt mit der Handykamera aufnehmen (zwei Felder, es zaehlt das ausgefuellte).
   Erwartet: id_prefix; optional: errors #}
<div class="mb-3">
    <label class="form-label" for="{{ id_prefix }}-file">{{ t('receipts.file') }}</label>
    <input type="file" id="{{ id_prefix }}-file" name="receipt" accept="image/jpeg,image/png,application/pdf"
           class="form-control{% if errors.receipt is defined %} is-invalid{% endif %}" style="min-height: 44px">
    {% if errors.receipt is defined %}<div class="invalid-feedback">{{ t(errors.receipt) }}</div>{% endif %}
</div>
<div class="mb-3">
    <label class="form-label" for="{{ id_prefix }}-camera">{{ t('receipts.camera') }}</label>
    <input type="file" id="{{ id_prefix }}-camera" name="receipt_camera" accept="image/jpeg,image/png" capture="environment"
           class="form-control" style="min-height: 44px">
</div>
<div class="form-hint mb-3">{{ t('receipts.help') }}</div>
