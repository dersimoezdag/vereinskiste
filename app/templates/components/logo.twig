{# Logo passend zum Farbschema (helle bzw. dunkle Variante, per CSS umgeschaltet). Erwartet: size; optional: class, alt #}
<img src="{{ asset('logo.svg') }}" alt="{{ alt ?? '' }}" width="{{ size }}" height="{{ size }}" class="brand-logo-light {{ class ?? '' }}">
<img src="{{ asset('logo-dark.svg') }}" alt="{{ alt ?? '' }}" width="{{ size }}" height="{{ size }}" class="brand-logo-dark {{ class ?? '' }}">
