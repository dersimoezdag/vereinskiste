{% set master_path = current_path() %}
<nav class="tabs mb-4" aria-label="{{ t('finance.master_data') }}">
    <a class="tab{% if master_path starts with '/accounts' %} active{% endif %}" href="/accounts">{{ t('nav.accounts') }}</a>
    <a class="tab{% if master_path starts with '/categories' %} active{% endif %}" href="/categories">{{ t('nav.categories') }}</a>
    {% if can('contacts.read') %}<a class="tab{% if master_path starts with '/contacts' %} active{% endif %}" href="/contacts">{{ t('foundation.contacts') }}</a>{% endif %}
</nav>
