<details class="theme-picker" data-theme-picker>
    <summary class="theme-picker-trigger" aria-label="Darstellung wählen" title="Darstellung wählen">
        <span data-theme-icon="light" hidden><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></span>
        <span data-theme-icon="dark" hidden>{{ icons.icon('dark-mode') }}</span>
        <span data-theme-icon="system"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg></span>
    </summary>
    <fieldset class="theme-picker-menu">
        <legend>Darstellung</legend>
        {% for value, label in {'light': 'Hell', 'dark': 'Dunkel', 'system': 'System'} %}
        <label class="theme-picker-option"><input type="radio" name="theme-choice" value="{{ value }}" data-theme-choice {% if value == 'system' %}checked{% endif %}><span>{{ label }}</span></label>
        {% endfor %}
    </fieldset>
</details>
