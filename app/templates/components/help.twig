{# Reusable Info-Button Tooltip Macro.
   Verwendung:
   {% import 'components/help.twig' as help %}
   {{ help.tip(t('common.hint')) }}
#}
{% macro tip(text, placement = 'top') %}
{% import 'components/icons.twig' as icons %}
<button type="button" class="help-tooltip-btn info-button" data-bs-toggle="tooltip" data-bs-placement="{{ placement }}" data-bs-html="true" data-bs-title="{{ text|e('html_attr') }}" role="button" tabindex="0" aria-label="{{ t('common.hint') }}: {{ text|e('html_attr') }}">{{ icons.icon('info') }}</button>
{% endmacro %}
