{% import 'components/icons.twig' as icons %}
{% set nameParts = user.name|trim|split(' ') %}
<div class="user-card">
    <button type="button" class="flex w-full items-center gap-3 rounded-xl border border-line bg-canvas p-2.5 text-left text-ink transition hover:bg-subtle [&.show]:bg-subtle"
            popovertarget="user-card-actions" aria-expanded="false" aria-label="{{ t('nav.usermenu') }}: {{ user.name }}" aria-controls="user-card-actions">
        <span class="avatar" aria-hidden="true">{{ (nameParts|first|slice(0, 1) ~ (nameParts|length > 1 ? nameParts|last|slice(0, 1) : ''))|upper }}</span>
        <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold">{{ user.name }}</span>
            <span class="block truncate text-xs text-muted">{% for role in user.roles %}{{ t('users.role.' ~ role) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
        </span>
        <span class="text-muted [&_.icon]:size-[1.125rem]">{{ icons.icon('chevron-up') }}</span>
    </button>
    <div class="menu" id="user-card-actions" popover data-placement="top" data-align="stretch">
        <div class="menu-header">{{ t('nav.usermenu') }}</div>
        <a class="menu-item" href="/account/password">{{ icons.icon('password') }}{{ t('nav.password') }}</a>
        <div class="menu-divider"></div>
        <form method="post" action="/logout" class="m-0">
            {{ csrf_field() }}
            <button type="submit" class="menu-item">{{ icons.icon('logout') }}{{ t('nav.logout') }}</button>
        </form>
    </div>
</div>
