{# Obere Leiste: Brotkrumen (Bereich > Seite) links, Farbschema-Umschalter rechts. Erwartet: path, icons #}
{% set segs = path|split('/') %}
{% set cash = {'label': t('nav.cashbook'), 'url': '/bookings'} %}
{% set members_group = {'label': t('nav.members'), 'url': '/members'} %}
{% set settings = {'label': t('nav.settings'), 'url': '/settings'} %}
{% set crumbs = [] %}
{% if path == '/' %}
    {% set crumbs = [{'label': t('nav.home')}] %}
{% elseif path == '/dashboard/preferences' %}
    {% set crumbs = [{'label': t('home.customize')}] %}
{% elseif path == '/bookings' %}
    {% set crumbs = [cash, {'label': t('nav.bookings')}] %}
{% elseif path == '/bookings/new' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': 'Neu'}] %}
{% elseif path matches '#^/bookings/\\d+/edit$#' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': 'Buchung', 'url': '/bookings/' ~ segs[2]}, {'label': 'Bearbeiten'}] %}
{% elseif path starts with '/bookings' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': 'Buchung'}] %}
{% elseif path starts with '/transfers' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': 'Umbuchung'}] %}
{% elseif path starts with '/corrections' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': 'Korrektur'}] %}
{% elseif path == '/accounts' %}
    {% set crumbs = [cash, {'label': t('nav.accounts')}] %}
{% elseif path starts with '/accounts' %}
    {% set crumbs = [cash, {'label': t('nav.accounts'), 'url': '/accounts'}, {'label': t('foundation.bank')}] %}
{% elseif path starts with '/categories' %}
    {% set crumbs = [cash, {'label': t('nav.categories')}] %}
{% elseif path == '/imports/bank' %}
    {% set crumbs = [cash, {'label': 'Kontoauszug-Import'}] %}
{% elseif path starts with '/imports' %}
    {% set crumbs = [cash, {'label': 'Kontoauszug-Import', 'url': '/imports/bank'}, {'label': path ends with '/new' ? 'Neuer Import' : 'Import'}] %}
{% elseif path == '/invoices' %}
    {% set crumbs = [cash, {'label': t('invoices.title')}] %}
{% elseif path starts with '/invoices' %}
    {% set crumbs = [cash, {'label': t('invoices.title'), 'url': '/invoices'}, {'label': path == '/invoices/import' ? 'Import' : 'Rechnung'}] %}
{% elseif path == '/contacts' %}
    {% set crumbs = [cash, {'label': t('foundation.contacts')}] %}
{% elseif path starts with '/contacts' %}
    {% set crumbs = [cash, {'label': t('foundation.contacts'), 'url': '/contacts'}, {'label': path == '/contacts/new' ? 'Neu' : 'Kontakt'}] %}
{% elseif path starts with '/settings/closing' %}
    {% set crumbs = [cash, {'label': t('nav.closing')}] %}
{% elseif path starts with '/reports' %}
    {% set crumbs = [{'label': t('nav.reports'), 'url': '/reports/summary'}, {'label': path == '/reports/dashboard' ? t('reports.tab.dashboard') : t('reports.tab.summary')}] %}
{% elseif path == '/members' %}
    {% set crumbs = [members_group, {'label': t('members.list')}] %}
{% elseif path == '/members/applications' %}
    {% set crumbs = [members_group, {'label': t('applications.tab_applications')}] %}
{% elseif path starts with '/members' %}
    {% set crumbs = [members_group, {'label': path == '/members/new' ? 'Neu' : 'Mitglied'}] %}
{% elseif path == '/settings/club-roles' %}
    {% set crumbs = [members_group, {'label': t('nav.club_roles')}] %}
{% elseif path == '/settings' %}
    {% set crumbs = [{'label': t('nav.settings')}] %}
{% elseif path == '/settings/email' %}
    {% set crumbs = [settings, {'label': t('mail.settings.title')}] %}
{% elseif path == '/settings/club' %}
    {% set crumbs = [settings, {'label': t('foundation.club')}] %}
{% elseif path == '/audit-log' %}
    {% set crumbs = [settings, {'label': t('nav.audit')}] %}
{% elseif path == '/update' %}
    {% set crumbs = [settings, {'label': 'Aktualisierung'}] %}
{% elseif path == '/users' %}
    {% set crumbs = [settings, {'label': t('settings.users')}] %}
{% elseif path starts with '/users' %}
    {% set crumbs = [settings, {'label': t('settings.users'), 'url': '/users'}, {'label': path ends with '/new' ? 'Neu' : 'Bearbeiten'}] %}
{% elseif path starts with '/settings' %}
    {% set crumbs = [{'label': t('nav.settings')}] %}
{% elseif path starts with '/account/password' %}
    {% set crumbs = [{'label': t('nav.password')}] %}
{% endif %}
<header class="topbar">
    <div class="container-xl topbar-inner">
        <nav class="topbar-crumbs" aria-label="Brotkrumen">
            <ol class="breadcrumb">
                {% if path != '/' %}
                <li class="breadcrumb-item"><a href="/" aria-label="{{ t('nav.home') }}" title="{{ t('nav.home') }}">{{ icons.icon('home') }}</a></li>
                {% endif %}
                {% for crumb in crumbs %}
                    {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page"><span class="breadcrumb-label">{{ crumb.label }}</span></li>
                    {% elseif crumb.url is defined %}
                    <li class="breadcrumb-item"><a href="{{ crumb.url }}">{{ crumb.label }}</a></li>
                    {% else %}
                    <li class="breadcrumb-item"><span class="breadcrumb-label">{{ crumb.label }}</span></li>
                    {% endif %}
                {% endfor %}
            </ol>
        </nav>
        {% include 'components/theme-picker.twig' %}
    </div>
</header>
