{# Obere Leiste: Brotkrumen (Bereich > Seite) links, Farbschema-Umschalter rechts. Erwartet: path #}
{% import 'components/icons.twig' as icons %}
{% set segs = path|split('/') %}
{% set cash = {'label': t('nav.cashbook'), 'url': '/cashbook'} %}
{% set members_group = {'label': t('nav.members'), 'url': '/members'} %}
{% set settings = {'label': t('nav.settings'), 'url': '/settings'} %}
{% set crumbs = [] %}
{% if path == '/' %}
    {% set crumbs = [{'label': t('nav.home')}] %}
{% elseif path == '/dashboard/preferences' %}
    {% set crumbs = [{'label': t('home.customize')}] %}
{% elseif path == '/bookings' %}
    {% set crumbs = [cash, {'label': t('nav.bookings')}] %}
{% elseif path == '/bookings/new' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': t('ui.breadcrumb_neu')}] %}
{% elseif path matches '#^/bookings/\\d+/edit$#' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': t('ui.breadcrumb_buchung'), 'url': '/bookings/' ~ segs[2]}, {'label': t('ui.breadcrumb_bearbeiten')}] %}
{% elseif path starts with '/bookings' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': t('ui.breadcrumb_buchung')}] %}
{% elseif path starts with '/transfers' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': t('ui.breadcrumb_umbuchung')}] %}
{% elseif path starts with '/corrections' %}
    {% set crumbs = [cash, {'label': t('nav.bookings'), 'url': '/bookings'}, {'label': t('ui.breadcrumb_korrektur')}] %}
{% elseif path == '/accounts' %}
    {% set crumbs = [cash, {'label': t('nav.accounts')}] %}
{% elseif path starts with '/accounts' %}
    {% set crumbs = [cash, {'label': t('nav.accounts'), 'url': '/accounts'}, {'label': t('foundation.bank')}] %}
{% elseif path starts with '/categories' %}
    {% set crumbs = [cash, {'label': t('nav.categories')}] %}
{% elseif path == '/expenses' %}
    {% set crumbs = [cash, {'label': t('expenses.title')}] %}
{% elseif path starts with '/expenses' %}
    {% set crumbs = [cash, {'label': t('expenses.title'), 'url': '/expenses'}, {'label': t('expenses.single')}] %}
{% elseif path == '/cashbook' %}
    {% set crumbs = [{'label': t('nav.cashbook')}] %}
{% elseif path == '/events' %}
    {% set crumbs = [{'label': t('events.title')}] %}
{% elseif path starts with '/events' %}
    {% set crumbs = [{'label': t('events.title'), 'url': '/events'}, {'label': t('events.single')}] %}
{% elseif path == '/funding' %}
    {% set crumbs = [{'label': t('funding.title')}] %}
{% elseif path starts with '/funding' %}
    {% set crumbs = [{'label': t('funding.title'), 'url': '/funding'}, {'label': t('funding.single')}] %}
{% elseif path starts with '/imports/bookings' %}
    {% set crumbs = [cash, {'label': t('booking_import.title')}] %}
{% elseif path == '/imports/bank' %}
    {% set crumbs = [cash, {'label': t('ui.breadcrumb_kontoauszug_import')}] %}
{% elseif path starts with '/imports' %}
    {% set crumbs = [cash, {'label': t('ui.breadcrumb_kontoauszug_import'), 'url': '/imports/bank'}, {'label': path ends with '/new' ? t('ui.breadcrumb_neuer_import') : t('ui.breadcrumb_import')}] %}
{% elseif path == '/invoices' %}
    {% set crumbs = [cash, {'label': t('finance.documents')}] %}
{% elseif path starts with '/invoices' %}
    {% set crumbs = [cash, {'label': t('finance.documents'), 'url': '/invoices'}, {'label': path == '/invoices/import' ? t('ui.breadcrumb_import') : t('ui.breadcrumb_rechnung')}] %}
{% elseif path == '/contacts' %}
    {% set crumbs = [cash, {'label': t('foundation.contacts')}] %}
{% elseif path starts with '/contacts' %}
    {% set crumbs = [cash, {'label': t('foundation.contacts'), 'url': '/contacts'}, {'label': path == '/contacts/new' ? t('ui.breadcrumb_neu') : t('ui.breadcrumb_kontakt')}] %}
{% elseif path starts with '/reports' %}
    {% set crumbs = [{'label': t('nav.reports'), 'url': '/reports/summary'}, {'label': path == '/reports/dashboard' ? t('reports.tab.dashboard') : t('reports.tab.summary')}] %}
{% elseif path == '/members' %}
    {% set crumbs = [members_group, {'label': t('members.list')}] %}
{% elseif path starts with '/members/invites' %}
    {% set crumbs = [members_group, {'label': t('applications.invites.title')}] %}
{% elseif path == '/members/applications' %}
    {% set crumbs = [members_group, {'label': t('applications.title')}] %}
{% elseif path starts with '/members' %}
    {% set crumbs = [members_group, {'label': path == '/members/new' ? t('ui.breadcrumb_neu') : t('ui.breadcrumb_mitglied')}] %}
{% elseif settings_navigation.is_settings %}
    {% set crumbs = [settings] %}
{% elseif path starts with '/account/password' %}
    {% set crumbs = [{'label': t('nav.password')}] %}
{% endif %}
{% if settings_navigation.is_settings and settings_navigation.current %}
    {% set selected = settings_navigation.current.tabs|filter(tab => tab.active)|first %}
    {% set crumbs = [settings, {'label': t(settings_navigation.current.label)}] %}
    {% if selected and selected.label != settings_navigation.current.label %}
        {% set crumbs = crumbs|merge([{'label': t(selected.label)}]) %}
    {% endif %}
{% endif %}
<header class="border-b border-line bg-surface/85 backdrop-blur lg:sticky lg:top-0 lg:z-20">
    <div class="mx-auto flex min-h-14 w-full max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <nav class="min-w-0 flex-1" aria-label="{{ t('ui.brotkrumen') }}">
            <ol class="breadcrumb">
                {% if path != '/' %}
                <li class="breadcrumb-item"><a href="/" aria-label="{{ t('nav.home') }}" title="{{ t('nav.home') }}">{{ icons.icon('home') }}</a></li>
                {% endif %}
                {% for crumb in crumbs %}
                    {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page"><span class="breadcrumb-label">{{ crumb.label }}</span></li>
                    {% elseif crumb.url is defined %}
                    <li class="breadcrumb-item"><a href="{{ crumb.url }}">{{ crumb.label }}</a></li>
                    {% else %}
                    <li class="breadcrumb-item"><span class="breadcrumb-label">{{ crumb.label }}</span></li>
                    {% endif %}
                {% endfor %}
            </ol>
        </nav>
        {% include 'components/theme-picker.twig' %}
    </div>
</header>
