{% set navigation = settings_navigation(current_path()) %}
{% if navigation.current %}
<h1 class="mb-4">{{ t(navigation.current.label) }}</h1>
{% set tabs = navigation.current.tabs|filter(tab => can(tab.right)) %}
{% if tabs|length > 1 %}
<nav class="tabs mb-6" aria-label="{{ t(navigation.current.label) }}">
    {% for tab in tabs %}
    <a class="tab{% if tab.active %} active{% endif %}" href="{{ tab.url }}"{% if tab.active %} aria-current="page"{% endif %}>{{ t(tab.label) }}</a>
    {% endfor %}
</nav>
{% endif %}
{% endif %}
