{% set settings_path = current_path() %}
<nav class="nav nav-tabs mb-4" aria-label="{{ t('nav.settings') }}">
    {% for tab in [
        {'url': '/settings', 'label': 'settings.version_updates', 'active': settings_path in ['/settings', '/update', '/settings/update']},
        {'url': '/settings/closing', 'label': 'nav.closing', 'active': settings_path == '/settings/closing'},
        {'url': '/audit-log', 'label': 'nav.audit', 'active': settings_path == '/audit-log'}
    ] %}
    <a class="nav-link{% if tab.active %} active{% endif %}" href="{{ tab.url }}"{% if tab.active %} aria-current="page"{% endif %}>{{ t(tab.label) }}</a>
    {% endfor %}
</nav>
