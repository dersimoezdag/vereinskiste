{% for field, limit in fields %}
<div class="mb-4">
    <label class="label" for="field-{{ field }}">{{ t('foundation.field.' ~ field) }}</label>
    {% if field == 'locale' %}
    <select class="input" id="field-locale" name="locale"><option value="de">{{ t('language.de') }}</option></select>
    {% else %}
    <input class="input{% if errors[field] is defined %} is-invalid{% endif %}" id="field-{{ field }}"
           name="{{ field }}" type="{{ field == 'email' ? 'email' : (field == 'phone' ? 'tel' : (field ends with '_url' ? 'url' : 'text')) }}"
           maxlength="{{ limit }}" value="{{ input[field]|default('') }}"{% if field == 'name' %} required{% endif %}>
    {% endif %}
    {% if errors[field] is defined %}<div class="field-error">{{ t(errors[field]) }}</div>{% endif %}
</div>
{% endfor %}
{% if reason_required|default(true) %}
<div class="mb-4">
    <label class="label" for="change-reason">{{ t('bookings.reason') }}</label>
    <input class="input{% if errors.reason is defined %} is-invalid{% endif %}" id="change-reason"
           name="reason" maxlength="500" required value="{{ reason|default(input.reason|default('')) }}">
    {% if errors.reason is defined %}<div class="field-error">{{ t(errors.reason) }}</div>{% endif %}
</div>
{% endif %}
{% if errors.version is defined %}<p class="alert alert-warning" role="alert">{{ t(errors.version) }}</p>{% endif %}
