{% extends 'layout.twig' %}
{% block content %}
<h1>{{ t('invoices.title') }}</h1>
{% if can('invoices.write') %}<div class="d-flex gap-2 mb-3"><a class="btn btn-primary" href="/invoices/import">{{ t('invoices.import') }}</a><a class="btn" href="/invoices/new">{{ t('invoices.new') }}</a></div>{% endif %}
<p>{{ t('invoices.no_payment') }}</p>
<form class="card card-body mb-3" method="get" action="/invoices"><div class="row g-2"><div class="col-md-6"><label class="form-label" for="invoice-q">{{ t('common.search') }}</label><input class="form-control" id="invoice-q" name="q" value="{{ search }}" maxlength="100"></div><div class="col-md-4"><label class="form-label" for="invoice-state">{{ t('privacy.field.status') }}</label><select class="form-select" id="invoice-state" name="state">{% for key in ['all','draft','reviewed','overdue','cancelled'] %}<option value="{{ key }}"{% if state==key %} selected{% endif %}>{{ t('invoices.status.' ~ key) }}</option>{% endfor %}</select></div><div class="col-md-2 align-self-end"><button class="btn">{{ t('common.search') }}</button></div></div></form>
<div class="card table-responsive"><table class="table"><thead><tr><th>{{ t('invoices.field.number') }}</th><th>{{ t('invoices.field.supplier_name') }}</th><th>{{ t('invoices.field.invoice_date') }}</th><th>{{ t('invoices.field.gross') }}</th><th>{{ t('privacy.field.status') }}</th></tr></thead><tbody>
{% for invoice in invoices %}<tr><td><a href="/invoices/{{ invoice.id }}">{{ invoice.number ?: '#' ~ invoice.id }}</a></td><td>{{ invoice.supplier_name }}</td><td>{{ invoice.invoice_date ? invoice.invoice_date|date('d.m.Y') : '–' }}</td><td>{{ invoice.gross ? invoice.gross|eur : '–' }}</td><td>{{ t('invoices.status.' ~ invoice.status) }}</td></tr>{% else %}<tr><td colspan="5">{{ t('invoices.empty') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="d-flex gap-2 mt-3">{% if page>1 %}<a class="btn" href="/invoices?page={{ page-1 }}&amp;state={{ state|url_encode }}&amp;q={{ search|url_encode }}">{{ t('common.previous') }}</a>{% endif %}{% if invoices|length==50 %}<a class="btn" href="/invoices?page={{ page+1 }}&amp;state={{ state|url_encode }}&amp;q={{ search|url_encode }}">{{ t('common.next') }}</a>{% endif %}</div>
{% endblock %}
