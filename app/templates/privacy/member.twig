{% extends 'layout.twig' %}
{% block title %}{{ t('privacy.title') ~ ' | ' ~ member.name }}{% endblock %}
{% block content %}
<h1>{{ member.name }} · {{ t('privacy.title') }}</h1>
<div class="mb-4 flex gap-2"><a class="btn" href="/members/{{ member.id }}">{{ t('common.back') }}</a><a class="btn btn-primary" href="/members/{{ member.id }}/disclosure.json">{{ t('privacy.disclosure') }}</a></div>
{% for error in errors %}<p class="alert alert-danger" role="alert">{{ t(error) }}</p>{% endfor %}
<div class="panel panel-body mb-4"><h2>{{ t('privacy.consents') }}</h2>
{% if not member.anonymized_at %}
<form action="/members/{{ member.id }}/consents" method="post" class="grid-12 gap-2 mb-4">
{{ csrf_field() }}
<div class="col-span-12 md:col-span-3"><label class="label" for="consent-kind">{{ t('privacy.field.kind') }}</label><select id="consent-kind" name="kind" class="input">{% for kind in kinds|filter(k => k != 'declaration') %}<option value="{{ kind }}">{{ t('privacy.consent.' ~ kind) }}</option>{% endfor %}{% if declarations is not empty %}<option value="declaration">{{ t('privacy.consent.declaration') }}</option>{% endif %}</select>
{% if declarations is not empty %}<label class="label mt-2" for="consent-declaration">{{ t('declarations.title') }}</label><select id="consent-declaration" name="declaration_id" class="input">{% for d in declarations %}<option value="{{ d.id }}">{{ d.title }}</option>{% endfor %}</select>{% endif %}</div>
<div class="col-span-12 md:col-span-3"><label class="label" for="consent-granted">{{ t('privacy.field.status') }}</label><select id="consent-granted" name="granted" class="input"><option value="1">{{ t('privacy.granted') }}</option><option value="0">{{ t('privacy.withdrawn') }}</option></select></div>
<div class="col-span-12 md:col-span-3"><label class="label" for="consent-version">{{ t('privacy.field.document_version') }}</label><input id="consent-version" class="input" name="document_version" maxlength="100"></div>
<div class="col-span-12 md:col-span-3"><label class="label" for="consent-reason">{{ t('bookings.reason') }}</label><input id="consent-reason" class="input" name="reason" maxlength="500" required></div>
<div class="col-span-12"><button class="btn btn-primary">{{ t('common.save') }}</button></div></form>
{% endif %}
<p class="text-muted">{{ t('privacy.consent.explanation') }}</p>
<div class="table-scroll"><table class="data-table"><thead><tr><th>{{ t('privacy.field.kind') }}</th><th>{{ t('privacy.field.status') }}</th><th>{{ t('privacy.field.document_version') }}</th><th>{{ t('privacy.field.recorded_at') }}</th></tr></thead><tbody>
{% for consent in consents %}<tr><td>{{ consent.kind == 'declaration' ? consent.snapshot.title|default(t('privacy.consent.declaration')) : t('privacy.consent.' ~ consent.kind) }}</td><td>{{ t(consent.granted ? 'privacy.granted' : 'privacy.withdrawn') }}</td><td>{{ consent.document_version }}<details><summary>{{ t('privacy.snapshot') }}</summary><p>{{ consent.snapshot.text|default('') }}</p><p>{{ consent.snapshot.url|default('') }}</p><code>{{ consent.snapshot_hash }}</code></details></td><td>{{ consent.recorded_at|date('d.m.Y H:i') }} · {{ t('privacy.source.' ~ consent.source) }}</td></tr>{% else %}<tr><td colspan="4">{{ t('privacy.no_consents') }}</td></tr>{% endfor %}
</tbody></table></div></div>
<div class="panel panel-body"><h2>{{ t('privacy.anonymize') }}</h2>
<p>{{ t('privacy.anonymize.explanation') }}</p>
<ul>{% for key,count in preview.counts %}<li>{{ t('privacy.count.' ~ key) }}: {{ count }}</li>{% endfor %}</ul>
<p>{{ t('privacy.anonymize.retained') }}</p>
{% if preview.eligible %}<p>{{ t('privacy.eligible') }}: {{ preview.eligible|date('d.m.Y') }}</p>{% endif %}
{% for block in preview.blocked %}<p class="alert alert-warning">{{ t(block) }}</p>{% endfor %}
{% if preview.blocked is empty %}
<form method="post" action="/members/{{ member.id }}/anonymize">{{ csrf_field() }}<input type="hidden" name="version" value="{{ member.version }}"><input type="hidden" name="fingerprint" value="{{ preview.fingerprint }}">
<label class="label" for="anonymize-reason">{{ t('privacy.anonymize.reason') }}</label><input class="input mb-4" id="anonymize-reason" name="reason" required maxlength="500">
<label class="check mb-4"><input type="checkbox" class="check-input" name="confirmed" value="1" required><span class="check-label">{{ t('privacy.anonymize.confirm') }}</span></label>
<button class="btn btn-danger">{{ t('privacy.anonymize') }}</button></form>{% endif %}
</div>
{% endblock %}
