{% import 'components/icons.twig' as icons %}
{% if key == 'cards' %}
<section class="card dashboard-card" data-dashboard-item data-dashboard-id="{{ id }}">
    <input type="hidden" name="cards[]" value="{{ id }}">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h2 class="card-title"><a href="{{ item.url }}">{{ icons.icon(item.icon) }} {{ t(item.label) }}</a></h2>
            {% include 'dashboard/controls.twig' with {label: t(item.label), removable: true} %}
        </div>
        <div class="dashboard-value">{{ metric.value }}</div>
        <p class="text-muted mb-0">{{ metric.description }}</p>
        {% if metric.details is defined %}<dl class="dashboard-details">{% for label, value in metric.details %}<div><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>{% endif %}
    </div>
</section>
{% else %}
<div class="dashboard-shortcut" data-dashboard-item data-dashboard-id="{{ id }}">
    <input type="hidden" name="shortcuts[]" value="{{ id }}">
    <a class="btn" href="{{ item.url }}">{{ icons.icon(item.icon) }} {{ t(item.label) }}</a>
    {% include 'dashboard/controls.twig' with {label: t(item.label), removable: true} %}
</div>
{% endif %}
